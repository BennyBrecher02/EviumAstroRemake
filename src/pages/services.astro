  }
  .services-rebates-container {
    width: 100%; max-width: 1200px; margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
    position: relative; z-index: 1;
  }
  /* HEAD: left-aligned single-column. Kicker → big headline
     → sub. Headline now wraps naturally instead of being
     forced into 24ch — better visual fit for the section. */
  .services-rebates-head {
    margin-bottom: clamp(56px, 6.5vw, 80px);
    max-width: 64ch;
  }
  .services-rebates-kicker {
    margin: 0 0 18px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.28em;
    text-transform: uppercase; color: #2DC856;
