  /* PROGRAM CARDS — refined professional layout.
     ────────────────────────────────────────────────────────
     Each card has a clean vertical rhythm:
       1. Logo (top, isolated, allowed breathing room)
       2. Hairline divider (separates logo from textual info)
       3. Header row: program name (left) + small status
          label (right, refined, no colored pill)
       4. Agency line (small, muted, single line)
       5. Description body
     Forced 2-column grid on desktop, single column on mobile.
     Generous padding throughout for premium feel. */
  .services-rebates-programs {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2.4vw, 26px);
  }
  @media (min-width: 760px) {
    .services-rebates-programs { grid-template-columns: 1fr 1fr; }
  }
  .services-rebates-program {
    background: #ffffff;
    border: 1px solid rgba(26, 47, 58, 0.09);
    border-radius: 14px;
    padding: clamp(28px, 3vw, 36px);
    box-shadow: 0 1px 0 rgba(26, 47, 58, 0.02);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .services-rebates-program:hover {
    border-color: rgba(26, 47, 58, 0.18);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 47, 58, 0.07);
