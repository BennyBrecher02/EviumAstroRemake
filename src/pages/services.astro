  /* ═══════════════════════════════════════════════════════════════
     BACKED BY — standalone strip placed between the bento
     and the Strategic Delivery Model section. Same body bg
     (#eef1f5) so the strip blends visually; hairline borders
     at top and bottom give it discrete separation without a
     colored band. Logos render with transparent backgrounds
     (stripped programmatically via PIL).
     ═══════════════════════════════════════════════════════════════ */
  .services-backed-by {
    padding: clamp(48px, 6vw, 72px) 0;
    border-top: 1px solid rgba(26, 47, 58, 0.12);
    border-bottom: 1px solid rgba(26, 47, 58, 0.12);
    font-family: 'Maven Pro', sans-serif;
  }
  .services-backed-by-container {
    width: 100%; max-width: 1200px; margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
  }
  .services-backed-by-label {
    margin: 0 0 clamp(28px, 3vw, 40px);
    display: flex; align-items: center; justify-content: center;
