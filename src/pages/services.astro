  /* Logo zone — isolated at top, generous height for impact. */
  .services-rebates-program-logo-wrap {
    display: flex;
    align-items: center;
    height: 56px;
    margin-bottom: clamp(22px, 2.4vw, 28px);
  }
  .services-rebates-program-logo {
    max-height: 56px;
    max-width: 200px;
    width: auto;
  }

  /* Hairline divider between logo zone and textual info —
     creates a clean editorial break. */
  .services-rebates-program-divider {
    display: block;
    height: 1px;
    background: rgba(26, 47, 58, 0.08);
    margin-bottom: clamp(20px, 2.2vw, 26px);
  }

  /* Header row: name (flex-1) + small refined status label
     (right, no colored pill — just small uppercase text in
     a discrete framed strip). */
  .services-rebates-program-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 6px;
  }
  .services-rebates-program-name {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-size: clamp(1.18rem, 1.35vw, 1.42rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    color: #1A2F3A;
    line-height: 1.22;
  }
  .services-rebates-program-status {
    flex-shrink: 0;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
