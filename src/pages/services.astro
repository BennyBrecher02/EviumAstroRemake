  .services-rebates-title {
    margin: 0 0 22px;
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 900; line-height: 1.04; letter-spacing: -0.028em;
    color: #1A2F3A;
    max-width: 18ch;
  }
  .services-rebates-accent { color: #2DC856; }
  .services-rebates-sub {
    margin: 0;
    font-size: clamp(1rem, 1.12vw, 1.12rem);
