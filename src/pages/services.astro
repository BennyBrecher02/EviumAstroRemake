  }

  /* ═══════════════════════════════════════════════════════════════
     FINAL CTA — full-bleed photo bg + brand gradient overlay
     ───────────────────────────────────────────────────────────────
     Replaces the previous light-bg text-only CTA. Photo lives at
     /public/images/aura-farming/. Inspired by ServicePageV2's
     .svc-final closing card — same scale, eyebrow pill, big
     two-line headline with a green-accent line — but with a
     photographic background instead of a white card.
     ═══════════════════════════════════════════════════════════════ */
  .services-final-cta {
    position: relative;
    min-height: clamp(420px, 56vh, 640px);
    overflow: hidden;
    isolation: isolate;
    color: #ffffff;
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
  }
  /* Photo — absolutely positioned to cover. object-position pulls
     the subject toward the left so the open right-half can carry
     the headline + buttons against the gradient. */
  .services-final-cta-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slightly off-centre so the subject reads as ambient framing
       behind the centred text, not as direct competition with it. */
    object-position: 38% 28%;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Overlay — uniform dark wash + soft vignette. Symmetric stack
     for the centred text: a flat dark layer for baseline legibility
     everywhere, a centre-dim radial vignette so the centred text
     gets a hair more contrast where the eye lands, and a bottom
     fade for the button row. */
  .services-final-cta-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 50%,
        rgba(13, 26, 34, 0.55) 0%,
        rgba(13, 26, 34, 0.45) 60%,
        rgba(13, 26, 34, 0.50) 100%
      ),
      linear-gradient(
        180deg,
        rgba(13, 26, 34, 0.22) 0%,
        rgba(13, 26, 34, 0.10) 40%,
        rgba(13, 26, 34, 0.55) 100%
      );
    pointer-events: none;
  }
  /* Inner — centred column at every breakpoint. Mirrors the
     upscale ServicePageV2 closing-card pattern. */
  .services-final-cta-inner {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 120px) clamp(24px, 6vw, 80px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(22px, 2.4vw, 28px);
  }

  /* Headline — original ServicePageV2-flavor display set. One
     font-size + weight + letter-spacing across all three lines;
     the .accent middle line layers in the brand-green italic, and
     the .coda bottom line is just a plain block break so the
     "We're ready when you are" coda inherits the same display
     weight. Text content is the only thing that changed vs. the
     previous pill+two-line CTA. */
  .services-final-cta-title {
    margin: 0;
    font-size: clamp(2.2rem, 5.2vw, 4rem);
    font-weight: 900;
    line-height: 1.04;
