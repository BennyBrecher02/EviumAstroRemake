<style>
  .services-page {
    /* Body bg unified with the Rebates section panel color
       (#eef1f5) so the Strategic Delivery Model section, the
       bento side margins, and the Rebates section all read
       as one continuous backdrop — only the card shell
       inside the bento (which keeps its own gradient bg)
       and the Rebates program cards (white) stand out as
       discrete surfaces. */
    background: #eef1f5;
  }

  .services-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Removed the heavy dark overlay that was darkening the
       polygon to fake a gray-tone visual — the polygon now
       carries its own gray-to-cream gradient natively in CSS
       (see .services-transition-panel below). Only the
       subtle top-left white sheen remains, for the hero's
       overall depth on the dark teal bg. */
    background:
      linear-gradient(112deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.018) 24%, transparent 30%);
    pointer-events: none;
  }

  .services-hero::before {
    content: none;
  }

  .services-transition-panel {
    /* Polygon = the chart silhouette. Cool desaturated gray
       with internal gradient for dynamic shading, plus a
       horizontal edge fade so its left/right side strips
       dissolve smoothly into the body bg (mirroring the
       shell's side blend). Without the horizontal fade, the
       polygon side strips (visible at viewports wider than
       the shell) end against the body bg in a hard vertical
       line at the panel sides.

       Stack:
         1. HORIZONTAL edge fade — body bg at very edges
            (0–4% and 96–100% x), transparent in middle.
         2. VERTICAL silhouette gradient — gray at hill
            peaks, fades to cream at panel bottom (meeting
            line with shell). */
    background:
      /* Wider horizontal side fade — body bg at edges,
         dissolving inward over 14% of panel width on each
         side, so the polygon's hill silhouette doesn't
         leave a visible cream "halo" past where the shell
         ends. */
      linear-gradient(90deg,
        #eef1f5 0%,
        rgba(238, 241, 245, 0.7) 6%,
        rgba(238, 241, 245, 0) 14%,
        rgba(238, 241, 245, 0) 86%,
        rgba(238, 241, 245, 0.7) 94%,
        #eef1f5 100%),
      linear-gradient(180deg in oklch,
        #c5c6c1 0%,
        #cccdc8 35%,
        #d2d3ce 65%,
        #d8d9d4 78%,
        #f7f7f1 100%);
    filter: drop-shadow(0 -1px 4px rgba(45, 200, 86, 0.22))
            drop-shadow(0 -10px 28px rgba(45, 200, 86, 0.08));
    /* Mobile clip-path — valleys dip BELOW the shell area,
       Hill 3 raised further by the bigger panel.
       Hill 2 left slope: valley point at x=44% raised from
       y=66% → y=58% so the approach is a gentle climb and
       the climb-to-peak is genuinely less steep. Mirrors
       the desktop change. */
    clip-path: polygon(
      0 100%,
      0 68%,
      7% 58%,
      14% 34%,
      18% 60%,
      30% 70%,
      44% 58%,
      58% 22%,
      66% 60%,
      78% 68%,
      85% 16%,
      92% 4%,
      96% 28%,
      100% 36%,
      100% 100%
    );
  }
  @media (min-width: 768px) {
    .services-transition-panel {
      /* Desktop clip-path — Hill 2 LOWERED, Hill 3 raised
         further. Panel grew from h-96 (384px) to h-[28rem]
         (448px) for the additional Hill 3 raise.

         Panel 448 + pb-40 (160) → subhead bottom in panel =
         (448-160)/448 ≈ 64.3%. Hill 1 (in subhead range) must
         clear y > 64.3%.

         Shell top in panel = (448-96)/448 = 78.6%.

           HILL 1:  peak (14%, 65%)  ← just clears subhead 64.3%
                                       (abs viewport position stable)
           valley:  18% → 76%        ← above shell (78.6%), visible
           valley:  30% → 86%        ← BELOW shell ✓ (left valley dips in)
           valley:  44% → 82%        ← BELOW shell ✓
           HILL 2:  peak (58%, 50%) ← LOWERED from y=12 to y=50
                                       (now sits well below Hill 3
                                       at midway through the panel)
           valley:  66% → 70%        ← ABOVE shell ✓
           valley:  78% → 64%        ← ABOVE shell ✓
           HILL 3 buildup: 85% → 10%
           HILL 3 peak:   92% → 0%   ← touches new panel top,
                                       RAISED 64px more vs h-96
           fall:     96% → 22% */
      /* Left edge raised from 88% → 72%: the shell-top sits
         at 78.3% of the panel, so an 88% left-edge point
         left a transparent gap (88% > 78.3%) where the
         hero's dark teal showed through the shell's rounded
         top-left corner. At 72%, the polygon fully fills
         behind the shell's top-left corner — the rounded
         corner now sits on the polygon's light tone, not
         dark teal. The side strip (panel-x 0–6%) is masked
         by the horizontal body-bg fade anyway, so the
         visible hill silhouette (panel-x 6%+) is unchanged:
         (7%,76%) and (14%,65%) stops are untouched. */
      clip-path: polygon(
        0 100%,
        0 72%,
        7% 76%,
        14% 65%,
        18% 76%,
        30% 86%,
        44% 76%,
        58% 50%,
        66% 70%,
        78% 64%,
        85% 10%,
        92% 0%,
        96% 22%,
        100% 32%,
        100% 100%
      );
    }
  }

  /* Shell — true "glue" surface using radial halos.
     ───────────────────────────────────────────────────────
     Previous attempts used solid Shade C + 4 thin edge
     fades. The result looked like a panel with painted-on
     edge stripes — not a real blend. This pass uses radial
     halos that bleed FAR into the shell, so the entire
     surface is a continuous gradient field with no detectable
     "solid center" zone:
       •  TOP halo  (large ellipse anchored above center) →
          Shade A, blending the entire upper half of the shell
          into the chart silhouette tone above.
       •  BOTTOM halo (large ellipse anchored below center) →
          Shade B, blending the entire lower half into body.
       •  LEFT/RIGHT halos (tall narrow ellipses anchored at
          horizontal edges) → Shade B, pulling the side strips
          into body tone.
       •  Base color #e2dfd4 (Shade C) shows only at the
          INTERSECTION ZONE — the spot where all four halos
          have faded out — typically the middle horizontal
          band, where the cards float against the in-between
          tone.
     Cumulative effect: every pixel of the shell is a mix of
     the surrounding tones, no flat zone, all 4 edges
     dissolve smoothly into their neighbors. The cards float
     on what reads as a single continuous tonal field. */
  .services-content-shell {
    position: relative;
    /* SHELL surface.
       ──────────────────────────────────────────────────────
       Vertical gradient only: continues from the polygon at
       the meeting line (#d8d9d4 at 0%) into bright cream
       (#f7f7f1 by 11.6%), then holds cream all the way down
       — the bento cards float on a clean, consistent cream
       surface.

       Edge blending is handled by a soft DROP SHADOW, not a
       color fade. A horizontal color fade washed the cream
       out at the narrow visible side-padding strip, so the
       shell lost its surface identity at the edges and the
       blend read as muddy. A real shadow gives the shell
       genuine depth — its left, right, and bottom edges
       settle into the body bg the way a professionally-
       designed elevated card does.

       Two-shadow stack:
       1. MAIN shadow — y-offset (22) = blur (44) + spread
          (-22) → casts ZERO shadow above the shell, so the
          seamless polygon→shell top blend is preserved. It
          gives the left/right/bottom edges their depth.
       2. CORNER-SOFTENING shadow — a tight, very faint
          all-direction halo (0 2px 10px -2px @ 0.055α). Its
          only job is to soften the rounded CORNER edges so
          they don't read as crisp geometric clips. Its
          upward reach is just ~6px at 0.055α — far too faint
          to register as a line along the seamless top edge,
          but enough to feather the corner curves. */
    background:
      /* Horizontal edge fade — CALIBRATED to align with the
         polygon's horizontal fade at the same absolute x.
         The polygon panel (x=80–1440, 1360 wide) fades:
         body-bg 0% → 0.7α 6% → transparent 14%. The shell
         (x=112–1408, 1296 wide) sits inside it, so its fade
         stops are remapped to the same absolute x positions:
           shell 0%      (x=112)   = polygon 2.35% ≈ 0.88α
           shell 3.83%   (x=161.6) = polygon 6%    = 0.70α
           shell 12.2%   (x=270)   = polygon 14%   = 0α
         …mirrored on the right edge. Result: along the
         entire polygon↔shell meeting line the two surfaces
         are color-identical at every x — the center stays
         #d8d9d4 (matching the polygon's center), and the
         corners converge to body bg (matching the polygon's
         faded side strips). The 3-way corner (polygon +
         shell + body bg) now blends consistently — all three
         dissolve to body bg at the corner point. */
      linear-gradient(90deg,
        rgba(238, 241, 245, 0.88) 0%,
        rgba(238, 241, 245, 0.70) 3.83%,
        rgba(238, 241, 245, 0) 12.2%,
        rgba(238, 241, 245, 0) 87.8%,
        rgba(238, 241, 245, 0.70) 96.17%,
        rgba(238, 241, 245, 0.88) 100%),
      /* Vertical gradient — continues from the polygon at the
         meeting line (#d8d9d4) into cream where the cards
         float, held cream all the way down. */
      linear-gradient(180deg in oklch,
        #d8d9d4 0%,
        #f7f7f1 11.6%,
        #f7f7f1 100%);
    box-shadow:
      0 22px 44px -22px rgba(13, 22, 30, 0.13),
      0 2px 10px -2px rgba(13, 22, 30, 0.055);
  }

  /* ═══════════════════════════════════════════════════════════
     SERVICES HERO TYPOGRAPHY — premium typographic system
     ═══════════════════════════════════════════════════════════
     Replaces the earlier plain dash+label eyebrow and uniform
     headline with an editorial masthead system: a multi-piece
     eyebrow (gradient dash + section label + bullet + aux),
     a two-line display headline with a green-gradient italic
     accent on the second line (Evium's role in the
     proposition), and a refined subhead with carefully tuned
     contrast and line-length.
     ═══════════════════════════════════════════════════════════ */

  /* Eyebrow row — multi-piece editorial detail. */
  .services-hero-eyebrow {
    /* min-width:0 helps it collapse cleanly on very narrow
       phones; flex-wrap protects the aux label from punching
       the layout. */
    flex-wrap: wrap;
    min-width: 0;
    /* Nudged down 1.85rem via relative offset (not margin)
       so the eyebrow text clears the background light-dot it
       was overlapping — relative positioning shifts only the
       eyebrow visually, leaving the headline + everything
       below in their original flow positions. */
    position: relative;
    top: 1.85rem;
  }
  /* Eyebrow dash — gradient (transparent → brand green → brand
     green) so it fades in from the left edge like a director's
     bar, not a uniform 1px line. */
  .services-hero-eyebrow-dash {
    display: inline-block;
    height: 1px;
    width: 3rem;
    background: linear-gradient(90deg, rgba(45, 200, 86, 0) 0%, rgba(45, 200, 86, 0.7) 60%, #2DC856 100%);
    flex-shrink: 0;
  }
  /* Primary eyebrow label — uppercase, wide-tracked, brand-
     green-tinged. */
  .services-hero-eyebrow-text {
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #7DDEA1;
    line-height: 1;
  }
  /* Tiny bullet between primary and auxiliary labels. */
  .services-hero-eyebrow-dot {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
  }
  /* Auxiliary right-side label — muted, lighter, gives the
     eyebrow row an editorial duo-column feel. */
  .services-hero-eyebrow-aux {
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.50);
    line-height: 1;
  }

  /* Display headline — fluid sizing via clamp, deep negative
     tracking for editorial-display feel, font-weight 900 for
     gravitas. Slight text-shadow to lift the type a half-step
     off the gradient background without ringing as a "drop
     shadow". */
  .services-hero-title {
    margin: 0;
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    /* Line-height bumped to 1.2 (was 1.08) AND padding-bottom
       to 0.34em (was 0.18em) so the italic accent line's
       descenders (the 'g' tail in "charging" especially)
       have enough room inside the line box. The background-
       clip:text rendering on the accent line clips glyphs
       to the element's content box — without sufficient
       line-height + padding-bottom, the bottom of italic
       descenders gets visibly cut off. */
    line-height: 1.2;
    letter-spacing: -0.045em;
    color: #ffffff;
    font-size: clamp(2.75rem, 7.2vw, 6.25rem);
    text-shadow: 0 1px 0 rgba(13, 27, 34, 0.18), 0 12px 32px rgba(13, 27, 34, 0.18);
    padding-bottom: 0.34em;
    overflow: visible;
  }
  .services-hero-title-line {
    display: block;
  }
  /* Brand-green accent line — gradient-filled type (not flat
     green) with a soft italic for editorial contrast against
     the bold roman of line 1. The gradient runs brand-green →
     lighter green → brand-green at 135° so the line catches
     light unevenly like a polished metal nameplate. */
  .services-hero-title-accent {
    background: linear-gradient(135deg, #2DC856 0%, #6FE891 45%, #2DC856 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.038em;
    /* The italic + lighter weight optical-trick of the green
       line pairs against the bold roman of line 1 so the eye
       reads them as two distinct voices in the same sentence,
       not just "two lines of the same headline". */
    /* Drop-shadow glow REMOVED — the user's descender-clip
       complaint kept persisting because the glow halo
       extended visually below the descender, which the eye
       interpreted as a soft-cut at the glyph tail. With the
       glow gone, the green-gradient italic text is striking
       on its own (the gradient catches enough light to feel
       lit) and the descender has crisp clean boundaries. */
    filter: none;
  }

  /* Subhead — premium editorial-lede treatment.
     Bigger fluid size, refined leading, inline emphasis on
     the brand mention + scope phrases, and a left-rail green
     marker that anchors the paragraph's start the way the
     eyebrow's dash anchors the masthead row above. The marker
     is a left-side ::before pseudo-element so it scales with
     the first line of text instead of competing with inline
     flow. */
  .services-hero-sub {
    position: relative;
    margin: 0;
    padding-left: clamp(0.95rem, 1.3vw, 1.2rem);
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.08rem, 1.38vw, 1.28rem);
    line-height: 1.66;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.002em;
    text-shadow: 0 1px 0 rgba(13, 27, 34, 0.24);
  }
  /* Brand-green left-rail marker — a thin 2px vertical hairline
     that anchors the paragraph's left edge. Uses a top-anchored
     gradient that fades downward so the marker doesn't compete
     with descender space on the last line. Slight glow extends
     the brand-green vibe from the eyebrow + headline accent
     down into the subhead, creating a vertical green spine
     that runs the length of the hero copy block. */
  .services-hero-sub::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.32em;
    bottom: 0.32em;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(180deg, #2DC856 0%, rgba(45, 200, 86, 0.4) 70%, rgba(45, 200, 86, 0.1) 100%);
    box-shadow: 0 0 12px rgba(45, 200, 86, 0.28);
  }
  /* Visual marker span — present for accessibility / future-
     proofing (some assistive contexts strip ::before content);
     visually identical to the ::before rail. */
  .services-hero-sub-mark {
    display: none;
  }
  /* Brand mention — "Evium" rendered in brand green with
     a small drop-shadow glow so the eye anchors on the
     brand even when reading at a glance. (The earlier
     attempt to split "Ev" green / "ium" white was reverted
     per user feedback — single-color reads cleaner.) */
  .services-hero-sub-brand {
    font-weight: 700;
    color: #6FE891;
    letter-spacing: -0.005em;
    filter: drop-shadow(0 0 10px rgba(45, 200, 86, 0.22));
  }
  /* Scope phrases — the four vertical names. Slight weight +
     contrast boost so the eye recognises these as the answer
     to "what kinds of property does Evium serve?" while still
     reading as part of the paragraph's flow. */
  .services-hero-sub-em {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.96);
    letter-spacing: 0.001em;
  }
  /* Caveat clause — muted by a touch so the value-prop above
     reads first. Still readable, just lower-contrast so the
     eye lands on the scope phrases before reaching the
     "without pushing owners into..." tail. */
  .services-hero-sub-mute {
    color: rgba(255, 255, 255, 0.62);
  }

  /* ═══════════════════════════════════════════════════════════
     PROFITABILITY TERMINAL CARD — dashboard-grid backdrop
     ═══════════════════════════════════════════════════════════
     Subtle 1px dotted-grid overlay that gives the white card a
     "live dashboard" feel without dominating. Sits absolutely
     positioned at low opacity behind the card's content (which
     bumps z-10). Mask-image fades the grid out toward the right
     side so it doesn't compete with the calculator-icon glyph
     up there. */
  .profit-card-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle, rgba(17, 24, 29, 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: 0 0;
    -webkit-mask-image: linear-gradient(135deg, #000 0%, #000 55%, transparent 90%);
    mask-image: linear-gradient(135deg, #000 0%, #000 55%, transparent 90%);
    opacity: 0.7;
  }
  /* Z-index lift the card's children so they paint above the
     dashboard-grid backdrop. */
  .profit-card > *:not(.profit-card-grid) {
    position: relative;
    z-index: 1;
  }

  .hero-base-bg {
    background:
      radial-gradient(ellipse 130% 100% at 20% 30%, rgba(22,60,75,1) 0%, transparent 55%),
      radial-gradient(ellipse 90% 80% at 85% 15%, rgba(18,48,62,0.9) 0%, transparent 45%),
      radial-gradient(ellipse 60% 50% at 60% 80%, rgba(16,42,54,0.6) 0%, transparent 50%),
      #1A2F3A;
  }

  .hero-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
  }

  .hero-glow-primary {
    left: -8%;
    top: -20%;
    width: 50%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(45,200,86,0.07) 0%, rgba(45,200,86,0.025) 35%, transparent 65%);
    filter: blur(100px);
  }

  .hero-glow-secondary {
    right: -5%;
    top: 10%;
    width: 40%;
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(45,200,86,0.04) 0%, rgba(45,200,86,0.015) 40%, transparent 65%);
    filter: blur(110px);
  }

  .hero-glow-accent {
    left: 25%;
    bottom: -15%;
    width: 50%;
    height: 45%;
    background: radial-gradient(ellipse at center, rgba(45,200,86,0.05) 0%, transparent 60%);
    filter: blur(90px);
  }

  .hero-network-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 1;
  }

  .hero-edge-light {
    position: absolute;
    top: 0;
    left: 10%;
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(45,200,86,0.15) 30%, rgba(45,200,86,0.25) 50%, rgba(45,200,86,0.15) 70%, transparent);
    filter: blur(0.5px);
  }

  /* (Network-reliability panel CSS lived here previously —
     extracted to NetworkReliabilityPanel.astro as a self-
     contained component. Drop it from this page since the
     hero no longer renders the panel.) */

  /* ═══════════════════════════════════════════════════════════════
     REBATES & INCENTIVES — premium light panel. Two-column
     editorial header + logos strip + program cards with
     brand-green left accent strip. mix-blend-mode neutralizes
     any white backgrounds embedded in the source logo files.
     ═══════════════════════════════════════════════════════════════ */
  .services-rebates {
    background: #eef1f5;
    color: #1A2F3A;
    padding: clamp(100px, 13vh, 150px) 0;
