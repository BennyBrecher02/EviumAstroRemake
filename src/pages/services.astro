---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsultationStickyTab from '../components/ConsultationStickyTabV2.astro';

// Service-card images live in /public/images/old-service-images/. They
// were originally hot-linked from Google's AIDA CDN (aida-public/...);
// downloaded locally so the page doesn't depend on an external host
// rotating or expiring those URLs. Designed to be swapped out 1:1
// when client-final art lands — same dimensions, same composition.
const topCards = [
  {
    code: 'SITE-REF-01',
    title: 'Multifamily Real Estate',
    subtitle: 'Urban residential ecosystems.',
    href: '/service-testing/multifamily-v4',
    image: '/images/old-service-images/multifamily.jpg',
  },
  {
    code: 'FLEET-OP-A9',
    title: 'Fleets',
    subtitle: 'Zero-emission logistics scaling.',
    href: '/service-testing/fleets-v2',
    image: '/images/old-service-images/fleets.jpg',
  },
  {
    code: 'TRANSIT-HUB-X',
    title: 'Highway Fast Charging',
    subtitle: 'High-throughput corridor power.',
    href: '/service-testing/highway-v3',
    image: '/images/old-service-images/highway-fast-charging.jpg',
  },
];

// Bento middle rows — TRUE bento (NOT uniform 2×2). Varied
// sizes for visual rhythm + restored "Under Construction"
// veil overlay (centered pill + dark wash) on each WIP card:
//   Commercial = col-2 row-2 TALL (anchors left of right side)
//   Retail     = col-4 row-1 WIDE (top right)
//   Parking    = col-2 row-1
//   Medical    = col-2 row-1
const profitRowSideCards = [
  {
    code: 'CORP-OFFICE-01',
    title: 'Commercial',
    href: '/solutions/commercial',
    image: '/images/old-service-images/commercial.jpg',
    wip: true,
  },
  {
    code: 'COMM-SITE-5',
    title: 'Retail',
    href: '/solutions/retail',
    image: '/images/old-service-images/retail.jpg',
    wip: true,
  },
];

const electricianFeaturedCard = {
  code: 'PARTNER NETWORK',
  title: 'Electrician Partners',
  href: '/solutions/electrician-partners',
  image: '/images/old-service-images/electrician-partners.jpg',
};

const electricianRowSideCards = [
  {
    code: 'PK-INFRA-G',
    title: 'Parking',
    href: '/solutions/parking',
    image: '/images/old-service-images/parking.jpg',
    wip: true,
  },
  {
    code: 'HOSPITAL-UNIT',
    title: 'Medical',
    href: '/solutions/medical',
    image: '/images/old-service-images/medical.jpg',
    wip: true,
  },
];

// ════════════════════════════════════════════════════════════
// REBATES & INCENTIVES — decoupled copy from /how-it-works
// section 04 (programs + backedLogos data + structure). Lives
// in services hub between Strategic Delivery Model and the
// final CTA. Re-uses the same data shape but the CSS is
// independently namespaced (.services-rebates-*) so the
// services page doesn't pull anything from /how-it-works.
// ════════════════════════════════════════════════════════════
const rebatesBackedLogos = [
  '/images/logos/government/cec.png',
  '/images/logos/government/cal-evip.webp',
  '/images/logos/government/nj-bpu.png',
  '/images/logos/government/nm-dot.png',
  '/images/logos/government/colorado-cdot.png',
  '/images/logos/industry/con-edison.webp',
  '/images/logos/industry/ev-gateway.webp',
];

interface RebatesProgram {
  logo: string;
  name: string;
  agency: string;
  status: string;
  desc: string;
}
// Program data verified against official sources:
// • NEVI:    afdc.energy.gov/laws/12744 (FHWA Formula Program, $5B over FY22-26)
// • REACH 2.0: energy.ca.gov/solicitations/2023-04 (CEC GFO-22-614)
// • NJBPU:   afdc.energy.gov/laws (NJ Board of Public Utilities EV grants)
// • CALeVIP: calevip.org/about-calevip (CEC-funded, administered by CSE)
const rebatesPrograms: RebatesProgram[] = [
  {
    logo: '/images/logos/government/nm-dot.png',
    name: 'NEVI Formula Program',
    agency: 'FHWA + State DOTs',
    status: 'Awarded',
    desc: "Evium is a qualified charge point operator under the $5B federal NEVI program. Awarded a New Mexico NEVI corridor site in partnership with EV Gateway; actively pursuing additional corridor awards in OR, TX, and CT.",
  },
  {
    logo: '/images/logos/government/cec.png',
    name: 'REACH 2.0',
    agency: 'California Energy Commission',
    status: 'Active applicant',
    desc: "Reliable, Equitable, and Accessible Charging for Multi-family Housing — a CEC Clean Transportation Program grant funding EV charging for multifamily residents with priority for low-income and disadvantaged communities.",
  },
  {
    logo: '/images/logos/government/nj-bpu.png',
    name: 'NJ EV Infrastructure Grants',
    agency: 'NJ Board of Public Utilities',
    status: 'Awarded',
    desc: "Grants from the New Jersey Board of Public Utilities covering DC fast charger and Level 2 deployments. Evium structures these awards into zero-cost installations for qualifying NJ property owners.",
  },
  {
    logo: '/images/logos/government/cal-evip.webp',
    name: 'CALeVIP Rebates',
    agency: 'CEC + Center for Sustainable Energy',
    status: 'Active participant',
    desc: "California per-charger rebates funded by the California Energy Commission and administered by the Center for Sustainable Energy. Evium handles the full application and compliance stack on behalf of property owners.",
  },
];

const standards = [
  {
    code: 'STANDARD_CODE_01',
    title: 'Turnkey Delivery',
    body:
      'From site assessment and load analysis to utility coordination, permitting, installation, commissioning, and support, Evium runs the full deployment lifecycle.',
    image: '/images/old-service-images/turnkey-delivery.jpg',
    bullets: [
      'Utility grid integration and site coordination',
      'Permitting, rebates, and compliance management',
      '24/7 monitoring and remote diagnostics',
    ],
  },
  {
    code: 'FISCAL_CORE_02',
    title: 'Zero Upfront Cost',
    body:
      'Evium’s primary no-cost model removes capital friction for qualified properties while preserving a credible revenue share and long-term operating support structure.',
    image: '/images/old-service-images/zero-upfront-cost.jpg',
    bullets: [
      '100% CAPEX funded by Evium under the flagship model',
      'Shared revenue structures built around site economics',
      'Maintenance and operating support included',
    ],
  },
];
---

<Layout
  title="Services — Evium Charging"
  description="Explore Evium Charging's service verticals across multifamily, fleets, highway fast charging, commercial, retail, parking, medical, and more."
  headerVariant="v5"
  bodyClass="page-services"
>
  <main class="services-page text-[#182126]">
    <section class="services-hero relative overflow-hidden pt-20 md:pt-24">
      <div class="absolute inset-0 hero-base-bg"></div>

      <!-- Refined ambient lighting -->
      <div class="hero-glow hero-glow-primary"></div>
      <div class="hero-glow hero-glow-secondary"></div>
      <div class="hero-glow hero-glow-accent"></div>

      <!-- SVG geometric network -->
      <svg class="hero-network-svg" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <radialGradient id="nodeGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#2DC856" stop-opacity="0.35" />
            <stop offset="50%" stop-color="#2DC856" stop-opacity="0.08" />
            <stop offset="100%" stop-color="#2DC856" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="nodeGlowWhite" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="white" stop-opacity="0.12" />
            <stop offset="100%" stop-color="white" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Diagonal grid lines — structured tech depth -->
        <line x1="0" y1="180" x2="1440" y2="60" stroke="rgba(255,255,255,0.04)" stroke-width="0.7" />
        <line x1="0" y1="320" x2="1440" y2="200" stroke="rgba(255,255,255,0.035)" stroke-width="0.7" />
        <line x1="0" y1="480" x2="1440" y2="360" stroke="rgba(255,255,255,0.03)" stroke-width="0.7" />
        <line x1="0" y1="100" x2="1440" y2="500" stroke="rgba(255,255,255,0.03)" stroke-width="0.7" />
        <line x1="200" y1="0" x2="1440" y2="520" stroke="rgba(255,255,255,0.025)" stroke-width="0.7" />
        <line x1="600" y1="0" x2="1440" y2="350" stroke="rgba(255,255,255,0.03)" stroke-width="0.7" />

        <!-- Primary network connection lines — green tint -->
        <line x1="120" y1="140" x2="380" y2="90" stroke="rgba(45,200,86,0.14)" stroke-width="1" />
        <line x1="380" y1="90" x2="620" y2="200" stroke="rgba(45,200,86,0.12)" stroke-width="1" />
        <line x1="620" y1="200" x2="900" y2="120" stroke="rgba(45,200,86,0.09)" stroke-width="0.8" />
        <line x1="900" y1="120" x2="1180" y2="180" stroke="rgba(255,255,255,0.07)" stroke-width="0.8" />
        <line x1="1180" y1="180" x2="1350" y2="80" stroke="rgba(255,255,255,0.05)" stroke-width="0.8" />

        <!-- Secondary network paths -->
        <line x1="200" y1="400" x2="500" y2="340" stroke="rgba(255,255,255,0.05)" stroke-width="0.7" />
        <line x1="500" y1="340" x2="780" y2="430" stroke="rgba(255,255,255,0.045)" stroke-width="0.7" />
        <line x1="780" y1="430" x2="1100" y2="350" stroke="rgba(255,255,255,0.04)" stroke-width="0.7" />

        <!-- Cross connections -->
        <line x1="380" y1="90" x2="500" y2="340" stroke="rgba(255,255,255,0.035)" stroke-width="0.6" />
        <line x1="620" y1="200" x2="780" y2="430" stroke="rgba(255,255,255,0.03)" stroke-width="0.6" />
        <line x1="900" y1="120" x2="1100" y2="350" stroke="rgba(255,255,255,0.035)" stroke-width="0.6" />

        <!-- Node points — large soft glow + small crisp center -->
        <circle cx="120" cy="140" r="22" fill="url(#nodeGlow)" />
        <circle cx="120" cy="140" r="2" fill="rgba(45,200,86,0.55)" />

        <circle cx="380" cy="90" r="28" fill="url(#nodeGlow)" />
        <circle cx="380" cy="90" r="2.5" fill="rgba(45,200,86,0.65)" />

        <circle cx="620" cy="200" r="20" fill="url(#nodeGlow)" />
        <circle cx="620" cy="200" r="2" fill="rgba(45,200,86,0.45)" />

        <circle cx="900" cy="120" r="24" fill="url(#nodeGlowWhite)" />
        <circle cx="900" cy="120" r="2" fill="rgba(255,255,255,0.22)" />

        <circle cx="1180" cy="180" r="18" fill="url(#nodeGlowWhite)" />
        <circle cx="1180" cy="180" r="1.8" fill="rgba(255,255,255,0.18)" />

        <circle cx="1350" cy="80" r="14" fill="url(#nodeGlowWhite)" />
        <circle cx="1350" cy="80" r="1.5" fill="rgba(255,255,255,0.14)" />

        <!-- Secondary nodes -->
        <circle cx="200" cy="400" r="14" fill="url(#nodeGlowWhite)" />
        <circle cx="200" cy="400" r="1.5" fill="rgba(255,255,255,0.14)" />

        <circle cx="500" cy="340" r="18" fill="url(#nodeGlow)" />
        <circle cx="500" cy="340" r="1.8" fill="rgba(45,200,86,0.35)" />

        <circle cx="780" cy="430" r="14" fill="url(#nodeGlowWhite)" />
        <circle cx="780" cy="430" r="1.5" fill="rgba(255,255,255,0.12)" />

        <circle cx="1100" cy="350" r="16" fill="url(#nodeGlowWhite)" />
        <circle cx="1100" cy="350" r="1.5" fill="rgba(255,255,255,0.14)" />

        <!-- Accent hexagons -->
        <polygon points="1280,280 1296,270 1312,280 1312,298 1296,308 1280,298" fill="none" stroke="rgba(45,200,86,0.08)" stroke-width="0.8" />
        <polygon points="160,480 172,472 184,480 184,494 172,502 160,494" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.7" />
        <polygon points="720,50 736,40 752,50 752,68 736,78 720,68" fill="none" stroke="rgba(45,200,86,0.06)" stroke-width="0.7" />
      </svg>

      <!-- Top edge light streak -->
      <div class="hero-edge-light"></div>

      <div class="services-hero-stage relative mx-auto max-w-[1100px] px-4 pb-32 md:px-8 md:pb-40">
        <!-- Eyebrow — multi-piece editorial detail: a brand-
             green gradient dash, the uppercase section label,
             a tiny dot separator, and a faint right-side
             auxiliary label. Reads as a refined masthead rather
             than the plain dash + word pattern used elsewhere. -->
        <div class="services-hero-eyebrow mb-9 inline-flex items-center gap-3">
          <span class="services-hero-eyebrow-dash" aria-hidden="true"></span>
          <span class="services-hero-eyebrow-text">Services Hub</span>
          <span class="services-hero-eyebrow-dot" aria-hidden="true"></span>
          <span class="services-hero-eyebrow-aux">Turnkey delivery model</span>
        </div>

        <!-- Headline — concrete two-line services promise.
             Line 1 names the visitor's role (they own a
             property); line 2 names Evium's role (we run the
             charging on it). The green accent on line 2 carries
             the "what Evium delivers" half of the propositioning,
             matching the brand's recurring two-tone-line headline
             pattern (e.g. "Grow Your Business. / Power the
             Future.") but with copy specific to the services hub. -->
        <h1 class="services-hero-title">
          <span class="services-hero-title-line">You own the property.</span>
          <span class="services-hero-title-line services-hero-title-accent">
            We run the charging.
          </span>
        </h1>

        <!-- Subhead — editorial-lede treatment: a brand-green
             marker dash anchors the paragraph's left edge,
             "Evium" gets a brand-green tinted strong, the four
             vertical phrases get a brighter / heavier inline
             treatment, and the trailing "complexity" caveat
             gets a low-contrast muting so the eye lands on the
             value-prop first and the caveat second. -->
        <p class="services-hero-sub mt-9 max-w-[36rem]">
          <span class="services-hero-sub-mark" aria-hidden="true"></span><strong class="services-hero-sub-brand">Evium</strong> deploys and operates charging ecosystems for <span class="services-hero-sub-em">real estate, fleets, public corridors, and commercial sites</span> <span class="services-hero-sub-mute">without pushing owners into hardware, permitting, or operational complexity.</span>
        </p>
      </div>

      <div class="services-transition-panel pointer-events-none absolute inset-x-0 bottom-[-1px] h-56 md:h-[28rem]"></div>
    </section>

    <!-- Three-tone cohesive surface system:
         •  Shade A (hill / polygon / chart silhouette) =
            #eceae3   — light warm gray, blends into the dark
            hero from below.
         •  Shade B (shell)                            =
            #faf8f2   — bright warm cream, the featured
            container the cards live in. Visibly brighter than
            its surroundings on ALL four edges (rounded-all
            corners + internal padding so the shell color
            shows around every card).
         •  Shade C (body bg + standards section)      =
            #e2dfd4   — warm mid-light gray, the ambient
            "page" tone the shell sits on. Reads as a half-
            step settled-down from the polygon, so the eye
            travels: hero(dark) → A(hill) → B(shell pop) →
            C(settled body) without any abrupt color jumps.

         Cards "peek out" via the restored -mt-16 / md:-mt-24
         overlap — same magnitude as the original stylistic
         peek, just now with a chart polygon (h-44, taller
         than before) tuned so the rising-hill silhouette is
         fully visible ABOVE the peeking shell on both mobile
         and desktop. -->
    <section class="relative z-10 mx-auto -mt-16 max-w-[1440px] px-4 pb-24 md:-mt-24 md:px-8 md:pb-32">
      <div class="services-content-shell rounded-[1.75rem] p-3 md:rounded-[2.25rem] md:p-5">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:auto-rows-[255px]">
        {topCards.map((card) => (
          <a
            href={card.href}
            class="group relative overflow-hidden rounded-2xl md:col-span-4"
          >
            <img
              src={card.image}
              alt={card.title}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(16,24,29,0.82),rgba(16,24,29,0.18))]"></div>
            <div class="absolute inset-0 ring-1 ring-inset ring-white/10"></div>
            <div class="relative flex h-full flex-col justify-between p-5">
              <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/70">{card.code}</span>
              <div>
                <h2 class="text-[1.72rem] font-bold leading-none tracking-[-0.03em] text-white">{card.title}</h2>
                <p class="mt-1 text-sm font-medium text-white/72">{card.subtitle}</p>
              </div>
            </div>
          </a>
        ))}

        <!-- ════════════════════════════════════════════════════
             PROFITABILITY TERMINAL — compact, single-row card
             (md:row-span-1 now, was row-span-2). Content
             reorganized into a 2-column grid that fills the
             ~255px slot tightly:
               LEFT:  inline icon+eyebrow row → 1-line headline
                      → 1-line subtext → 4-column inputs strip
               RIGHT: small sparkline w/ trend badge → CTA
             ════════════════════════════════════════════════════ -->
        <a
          href="/testing/profits"
          class="profit-card group relative overflow-hidden rounded-2xl bg-white p-5 shadow-[0_28px_60px_rgba(10,20,28,0.08)] md:col-span-6 md:row-span-1 md:p-6"
        >
          <!-- Decorative gridlines — subtle dashboard backdrop -->
          <div class="profit-card-grid" aria-hidden="true"></div>

          <div class="relative z-10 grid h-full gap-x-6 gap-y-4 md:grid-cols-[minmax(0,1fr)_auto]">
            <!-- ── LEFT column: header text + inputs strip ── -->
            <div class="flex min-w-0 flex-col">
              <!-- Eyebrow row: icon and "Profitability Terminal"
                   text inline on the same row, comfortable gap. -->
              <div class="inline-flex items-center gap-2.5">
                <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md bg-[#eef3ef] text-[#17883c] transition-colors duration-200 group-hover:bg-[#d9ecde]">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true">
                    <rect x="5" y="4.5" width="14" height="15" rx="2.5" stroke="currentColor" stroke-width="1.7"></rect>
                    <path d="M8.5 8h7M8.5 11.5h2.2M13.2 11.5h2.3M8.5 15h2.2M13.2 15h2.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                  </svg>
                </span>
                <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-[#7a8a8f]">
                  Profitability Terminal
                </span>
              </div>

              <!-- Headline — forced onto a single line via
                   md:whitespace-nowrap so it never wraps. -->
              <h2 class="mt-2.5 text-[1.55rem] font-bold leading-tight tracking-[-0.03em] text-[#11181d] md:whitespace-nowrap md:text-[1.85rem]">
                Calculate Generated Profits
              </h2>

              <!-- Compact subtext — one short line at desktop. -->
              <p class="mt-1.5 text-[12px] leading-snug text-[#4f5b60] md:text-[13px]">
                5-year revenue projection in seconds — tune your site profile.
              </p>

              <!-- Inputs grid — 2×2 (mobile) AND 2×2 (desktop):
                   per user request, NOT laid out as 4
                   horizontal. Two rows of two inputs each so
                   each cell has room to breathe. mt-auto pins
                   the grid at the bottom of the left column. -->
              <dl class="profit-card-inputs mt-auto grid grid-cols-2 gap-x-4 gap-y-3 md:gap-x-6">
                <div>
                  <dt class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Stations</dt>
                  <dd class="mt-0.5 flex items-baseline gap-1.5">
                    <span class="text-base font-bold leading-none text-[#11181d]">12</span>
                    <span class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Units</span>
                  </dd>
                  <div class="mt-1.5 h-[2.5px] overflow-hidden rounded-full bg-[#e5e8e6]">
                    <div class="h-full w-[34%] rounded-full bg-gradient-to-r from-[#17883c] to-[#2DC856]"></div>
                  </div>
                </div>

                <div>
                  <dt class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Utilization</dt>
                  <dd class="mt-0.5 flex items-baseline gap-1.5">
                    <span class="text-base font-bold leading-none text-[#11181d]">4.5</span>
                    <span class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Hrs/Day</span>
                  </dd>
                  <div class="mt-1.5 h-[2.5px] overflow-hidden rounded-full bg-[#e5e8e6]">
                    <div class="h-full w-[64%] rounded-full bg-gradient-to-r from-[#17883c] to-[#2DC856]"></div>
                  </div>
                </div>

                <div>
                  <dt class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Tier</dt>
                  <dd class="mt-0.5 flex items-baseline gap-1.5">
                    <span class="text-base font-bold leading-none text-[#11181d]">L3</span>
                    <span class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">180 kW</span>
                  </dd>
                  <div class="mt-1.5 h-[2.5px] overflow-hidden rounded-full bg-[#e5e8e6]">
                    <div class="h-full w-[82%] rounded-full bg-gradient-to-r from-[#17883c] to-[#2DC856]"></div>
                  </div>
                </div>

                <div>
                  <dt class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">Site</dt>
                  <dd class="mt-0.5 flex items-baseline gap-1.5">
                    <span class="text-base font-bold leading-none text-[#11181d]">A</span>
                    <span class="text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">High</span>
                  </dd>
                  <div class="mt-1.5 h-[2.5px] overflow-hidden rounded-full bg-[#e5e8e6]">
                    <div class="h-full w-[72%] rounded-full bg-gradient-to-r from-[#17883c] to-[#2DC856]"></div>
                  </div>
                </div>
              </dl>
            </div>

            <!-- ── RIGHT column: sparkline shifted DOWN
                 noticeably via pt-20 (80px padding-top),
                 CTA pinned to bottom via justify-between.
                 Sparkline now sits well below the top of
                 the right column, with a meaningful vertical
                 gap above the Run Simulation button. -->
            <div class="flex flex-col items-stretch justify-between gap-3 md:items-end md:pt-20">
              <figure class="profit-card-spark hidden flex-col gap-1.5 md:flex">
                <figcaption class="flex items-center justify-between gap-3 text-[9px] font-medium uppercase tracking-[0.14em] text-[#7a8a8f]">
                  <span>5-yr Projection</span>
                  <span class="inline-flex items-center gap-1 text-[9px] font-bold tracking-[0.12em] text-[#17883c]">
                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#2DC856]"></span>
                    +18%
                  </span>
                </figcaption>
                <svg viewBox="0 0 160 56" class="h-14 w-40" role="presentation" aria-hidden="true">
                  <defs>
                    <linearGradient id="profitSparkFill" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#2DC856" stop-opacity="0.9" />
                      <stop offset="100%" stop-color="#17883c" stop-opacity="0.5" />
                    </linearGradient>
