      0 56px 110px rgba(0, 0, 0, 0.44),
      inset 0 1px 0 rgba(255, 255, 255, 0.95) !important;
  }
  html.svc-v3-active .svc-hw-card:hover::before {
    transform: scaleX(0.85) !important;
  }

  /* Showroom stage — bigger, with overhead spotlight + deeper
     product-specific drop shadow under the charger. */
  html.svc-v3-active .svc-hw-stage {
    height: clamp(220px, 26vh, 280px) !important;
    background:
      radial-gradient(
        ellipse 70% 60% at 50% 0%,
