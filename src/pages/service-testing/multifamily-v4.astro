      background 0.32s var(--ease, cubic-bezier(0.25, 0, 0, 1)),
      color 0.32s var(--ease, cubic-bezier(0.25, 0, 0, 1)),
      box-shadow 0.32s var(--ease, cubic-bezier(0.25, 0, 0, 1)),
      transform 0.32s var(--ease, cubic-bezier(0.25, 0, 0, 1)) !important;
  }
  html.svc-v3-active .svc-hw-seeall:hover {
    transform: translateY(-2px) !important;
