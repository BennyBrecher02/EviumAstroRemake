      /* Horizontal outcome row — 3-column grid: monthly |
         arrow | 5-year. */
      .hwv3-econ-num-row {
        display: grid !important;
        grid-template-columns: 1fr auto 1fr !important;
        align-items: center !important;
        gap: 8px !important;
      }
      /* Number rows — each side ($ prefix + figure + unit) on
         a SINGLE inline row (was stacked column). Layout:
         "$ 1,500 / month"  →  "$ 90,000 over 5 years"
         All three sub-elements baseline-aligned in one row. */
      .hwv3-econ-num-primary,
      .hwv3-econ-num-secondary {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        align-items: baseline !important;
        gap: 4px !important;
        white-space: nowrap !important;
      }
      .hwv3-econ-num-secondary {
        justify-content: flex-end !important;
