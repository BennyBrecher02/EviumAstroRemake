    .hwv3-econ-bg::before,
    .hwv3-econ-bg::after {
      content: "";
      position: absolute;
      pointer-events: none;
    }
    .hwv3-econ-bg::before {
      top: -10%;
      right: -8%;
      width: 55%;
      height: 60%;
      background: radial-gradient(ellipse at top right, rgba(45, 200, 86, 0.10) 0%, transparent 65%);
    }
    .hwv3-econ-bg::after {
      bottom: -15%;
      left: -8%;
      width: 50%;
      height: 55%;
      background: radial-gradient(ellipse at bottom left, rgba(26, 47, 58, 0.06) 0%, transparent 70%);
    }

    .hwv3-econ-frame {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 clamp(24px, 4vw, 60px);
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      gap: clamp(14px, 1.8vw, 24px);
      max-height: 100%;
      box-sizing: border-box;
      min-height: 0;
    }

    /* ─── Header. Compact — eyebrow + 2-line title + sub. ─── */
    .hwv3-econ-head {
