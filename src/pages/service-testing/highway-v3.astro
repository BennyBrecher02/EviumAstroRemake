  <style>
    /* ─── Section surface — light "showroom" gradient.
           Single-viewport: 100svh fixed, no scroll inside. ─── */
    .hwv3-econ {
      position: relative;
      isolation: isolate;
      height: 100svh;
      min-height: 640px;
      display: flex;
      align-items: center;
      padding: clamp(24px, 3vw, 56px) 0;
      overflow: hidden;
      color: #0d1b22;
      box-sizing: border-box;
    }
    .hwv3-econ-bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(180deg, #f4f7fb 0%, #eef2f7 50%, #e7edf4 100%);
