  <script>
    // ───────────────────────────────────────────────────────
    // The Economics — single-viewport interactive dashboard.
    //
    // State: { model: 'nocost'|'hybrid'|'investment'|'leasing',
    //          tier:  'low'|'medium'|'high' }
    //
    // On change → update:
    //   1. data-active on each segmented control (drives thumb)
    //   2. is-active class + aria-selected on tabs
    //   3. Numeric vs bespoke mode (display flip on left card)
    //   4. Numbers tween via rAF + easeOutCubic (520ms)
    //   5. Narrative panel (title, flag, body, dl) — cross-fade
    //
    // Numbers source — Evium NEVI Proposal p.5:
    //   Per single 180kW DC fast charger,
    //   $0.50/kWh consumer price.
    //   No-Cost = 10% host revenue.
    //   ─ Low (2 cars/day):    18,000 kWh × $0.50 × 10% = $900
    //   ─ Medium (3 cars/day): 30,000 kWh × $0.50 × 10% = $1,500
    //   ─ High (5 cars/day):   42,000 kWh × $0.50 × 10% = $2,100
    //   Client Investment = 100% of gross revenue (host pays
    //   ops + electricity, not netted here — gross is shown
    //   honestly with a clarifying foot label).
    //   Hybrid + Leasing = bespoke, no fabricated figures.
    // ───────────────────────────────────────────────────────
    (() => {
      const root = document.querySelector('[data-hwv3-econ]');
      if (!root) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Init guard — Astro view-transitions or HMR can re-run
      //    a script tag; we want at most one binding per page. ──
      if (root.__hwv3EconBound) return;
      root.__hwv3EconBound = true;

      // ── Tier-keyed copy. Reacts to the demand pill, not
      //    the model. Pulled directly from the NEVI Proposal
      //    p.5 utilization table (kWh per stall per month +
      //    cars per charger per day). Low/Medium/High labels
      //    are the proposal's own. ──
      const TIER_DATA = {
        low: {
          title:    'Low utilization',
          eyebrow:  'Tier 01 / 03',
          sessions: '~2',
          kwh:      '18,000',
        },
        medium: {
          title:    'Medium utilization',
          eyebrow:  'Tier 02 / 03',
          sessions: '~3',
          kwh:      '30,000',
        },
        high: {
          title:    'High utilization',
          eyebrow:  'Tier 03 / 03',
          sessions: '~5',
          kwh:      '42,000',
        },
      };

      // ── The four canonical hosting models. Every fact grid
      //    uses the same four axes — Capital · Operations ·
      //    Revenue · Term — so models can be read straight
      //    down the same column.
      //
      //    Numeric values come from the Evium NEVI Proposal
      //    p.5. Bespoke modes (band, subtraction) derive their
      //    visible figures from the same numeric anchors at
      //    the active tier — no invented midpoints. ──
      const MODELS = {
        nocost: {
          title: 'Low to No-Cost',
          flag: 'Most common · NEVI-funded',
          tagline: 'You contribute the land. Evium contributes everything else.',
          body: 'Evium invests the capital and runs the site end to end. You contribute the land and access; we cover hardware, install, software, support, incentives, and the cost of every kilowatt sold. Revenue is shared with the host.',
          mode: 'numeric',
          numLabel: 'Estimated host revenue',
          monthly:    { low: 900,    medium: 1500,   high: 2100   },
          fiveyear:   { low: 54000,  medium: 90000,  high: 126000 },
          multistall: { low: 216000, medium: 360000, high: 504000 },
          multiLabel: 'Typical 4‑charger NEVI site, 5 yr',
          facts: [
            ['Capital',    'Evium'],
            ['Operations', 'Evium'],
            ['Revenue',    'Shared,\nhost‑favored'],
            ['Term',       '5 yr + 5'],
          ],
        },
        hybrid: {
          title: 'Hybrid',
          flag: 'Tunable split',
          tagline: 'You put in part of the capital. Your share scales with what you put in.',
          body: 'A blend of No-Cost and Client Investment. You contribute part of the capital; in exchange, your share of revenue scales up with what you put in. Use it to dial in more upside than No-Cost without taking on the full Client Investment lift.',
          mode: 'band',
          // Anchors read from these two numeric models at the
          // active tier — that's why no midpoint is fabricated.
          bandFrom: 'nocost',
          bandTo:   'investment',
          facts: [
            ['Capital',    'Shared'],
            ['Operations', 'Evium'],
            ['Revenue',    'Scales with\ncapital'],
            ['Term',       'Negotiated'],
          ],
        },
        investment: {
          title: 'Client Investment',
          flag: 'Host keeps 100% of revenue',
          tagline: 'You buy it. You run it. You keep all of it.',
          body: 'You finance and own the entire installation. You run it, you maintain it, and you keep every dollar of revenue it produces. Evium’s role is limited to rebate processing and incentive capture. Best fit for hosts with capex appetite and an existing operations team.',
          mode: 'numeric',
          numLabel: 'Estimated gross sales (host)',
          monthly:    { low: 9000,    medium: 15000,   high: 21000   },
          fiveyear:   { low: 540000,  medium: 900000,  high: 1260000 },
          multistall: { low: 2160000, medium: 3600000, high: 5040000 },
          multiLabel: 'Typical 4‑charger site, 5 yr gross',
          facts: [
            ['Capital',    'Host'],
            ['Operations', 'Host'],
            ['Revenue',    '100% to host'],
            ['Term',       'Host‑owned'],
          ],
        },
        leasing: {
          title: 'Leasing',
          flag: 'Lease + buy‑out',
          tagline: 'Fixed monthly payment. You keep the revenue. Buy‑out at term end.',
          body: 'Evium finances the hardware as a lease. You make a fixed monthly payment, keep all gross revenue, and have a buy‑out option at term end. Payment size, term length, and buy‑out price are sized to your site’s projected throughput.',
          mode: 'subtraction',
          // Gross figure equals the Investment gross at the
          // active tier (same kWh-times-price math). The lease
          // payment isn't sourced (no doc fixes it) so the
          // equation displays "sized to site" rather than a
          // fabricated number.
          subFrom: 'investment',
          facts: [
            ['Capital',    'Evium‑financed'],
            ['Operations', 'Negotiated'],
            ['Revenue',    'Gross − lease'],
            ['Term',       'Buy‑out at end'],
          ],
        },
      };

      // ── DOM refs. ──
      const modelsCtl = root.querySelector('[data-hwv3-models]');
      const tiersCtl  = root.querySelector('[data-hwv3-tiers]');
      const modelBtns = modelsCtl ? Array.from(modelsCtl.querySelectorAll('[data-hwv3-model]')) : [];
      const tierBtns  = tiersCtl  ? Array.from(tiersCtl.querySelectorAll('[data-hwv3-tier]'))   : [];

      // Outcome panel — three mutually-exclusive modes that
      // change with the active model.
      const modes = {
        numeric:     root.querySelector('[data-hwv3-mode="numeric"]'),
        band:        root.querySelector('[data-hwv3-mode="band"]'),
        subtraction: root.querySelector('[data-hwv3-mode="subtraction"]'),
      };

      const numLabel    = root.querySelector('[data-hwv3-num-label]');
      const multiLabel  = root.querySelector('[data-hwv3-multi-label]');
      const numEls = {
        monthly:       root.querySelector('[data-hwv3-num="monthly"]'),
        fiveyear:      root.querySelector('[data-hwv3-num="fiveyear"]'),
        multistall:    root.querySelector('[data-hwv3-num="multistall"]'),
        bandLow:       root.querySelector('[data-hwv3-num="bandLow"]'),
        bandHigh:      root.querySelector('[data-hwv3-num="bandHigh"]'),
        grossSales:    root.querySelector('[data-hwv3-num="grossSales"]'),
        grossPerStall: root.querySelector('[data-hwv3-num="grossPerStall"]'),
      };

      // Active-combo eyebrow inside the outcome panel.
      const activeModelEl = root.querySelector('[data-hwv3-active-model]');
      const activeTierEl  = root.querySelector('[data-hwv3-active-tier]');

      // Model card refs (left zone, reacts to model picker).
      const modelCardEl   = root.querySelector('[data-hwv3-card="model"]');
      const narrTitle     = root.querySelector('[data-hwv3-narr-title]');
      const narrFlag      = root.querySelector('[data-hwv3-narr-flag]');
      const narrTagline   = root.querySelector('[data-hwv3-narr-tagline]');
      const narrBody      = root.querySelector('[data-hwv3-narr-body]');
      const narrFacts     = root.querySelector('[data-hwv3-narr-facts]');

      // Tier card refs (right zone, reacts to tier picker).
      const tierCardEl    = root.querySelector('[data-hwv3-card="tier"]');
      const tierEyebrow   = root.querySelector('[data-hwv3-tier-eyebrow]');
      const tierTitle     = root.querySelector('[data-hwv3-tier-title]');
      const tierSessions  = root.querySelector('[data-hwv3-tier-sessions]');
      const tierKwh       = root.querySelector('[data-hwv3-tier-kwh]');

      // ── State. ──
      let activeModel = 'nocost';
      let activeTier  = 'medium';

      // ── Tween util — reads current displayed integer from
      //    each element's textContent, so external state can
      //    never desync. ──
      const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
      const fmt = (n) => Math.round(n).toLocaleString('en-US');
      const readInt = (el) => {
        if (!el) return 0;
        const n = parseInt(String(el.textContent || '').replace(/[^0-9-]/g, ''), 10);
        return Number.isFinite(n) ? n : 0;
      };
      const inflight = new WeakMap();
      function tween(el, to, durationMs) {
        if (!el) return;
        if (typeof to !== 'number' || !Number.isFinite(to)) return;
        const prev = inflight.get(el);
        if (prev) cancelAnimationFrame(prev);
        const from = readInt(el);
        // Snap if there's no motion to do (same value, reduce-motion
        // preference, or hidden tab where rAF is throttled and the
        // user wouldn't see the animation anyway).
        if (from === to || reduceMotion || (typeof document !== 'undefined' && document.hidden)) {
          el.textContent = fmt(to);
          return;
        }
        const start = performance.now();
        function step(now) {
          const t = Math.min(1, (now - start) / durationMs);
          const v = from + (to - from) * easeOutCubic(t);
          el.textContent = fmt(v);
          if (t < 1) inflight.set(el, requestAnimationFrame(step));
          else inflight.delete(el);
        }
        inflight.set(el, requestAnimationFrame(step));
      }

      // ── Mode-aware paint. Each mode reads numbers from the
      //    same MODELS dictionary so we never duplicate truth. ──
      function paintNumeric(m, tier, animate) {
        if (numLabel) numLabel.textContent = m.numLabel;
        if (multiLabel && m.multiLabel) multiLabel.textContent = m.multiLabel;
        const monthly    = m.monthly[tier];
        const fiveyear   = m.fiveyear[tier];
        const multistall = m.multistall[tier];
        if (animate) {
          tween(numEls.monthly,    monthly,    520);
          tween(numEls.fiveyear,   fiveyear,   560);
          tween(numEls.multistall, multistall, 600);
        } else {
          if (numEls.monthly)    numEls.monthly.textContent    = fmt(monthly);
          if (numEls.fiveyear)   numEls.fiveyear.textContent   = fmt(fiveyear);
          if (numEls.multistall) numEls.multistall.textContent = fmt(multistall);
        }
      }
      function paintBand(m, tier, animate) {
        const lo = MODELS[m.bandFrom];
        const hi = MODELS[m.bandTo];
        if (!lo || !hi) return;
        const lowVal  = lo.monthly[tier];
        const highVal = hi.monthly[tier];
        if (animate) {
          tween(numEls.bandLow,  lowVal,  520);
          tween(numEls.bandHigh, highVal, 560);
        } else {
          if (numEls.bandLow)  numEls.bandLow.textContent  = fmt(lowVal);
          if (numEls.bandHigh) numEls.bandHigh.textContent = fmt(highVal);
        }
      }
      function paintSubtraction(m, tier, animate) {
        const src = MODELS[m.subFrom];
        if (!src) return;
        const gross = src.monthly[tier];
        if (animate) tween(numEls.grossSales, gross, 520);
        else if (numEls.grossSales) numEls.grossSales.textContent = fmt(gross);
      }

      // ── Tier card paint. The tier card reacts to the tier
      //    picker, not the model. The "gross per stall" figure
      //    is the foundation number every model is calculated
      //    from — Investment.monthly[tier] is the gross at
      //    $0.50/kWh × kWh table. ──
      function paintTierCard(tier, animate) {
        const t = TIER_DATA[tier];
        if (!t) return;
        if (tierEyebrow)  tierEyebrow.textContent  = t.eyebrow;
        if (tierTitle)    tierTitle.textContent    = t.title;
        if (tierSessions) tierSessions.textContent = t.sessions;
        if (tierKwh)      tierKwh.textContent      = t.kwh;
        const gross = MODELS.investment.monthly[tier];
        if (animate) tween(numEls.grossPerStall, gross, 520);
        else if (numEls.grossPerStall) numEls.grossPerStall.textContent = fmt(gross);
      }

      // ── Render: pull state into DOM. ──
      function render({ animate = true, source = null } = {}) {
        try {
          const m = MODELS[activeModel];
          if (!m) return;

          // Segmented data-active drives thumb position via CSS.
          if (modelsCtl) modelsCtl.setAttribute('data-active', activeModel);
          if (tiersCtl)  tiersCtl.setAttribute('data-active', activeTier);

          modelBtns.forEach((b) => {
            const a = b.getAttribute('data-hwv3-model') === activeModel;
            b.classList.toggle('is-active', a);
            b.setAttribute('aria-selected', a ? 'true' : 'false');
            b.setAttribute('tabindex', a ? '0' : '-1');
          });
          tierBtns.forEach((b) => {
            const a = b.getAttribute('data-hwv3-tier') === activeTier;
            b.classList.toggle('is-active', a);
            b.setAttribute('aria-selected', a ? 'true' : 'false');
            b.setAttribute('tabindex', a ? '0' : '-1');
          });

          // Active-combo eyebrow on the outcome panel.
          if (activeModelEl) activeModelEl.textContent = m.title;
          if (activeTierEl)  activeTierEl.textContent  = (TIER_DATA[activeTier] || {}).title || activeTier;

          // Tier card always paints on every render (tier may
          // have changed; if model changed only, this is a
          // cheap no-op for the textContent assignments).
          paintTierCard(activeTier, animate);

          // Toggle which mode card is visible. Three modes,
          // mutually exclusive: numeric / band / subtraction.
          for (const k of Object.keys(modes)) {
            const el = modes[k];
            if (el) el.hidden = (k !== m.mode);
          }

          if (m.mode === 'numeric')          paintNumeric(m, activeTier, animate);
          else if (m.mode === 'band')        paintBand(m, activeTier, animate);
          else if (m.mode === 'subtraction') paintSubtraction(m, activeTier, animate);

          // Model card cross-fade — only when the model
          // actually changed (a tier-only change shouldn't
          // flicker the model card).
          const swapModelCard = source !== 'tier';
          if (animate && !reduceMotion && modelCardEl && swapModelCard) {
            modelCardEl.classList.add('is-swapping');
            setTimeout(() => {
              paintModelCard(m);
              modelCardEl.classList.remove('is-swapping');
            }, 140);
          } else {
            paintModelCard(m);
          }

          // Tier card cross-fade — only when the tier changed.
          const swapTierCard = source !== 'model';
          if (animate && !reduceMotion && tierCardEl && swapTierCard) {
            tierCardEl.classList.add('is-swapping');
            setTimeout(() => {
              tierCardEl.classList.remove('is-swapping');
            }, 280);
          }
        } catch (err) {
          console.error('[hwv3-econ] render failed:', err);
        }
      }

      function paintModelCard(m) {
        if (narrTitle)   narrTitle.textContent   = m.title;
        if (narrFlag)    narrFlag.textContent    = m.flag;
        if (narrTagline && m.tagline) narrTagline.textContent = m.tagline;
        if (narrBody)  narrBody.textContent  = m.body;
        if (narrFacts) {
          // Update the existing dt/dd pairs in place. Replacing
          // innerHTML would strip Astro's scoped CSS attributes
          // from the newly-injected nodes — so we'd lose all
          // typography and dividers on the spec strip.
          const rows = narrFacts.querySelectorAll(':scope > div');
          m.facts.forEach(([k, v], i) => {
            const row = rows[i];
            if (!row) return;
            const dt = row.querySelector('dt');
            const dd = row.querySelector('dd');
            if (dt) dt.textContent = k;
            if (dd) dd.textContent = v;
          });
        }
      }

      // ── Wiring — click + keyboard nav for each tablist. ──
      function bindTabs(btns, attr, setActive) {
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const v = btn.getAttribute(attr);
            if (v) { setActive(v); btn.focus(); }
          });
          btn.addEventListener('keydown', (e) => {
            const idx = btns.indexOf(btn);
            let next = -1;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % btns.length;
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + btns.length) % btns.length;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End')  next = btns.length - 1;
            if (next >= 0) {
              e.preventDefault();
              const v = btns[next].getAttribute(attr);
              if (v) { setActive(v); btns[next].focus(); }
            }
          });
        });
      }

      bindTabs(modelBtns, 'data-hwv3-model', (v) => {
        if (v === activeModel) return;
        activeModel = v;
        render({ source: 'model' });
      });
      bindTabs(tierBtns, 'data-hwv3-tier', (v) => {
        if (v === activeTier) return;
        activeTier = v;
        render({ source: 'tier' });
      });

      // Initial paint, no animation (matches default markup).
      render({ animate: false });
    })();
  </script>

  <!-- ═══════════════════════════════════════════════════
       5. SOFTWARE & COMPLIANCE
