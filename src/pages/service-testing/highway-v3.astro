      /* Outcome panel — tightened so the section fits the
         larger inter-section gaps (sub→tabs 32, cards→outcome
         28) within the locked 720 viewport. */
      .hwv3-econ-outcome {
        padding: 10px 14px 11px !important;
        gap: 6px !important;
        border-radius: 12px !important;
        flex-shrink: 0 !important;
