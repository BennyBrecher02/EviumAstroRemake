    .hwv3-econ-segmented--four[data-active="leasing"]     .hwv3-econ-thumb { transform: translateX(300%); }
    .hwv3-econ-segmented--three[data-active="low"]        .hwv3-econ-thumb { transform: translateX(0);    }
    .hwv3-econ-segmented--three[data-active="medium"]     .hwv3-econ-thumb { transform: translateX(100%); }
    .hwv3-econ-segmented--three[data-active="high"]       .hwv3-econ-thumb { transform: translateX(200%); }

    .hwv3-econ-tab {
      position: relative;
      z-index: 1;
      appearance: none;
      background: transparent;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      padding: 9px 10px;
      border-radius: 999px;
