    /* ─── Zones row — two columns. Each zone bundles a
           picker bar + its description card. The card
           reacts visibly when its picker changes, so each
           control owns its own surface. ─── */
    .hwv3-econ-zones {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(14px, 1.6vw, 22px);
