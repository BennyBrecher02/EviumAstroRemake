    .hwv3-econ-tab:hover:not(.is-active) { color: #1A2F3A; }
    .hwv3-econ-tab.is-active             { color: #ffffff; }
    .hwv3-econ-tab:focus-visible {
      outline: 2px solid #2DC856;
      outline-offset: 3px;
    }

    /* ─── Card (shared by model + tier zones). ─── */
    .hwv3-econ-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: clamp(10px, 1.2vw, 16px);
      padding: clamp(16px, 1.8vw, 24px);
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid rgba(13, 27, 34, 0.07);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 1px 2px rgba(13, 27, 34, 0.03),
        0 24px 48px -32px rgba(13, 27, 34, 0.18),
        0 4px 12px -8px rgba(13, 27, 34, 0.08);
      transition: opacity 280ms ease;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }
    .hwv3-econ-card.is-swapping { opacity: 0; }

    .hwv3-econ-card-head {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .hwv3-econ-card-flag {
      align-self: flex-start;
      padding: 4px 11px;
      border-radius: 999px;
      background: rgba(45, 200, 86, 0.10);
      color: #1A2F3A;
      border: 1px solid rgba(45, 200, 86, 0.30);
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .hwv3-econ-card-title {
      font-size: clamp(1.25rem, 1.8vw, 1.6rem);
      font-weight: 900;
      letter-spacing: -0.018em;
      line-height: 1.05;
      color: #0d1b22;
      margin: 0;
