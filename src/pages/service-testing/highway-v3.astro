      margin: auto 0 0;
      padding: 12px 14px;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(45, 200, 86, 0.08) 0%, rgba(45, 200, 86, 0.02) 100%);
      border: 1px solid rgba(45, 200, 86, 0.22);
    }
    .hwv3-econ-tier-math-key {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #1A2F3A;
      line-height: 1.2;
    }
    .hwv3-econ-tier-math-val {
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
      font-feature-settings: "tnum" 1, "lnum" 1;
      color: #2DC856;
      font-weight: 900;
      font-size: clamp(1.05rem, 1.45vw, 1.35rem);
      letter-spacing: -0.018em;
      line-height: 1;
    }
    .hwv3-econ-tier-math-val .hwv3-econ-num-prefix {
      font-size: 0.78rem;
      color: #2DC856;
      opacity: 0.78;
    }
    .hwv3-econ-tier-math-unit {
      font-size: 0.66rem;
      font-weight: 700;
      color: rgba(13, 27, 34, 0.55);
      letter-spacing: -0.005em;
    }

    /* ─── Outcome panel — full-width, derived numbers only.
           Eyebrow names the active (model × tier) combo
           so the reader can verify what they're looking at. ─── */
    .hwv3-econ-outcome {
      position: relative;
      padding: clamp(16px, 1.8vw, 24px) clamp(20px, 2.2vw, 30px);
      border-radius: 16px;
      background:
        linear-gradient(180deg, rgba(45, 200, 86, 0.06) 0%, rgba(45, 200, 86, 0.02) 50%, transparent 100%),
        #ffffff;
      border: 1px solid rgba(45, 200, 86, 0.28);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 24px 48px -28px rgba(45, 200, 86, 0.22),
        0 4px 12px -6px rgba(13, 27, 34, 0.10);
      display: flex;
      flex-direction: column;
      gap: clamp(12px, 1.4vw, 18px);
      min-height: 0;
    }
    .hwv3-econ-outcome-eyebrow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin: 0;
      font-feature-settings: "tnum" 1, "lnum" 1;
    }
    .hwv3-econ-outcome-eyebrow-tag {
      font-size: 0.56rem;
      font-weight: 800;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      padding: 4px 11px;
      border-radius: 999px;
      background: #1A2F3A;
      color: #ffffff;
    }
    .hwv3-econ-outcome-eyebrow-combo {
      font-size: clamp(0.78rem, 0.95vw, 0.9rem);
      font-weight: 700;
      color: rgba(13, 27, 34, 0.7);
      letter-spacing: -0.005em;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .hwv3-econ-outcome-eyebrow-combo strong {
      color: #0d1b22;
      font-weight: 800;
    }
    .hwv3-econ-outcome-eyebrow-combo span {
      color: rgba(13, 27, 34, 0.4);
    }

    /* Mode containers inside the outcome panel — three modes,
       mutually exclusive, cross-fade on swap. */
    [data-hwv3-mode] {
      display: flex;
      flex-direction: column;
      gap: clamp(10px, 1.2vw, 16px);
      transition: opacity 280ms ease;
    }
    [data-hwv3-mode][hidden] { display: none; }

    /* Numeric mode (No-Cost + Investment). */
    .hwv3-econ-num-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: rgba(13, 27, 34, 0.5);
      margin: 0;
    }
    .hwv3-econ-num-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(10px, 1.4vw, 18px);
    }
    @media (max-width: 600px) {
      .hwv3-econ-num-row {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hwv3-econ-num-arrow { transform: rotate(90deg); }
    }
    .hwv3-econ-num-primary,
    .hwv3-econ-num-secondary {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px;
      margin: 0;
      font-feature-settings: "tnum" 1, "lnum" 1;
    }
    .hwv3-econ-num-prefix {
      font-size: clamp(1rem, 1.4vw, 1.35rem);
      font-weight: 800;
      color: rgba(13, 27, 34, 0.55);
      line-height: 1;
    }
    .hwv3-econ-num-figure {
      font-size: clamp(1.85rem, 3.2vw, 2.85rem);
      font-weight: 900;
      letter-spacing: -0.025em;
      color: #0d1b22;
      line-height: 1;
    }
    .hwv3-econ-num-secondary .hwv3-econ-num-figure {
      color: #2DC856;
      font-size: clamp(1.45rem, 2.2vw, 2rem);
    }
    .hwv3-econ-num-secondary .hwv3-econ-num-prefix {
      color: #2DC856;
      font-size: clamp(0.85rem, 1.1vw, 1.1rem);
    }
    .hwv3-econ-num-unit {
      font-size: clamp(0.72rem, 0.9vw, 0.86rem);
      font-weight: 600;
      color: rgba(13, 27, 34, 0.55);
      letter-spacing: -0.01em;
      flex-basis: 100%;
    }
    .hwv3-econ-num-arrow {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(45, 200, 86, 0.10);
      color: #2DC856;
      flex-shrink: 0;
    }
    .hwv3-econ-num-arrow svg {
      width: 18px;
      height: 9px;
    }

    /* Compact multi-stall line — sits inside the numeric mode. */
    .hwv3-econ-num-multi {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      margin: 0;
      padding: 9px 14px;
      border-radius: 10px;
      background: linear-gradient(180deg, #f5f8fc 0%, #eef2f7 100%);
      border: 1px solid rgba(13, 27, 34, 0.06);
    }
    .hwv3-econ-num-multi-label {
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: rgba(13, 27, 34, 0.55);
      line-height: 1.2;
    }
    .hwv3-econ-num-multi-val {
      display: inline-flex;
      align-items: baseline;
      gap: 2px;
      font-feature-settings: "tnum" 1, "lnum" 1;
      color: #1A2F3A;
      font-weight: 900;
      font-size: clamp(1rem, 1.35vw, 1.25rem);
      letter-spacing: -0.018em;
      line-height: 1;
    }
    .hwv3-econ-num-multi-val .hwv3-econ-num-prefix {
      font-size: 0.78rem;
      color: rgba(13, 27, 34, 0.55);
    }

    /* Band mode (Hybrid). */
    .hwv3-econ-band-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(56px, 1.6fr) minmax(0, 1fr);
      gap: clamp(10px, 1.2vw, 18px);
      align-items: center;
    }
    @media (max-width: 600px) {
      .hwv3-econ-band-row { grid-template-columns: 1fr; }
    }
    .hwv3-econ-band-anchor {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .hwv3-econ-band-anchor--low { text-align: left; }
    .hwv3-econ-band-anchor--high { text-align: right; align-items: flex-end; }
    .hwv3-econ-band-val {
      margin: 0;
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
      font-feature-settings: "tnum" 1, "lnum" 1;
    }
    .hwv3-econ-band-val-num {
      font-size: clamp(1.55rem, 2.4vw, 2.1rem);
      font-weight: 900;
      letter-spacing: -0.022em;
      color: #0d1b22;
      line-height: 1;
    }
    .hwv3-econ-band-anchor--high .hwv3-econ-band-val-num {
      color: #1A2F3A;
    }
    .hwv3-econ-band-val-unit {
      font-size: 0.7rem;
      font-weight: 600;
      color: rgba(13, 27, 34, 0.55);
      letter-spacing: -0.005em;
    }
    .hwv3-econ-band-anchor-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(13, 27, 34, 0.62);
      margin: 0;
      line-height: 1.2;
    }
    .hwv3-econ-band-anchor-sub {
      font-size: 0.66rem;
      font-weight: 600;
      color: rgba(13, 27, 34, 0.45);
      margin: 0;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .hwv3-econ-band-track {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 8px;
      width: 100%;
    }
    .hwv3-econ-band-rail {
      position: absolute;
      left: 6px;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(
        90deg,
        rgba(45, 200, 86, 0.55) 0%,
        rgba(45, 200, 86, 0.30) 50%,
        rgba(26, 47, 58, 0.55) 100%
      );
    }
    .hwv3-econ-band-dot {
      position: relative;
      z-index: 1;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
      box-shadow:
        0 0 0 3px #ffffff,
        0 2px 6px rgba(13, 27, 34, 0.18);
    }
    .hwv3-econ-band-dot--left  { background: #2DC856; }
    .hwv3-econ-band-dot--right { background: #1A2F3A; }
    .hwv3-econ-band-caption {
      font-size: clamp(0.78rem, 0.92vw, 0.88rem);
      line-height: 1.5;
      color: rgba(13, 27, 34, 0.6);
      margin: 0;
    }

    /* ─── Subtraction mode (Leasing) — vertical equation card. ─── */
    .hwv3-econ-sub-eq {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin: 0;
      padding: 12px 16px;
      border-radius: 10px;
      background: linear-gradient(180deg, #f5f8fc 0%, #eef2f7 100%);
      border: 1px solid rgba(13, 27, 34, 0.06);
    }
    .hwv3-econ-sub-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 12px;
    }
    .hwv3-econ-sub-key {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #1A2F3A;
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
    }
    .hwv3-econ-sub-op {
      display: inline-grid;
      place-items: center;
      width: 14px;
      font-size: 0.95rem;
      font-weight: 900;
      color: rgba(13, 27, 34, 0.5);
      line-height: 1;
    }
    .hwv3-econ-sub-val {
      margin: 0;
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
      font-feature-settings: "tnum" 1, "lnum" 1;
      color: #0d1b22;
    }
    .hwv3-econ-sub-num {
      font-size: clamp(1.35rem, 1.85vw, 1.65rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .hwv3-econ-sub-unit {
      font-size: 0.7rem;
      font-weight: 600;
      color: rgba(13, 27, 34, 0.55);
      letter-spacing: -0.005em;
    }
    .hwv3-econ-sub-val--soft {
      font-size: 0.85rem;
      font-weight: 700;
      color: rgba(13, 27, 34, 0.55);
      letter-spacing: -0.005em;
      font-style: italic;
    }
    .hwv3-econ-sub-row--total {
      padding-top: 7px;
      border-top: 1px dashed rgba(13, 27, 34, 0.18);
    }
    .hwv3-econ-sub-row--total .hwv3-econ-sub-key {
      color: #0d1b22;
      font-weight: 800;
    }


    /* ─── Source line. ─── */
    .hwv3-econ-source {
      font-size: 0.7rem;
      line-height: 1.5;
      color: rgba(13, 27, 34, 0.45);
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
    }
    .hwv3-econ-source em {
      font-style: normal;
      font-weight: 700;
      color: rgba(13, 27, 34, 0.62);
    }

    /* ─── Reduced motion. ─── */
    @media (prefers-reduced-motion: reduce) {
      .hwv3-econ-thumb,
      [data-hwv3-mode],
      .hwv3-econ-card {
        transition: none;
      }
    }

    /* ─── Compact heights — squeeze for shorter viewports.
           Below ~760px tall we tighten paddings to keep
           everything inside one viewport. ─── */
    @media (max-height: 760px) {
      .hwv3-econ {
        padding-block: clamp(18px, 2vw, 32px);
      }
      .hwv3-econ-frame {
        gap: clamp(10px, 1.2vw, 18px);
      }
      .hwv3-econ-card {
        padding: clamp(12px, 1.4vw, 20px);
        gap: clamp(8px, 1vw, 14px);
      }
      .hwv3-econ-num-figure {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
      }
      .hwv3-econ-band-val-num {
        font-size: clamp(1.35rem, 2vw, 1.8rem);
      }
      .hwv3-econ-card-body {
        font-size: clamp(0.78rem, 0.88vw, 0.86rem);
      }
    }

    /* ═══════════════════════════════════════════════════════
       Economics — mobile (≤759px) overrides
       ──────────────────────────────────────────────────────
       Desktop renders the section as a fixed-height interactive
       dashboard (100svh + max-height:100% on the frame so the
       2-zone + outcome layout fits cleanly inside one viewport).
       At 390px wide that fixed-height crush squeezes 4 tabs +
       2 description cards + an outcome panel into ~720px of
       vertical space — content overflows, tabs clip, and the
       outcome row vanishes.

       Mobile fix:
         · Section becomes `min-height: calc(100dvh - 80px)`
           — still one viewport tall, but content drives the
           actual height so the cards/outcome don't squeeze.
         · Frame drops max-height:100% — content flows
           naturally (still no scroll within section because
           shrunk fonts/paddings keep total height inside one
           viewport).
         · Every interior text size + padding shrunk for the
           narrower column so the editorial register reads
           clearly at phone scale.
       ═══════════════════════════════════════════════════════ */
    @media (max-width: 759px) {
      /* ─── Section + frame ─────────────────────────────────
         Section LOCKED to one mobile viewport (calc(100dvh -
         80px) accounts for the 80px sticky navbar). Frame
         is flex-column so children can use `flex: 1` to
         claim remaining vertical space (zones grow → outcome
         is pushed to the bottom). */
      .hwv3-econ {
        height: calc(100dvh - 80px) !important;
        min-height: calc(100dvh - 80px) !important;
        max-height: calc(100dvh - 80px) !important;
        scroll-margin-top: 80px !important;
        /* Section padding zeroed top/bottom — the frame's
           justify-content:center centers the content cluster
           so the distance from the section's top divider to
           the eyebrow's top equals the distance from the
           outcome's bottom to the section's bottom divider. */
        padding: 0 !important;
        display: block !important;
        align-items: initial !important;
        overflow: hidden !important;
      }
      .hwv3-econ-frame {
        height: 100% !important;
        padding: 0 12px !important;
        gap: 0 !important;
        max-height: none !important;
        min-height: 0 !important;
        display: flex !important;
        flex-direction: column !important;
        /* Centered cluster — content sits as a single unified
           block centered in the section, with EQUAL deadspace
           above the eyebrow and below the outcome panel. */
        justify-content: center !important;
      }

      /* ─── Header ──────────────────────────────────────────
         Sub→tabs gap = 36 (bumped). Slight negative top
         margin (-6) compensates for the ~8px line-box space
         above the eyebrow text, so the section's top→eyebrow
         visible gap equals the outcome→section-bottom gap. */
      .hwv3-econ-head {
        margin-top: -8px !important;
        margin-bottom: 36px !important;
      }
      .hwv3-econ-eyebrow {
        font-size: 12px !important;
        letter-spacing: 0.28em !important;
        margin: 0 0 6px !important;
        gap: 11px !important;
      }
      .hwv3-econ-eyebrow-rule {
        width: 22px !important;
      }
      .hwv3-econ-title {
        font-size: 25px !important;
        line-height: 1.03 !important;
        margin: 0 0 6px !important;
      }
      .hwv3-econ-sub {
        font-size: 12.5px !important;
        line-height: 1.32 !important;
      }

      /* ─── Mirror desktop's "2 cards above 1 wide card"
         layout on mobile.

         Desktop: zones grid is 1.4fr | 1fr — two zones side-
         by-side, each zone is (picker bar) + (description
         card) stacked vertically. Outcome panel sits BELOW
         the zones row.

         Mobile rebuild: keep the two description cards side-
         by-side (top row), with both picker bars stacked at
         FULL WIDTH above them (rows 1 + 2) so 4 model tabs
         + 3 tier tabs fit comfortably. Cards stay side-by-
         side as user requested. Outcome panel still flows
         below from the frame's normal layout.

         Implementation: zones becomes a grid; each zone
         element gets `display: contents` so its children
         (the picker bar + the card) flow as direct grid
         items, then we explicitly place each one into a
         row/column. ─── */
      /* Two-column zones grid — each picker sits above its
         own card.
         · row-gap (tabs → cards) = 18 (small bump).
         · margin-bottom (cards → outcome) = 30 (big bump). */
      .hwv3-econ-zones {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        grid-template-rows: auto auto !important;
        row-gap: 18px !important;
        column-gap: 8px !important;
        align-items: stretch !important;
        flex: 0 0 auto !important;
        min-height: 0 !important;
        margin-bottom: 30px !important;
      }
      .hwv3-econ-zone {
        display: contents !important;
      }
      /* Model picker — col 1, row 1 (above the model card) */
      .hwv3-econ-zone--model .hwv3-econ-zone-bar {
        grid-column: 1 !important;
        grid-row: 1 !important;
      }
      /* Tier picker — col 2, row 1 (above the tier card) */
      .hwv3-econ-zone--tier .hwv3-econ-zone-bar {
        grid-column: 2 !important;
        grid-row: 1 !important;
      }
      /* Model card — col 1, row 2 */
      .hwv3-econ-zone--model .hwv3-econ-card {
        grid-column: 1 !important;
        grid-row: 2 !important;
        min-height: 0 !important;
      }
      /* Tier card — col 2, row 2 */
      .hwv3-econ-zone--tier .hwv3-econ-card {
        grid-column: 2 !important;
        grid-row: 2 !important;
        min-height: 0 !important;
      }
      /* Per-column zone-bar — stack label above the segmented
         tab control so the picker fits the narrow column. */
      .hwv3-econ-zone-bar {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 8px !important;
      }
      .hwv3-econ-zone-label {
        font-size: 10.5px !important;
        letter-spacing: 0.22em !important;
        text-align: center !important;
      }

      /* Segmented control — bigger font + more padding so the
         pickers read with proper editorial weight. Long labels
         ("Client Investment") wrap to 2 lines inside narrow
         columns rather than clipping. */
      .hwv3-econ-segmented {
        padding: 3px !important;
        border-radius: 11px !important;
      }
      .hwv3-econ-tab {
        font-size: 10px !important;
        padding: 8px 3px !important;
        letter-spacing: 0 !important;
        line-height: 1.18 !important;
        font-weight: 700 !important;
        white-space: normal !important;
        text-align: center !important;
      }

      /* Cards — INNER content bumped bigger, but cards are
         shorter overall by hiding the body description.
         Result: flag + title + (specs|stats) is the punchy
         editorial register; the descriptive paragraph lives
         on the desktop pattern only. */
      .hwv3-econ-card {
        padding: 11px !important;
        gap: 4px !important;
        border-radius: 12px !important;
        overflow: hidden !important;
      }
      .hwv3-econ-card-head {
        gap: 5px !important;
      }
      .hwv3-econ-card-flag {
        font-size: 8.5px !important;
        padding: 3px 8px !important;
        letter-spacing: 0.12em !important;
        align-self: flex-start;
        max-width: 100%;
      }
      .hwv3-econ-card-title {
        font-size: 18px !important;
        line-height: 1.05 !important;
        letter-spacing: -0.02em;
      }
      .hwv3-econ-card-tagline {
        display: none !important;
      }
      /* Body description hidden on mobile — cards stay short
         so the section can breathe. */
      .hwv3-econ-card-body {
        display: none !important;
      }
      /* Model spec grid — single column, label|value rows.
         Bumped for editorial weight. */
      .hwv3-econ-spec {
        grid-template-columns: 1fr !important;
        gap: 2px !important;
        margin-top: 4px !important;
      }
      .hwv3-econ-spec > div {
        padding: 3px 8px !important;
        /* Stacked layout: label-above-value. Each row takes
           full card width for the value, so long values like
           "Shared, host-favored" stay on a single line. The
           dt label sits as a small caption above each value. */
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 0 !important;
      }
      .hwv3-econ-spec dt {
        font-size: 9.5px !important;
        letter-spacing: 0.14em !important;
        margin: 0 !important;
        opacity: 0.7;
      }
      .hwv3-econ-spec dd {
        font-size: 13.5px !important;
        line-height: 1.18 !important;
        font-weight: 700 !important;
      }

      /* Tier card stats — label above value, both stacked.
         Compressed to keep the cards short enough to fit the
         section's 720 viewport budget while the gap tiers
         (sub→tabs 28, cards→outcome 22) consume the rest. */
      .hwv3-econ-tier-stats {
        grid-template-columns: 1fr !important;
        gap: 4px !important;
        margin: 3px 0 !important;
        padding: 5px 0 !important;
      }
      .hwv3-econ-tier-stats > div {
        padding: 2px 8px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 1px !important;
      }
      .hwv3-econ-tier-stats dt {
