---
/**
 * /home-v3 — Home page, v3 (testing sandbox).
 * ─────────────────────────────────────────────
 * Full decoupled copy of /home-v2's entire page structure.
 * Only difference from v2: the hero is HeroHomeMainV3 (the
 * consultation-form variant) instead of HeroHomeMainV2 (the
 * eligibility-pill variant). Every other section is a
 * v3-cloned component so iteration here cannot bleed into
 * v2 even after the hero stabilizes.
 *
 * SiteFooter is intentionally NOT cloned — it's the site-wide
 * shared footer and belongs to the broader layout, not the
 * home page. Edit it in one place for the whole site.
 *
 * In addition to the v2 stack, this page wires up:
 *   - ConsultationForm        — the form lifted out of the
 *                               hero into a shared component
 *   - ConsultationStickyTab   — a brand-green tab that pops
 *                               out from the right side when
 *                               the visitor scrolls past the
 *                               hero. Clicking it opens a
 *                               sidebar drawer with the same
 *                               ConsultationForm. Wired only
 *                               here for now; eventually goes
 *                               site-wide once refined.
 */
import Layout from '../layouts/Layout.astro';
import HeroHomeMainV3 from '../components/heroes/HeroHomeMainV3.astro';
import HeroPortalSolutionsSceneV3 from '../components/heroes/HeroPortalSolutionsSceneV3.astro';
import LocationsMapSectionV3 from '../components/LocationsMapSectionV3.astro';
import HomeFaqSectionV3 from '../components/HomeFaqSectionV3.astro';
import HomeAppDownloadSectionV3 from '../components/HomeAppDownloadSectionV3.astro';
import ConsultationStickyTab from '../components/ConsultationStickyTab.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Layout title="Evium Charging — Home v3" headerVariant="v4" bodyClass="page-home-v3">
  <HeroHomeMainV3 />
  <HeroPortalSolutionsSceneV3 />
  <LocationsMapSectionV3 />
  <HomeFaqSectionV3 />
  <HomeAppDownloadSectionV3 />
  <SiteFooter />

  <!-- Sticky right-edge tab + drawer. Shows AFTER the
       visitor scrolls past the hero (the hero already has
       its own form, so the tab would be redundant there).
       JS in the component watches for the hero leaving
       the viewport via IntersectionObserver. -->
  <ConsultationStickyTab />
</Layout>
