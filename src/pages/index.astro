---
/**
 * / — Default landing page.
 * ─────────────────────────
 * Renders the v4 stack so visitors hitting the bare root
 * URL land on the current production-intent home page
 * (HeaderV5 rail + V4 scene components). The legacy homes
 * are preserved at their version-specific routes:
 *   /home-v1, /home-v2, /home-v3, /home-v4.
 * This file just mirrors v4's stack so the canonical URL
 * is /.
 *
 * Mirrors /home-v4 exactly — same components, same
 * headerVariant="v5", same bodyClass="page-home-v4" — so
 * HeaderV5 and the V4 scene components branch identically
 * whether the visitor lands on / or /home-v4. (The V4
 * Portal/Solutions scene's `/#solutions` smooth-scroll
 * handler is gated on `pathname === '/'`, so it activates
 * correctly here on the canonical root.)
 */
import Layout from '../layouts/Layout.astro';
import HeroHomeMainV4 from '../components/heroes/HeroHomeMainV4.astro';
import HeroPortalSolutionsSceneV4 from '../components/heroes/HeroPortalSolutionsSceneV4.astro';
import LocationsMapSectionV4 from '../components/LocationsMapSectionV4.astro';
import HomeFaqSectionV4 from '../components/HomeFaqSectionV4.astro';
import HomeAppDownloadSectionV4 from '../components/HomeAppDownloadSectionV4.astro';
import ConsultationStickyTab from '../components/ConsultationStickyTabV2.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Layout title="Evium Charging" headerVariant="v5" bodyClass="page-home-v4">
  <HeroHomeMainV4 />
  <HeroPortalSolutionsSceneV4 />
  <LocationsMapSectionV4 />
  <HomeFaqSectionV4 />
  <HomeAppDownloadSectionV4 />
  <SiteFooter />

  <!-- Sticky right-edge tab + drawer. Shows AFTER the
       visitor scrolls past the hero (the hero already has
       its own form, so the tab would be redundant there). -->
  <ConsultationStickyTab />
</Layout>
