---
/**
 * /testing/calculator-layouts — LAYOUT COMPARISON PAGE
 * ────────────────────────────────────────────────────
 * A side-by-side showcase of four candidate layouts for the
 * profits-page calculator, each a fully-working instance:
 *
 *   Option A — Result-First Hero      (big number on top, controls beneath)
 *   Option B — Editorial 2-Zone       (controls left, tall result panel right)
 *   Option C — Stage Flow             (3 control stages → result stage)
 *   Option D — Floating Result Band   (result hero band, controls grid below)
 *
 * All four share one reusable `initCalculator(root)` engine and one
 * estimate modal. Each calculator root is `[data-calc-root]` with a
 * `data-option` id; the engine scopes every query to its root so the
 * four instances are fully independent (their model radios use
 * per-instance `name` values too).
 *
 * The repeated sub-pieces — scenario pills, utilization pills, input
 * fields, model cards, result block — are rendered from frontmatter
 * helper functions via `set:html` so the markup isn't copy-pasted
 * four times.
 *
 * This page is for picking a direction; once chosen, the winning
 * layout gets ported into /testing/profits.
 */
import Layout from '../../layouts/Layout.astro';

/* ── Scenario presets (Property Type) ───────────────────────────
   Same data shape as /testing/profits. The per-scenario L/M/H
   session rates remain illustrative (not internally sourced) —
   see the note on the profits page. */
const presets = [
  {
    id: 'l2-residential',
    label: 'Multifamily',
    type: 'L2',
    ports: 4,
    utilization: { low: 1, medium: 2.5, high: 4 },
    kwh: 18,
    price: 0.32,
  },
  {
    id: 'dcfc-highway',
    label: 'Highway',
    type: 'DCFC',
    ports: 4,
    utilization: { low: 6, medium: 12, high: 18 },
    kwh: 45,
    price: 0.55,
  },
  {
    id: 'l2-fleets',
    label: 'Fleets',
    type: 'L2',
    ports: 8,
    utilization: { low: 1, medium: 1.5, high: 2 },
    kwh: 60,
    price: 0.35,
  },
];

/* ── Financial models (Step 3) ──────────────────────────────────
   No-Cost share is ~10% per project_evium_business_model.md. */
const models = [
  { id: 'no-cost',    label: 'No-Cost',           share: 0.10, badge: '~10%',       blurb: '$0 capital. Evium handles everything.' },
  { id: 'investment', label: 'Client Investment', share: 1.00, badge: '100%',       blurb: 'You own equipment. Keep all revenue.' },
  { id: 'hybrid',     label: 'Hybrid',            share: 0.50, badge: 'Negotiated', blurb: 'Shared capital. Split negotiated.' },
  { id: 'leasing',    label: 'Leasing',           share: 1.00, badge: '100%',       blurb: 'Lease hardware. Keep revenue, pay fee.' },
];

/* ── Layout option metadata (intro + section headers) ──────────── */
const layoutOptions = [
  {
    id: 'a',
    name: 'Option A',
    tagline: 'Result-First Hero',
    desc: 'The big number leads. Controls flow underneath in a clean 01 → 02 → 03 narrative. One unified card, no internal grid — the strongest "wow" moment of the four.',
  },
  {
    id: 'b',
    name: 'Option B',
    tagline: 'Editorial 2-Zone',
    desc: 'Controls stack vertically on the left, a tall result panel sits on the right with its own greener surface. Keeps the live-update side-by-side feel while killing the fragmentation.',
  },
  {
    id: 'c',
    name: 'Option C',
    tagline: 'Stage Flow',
    desc: 'Three control stages laid out left-to-right with connectors, resolving into a final result stage. Reads as a deliberate, guided process — every stage visible at once, no Next clicks.',
  },
  {
    id: 'd',
    name: 'Option D',
    tagline: 'Floating Result Band',
    desc: 'The result becomes a full-width hero band. Controls sit in an equal-weight three-column grid below, breakdown beneath that. Maximum drama on the number; every control gets its own column.',
  },
  {
    id: 'e',
    name: 'Option E',
    tagline: 'Showroom Console',
    desc: 'The one bright-surfaced direction — a light "showroom" card. Every picker is a pill-shaped segmented control with a sliding thumb, paired into labelled zones; the whole thing resolves into a full-width outcome panel. Reads like a product configurator, not a form. Inspired by the highway "Economics" dashboard.',
  },
  {
    id: 'f',
    name: 'Option F',
    tagline: 'Live Console',
    desc: 'The synthesis. Two columns: controls on the left, a result panel on the right that stays stuck in view as you scroll — so the number is always live while you tweak. Segmented controls from E for the simple picks; the financial model gets a segmented picker plus a description card that rewrites itself per selection (the highway "picker-owns-a-card" idea, fully). Configure → watch → understand, all in one frame.',
  },
  {
    id: 'o',
    name: 'Option O',
    tagline: 'Original',
    desc: 'The calculator currently live on /testing/profits, preserved here for reference before F replaces it. A two-pill scenario picker (Custom · Property Type · Utilization) above a two-column inputs-and-results card, with the four financial models as a full-width card row beneath. Same shared engine and data as every option above.',
  },
];

/* ── SVG icon paths (kept here so they aren't repeated 12+ times) ── */
const scenarioIconPaths: Record<string, string> = {
  'l2-residential': 'M3 21h18M5 21V7l8-4v18M13 21V11l6 2v8M9 9h.01M9 13h.01M9 17h.01M16 15h.01M16 19h.01',
  'dcfc-highway':   'M5 21l4-18M19 21l-4-18M3 9h18M3 15h18',
  'l2-fleets':      'M2 8h11v9H2zM13 11h5l3 3v3h-8zM6 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z',
};
const customIconPath = 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z';

/* ── Reusable markup helpers (rendered via set:html) ──────────── */
function scenarioPillsHTML(): string {
  return presets.map(p => `
    <button type="button" class="lc-scenario-btn"
      data-scenario="${p.id}" data-ports="${p.ports}"
      data-util-low="${p.utilization.low}" data-util-medium="${p.utilization.medium}" data-util-high="${p.utilization.high}"
      data-kwh="${p.kwh}" data-price="${p.price}" data-type="${p.type}">
      <span class="lc-scenario-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="${scenarioIconPaths[p.id]}" />
        </svg>
      </span>
      <span class="lc-scenario-text">
        <span class="lc-scenario-label">${p.label}</span>
        <span class="lc-scenario-type">${p.type}</span>
      </span>
    </button>
  `).join('');
}

function customPillHTML(): string {
  return `
    <button type="button" class="lc-scenario-btn lc-scenario-btn--custom" data-scenario="custom">
      <span class="lc-scenario-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="${customIconPath}" />
        </svg>
      </span>
      <span class="lc-scenario-text">
        <span class="lc-scenario-label">Custom</span>
        <span class="lc-scenario-type">Off-preset</span>
      </span>
    </button>
  `;
}

function utilPillsHTML(): string {
  return (['low', 'medium', 'high'] as const).map(level => `
    <button type="button" class="lc-util-btn" data-utilization="${level}">
      <span class="lc-util-label">${level}</span>
      <span class="lc-util-rate" data-util-rate>—</span>
      <span class="lc-util-mini">/ port / day</span>
    </button>
  `).join('');
}

function inputFieldsHTML(): string {
  const fields = [
    { id: 'sessions', label: 'Sessions / Port / Day', suffix: '/ day', value: '6',    step: '0.5',  hint: 'Typical L2: 2–4 · DC Fast: 8–14',          prefix: '' },
    { id: 'ports',    label: 'Number of Ports',       suffix: 'ports', value: '4',    step: '1',    hint: 'Each charger has 1–2 ports',               prefix: '' },
    { id: 'kwh',      label: 'kWh / Session',         suffix: 'kWh',   value: '25',   step: '1',    hint: 'Typical L2: 15–25 · DC Fast: 30–50',       prefix: '' },
    { id: 'price',    label: 'Price / kWh',           suffix: '/ kWh', value: '0.42', step: '0.01', hint: 'Public charging average: $0.30–$0.55',     prefix: '$' },
  ];
  return fields.map(f => `
    <div class="lc-input-field">
      <label class="lc-input-label">${f.label}</label>
      <div class="lc-input-wrap${f.prefix ? ' lc-input-wrap--prefixed' : ''}">
        ${f.prefix ? '<span class="lc-input-prefix">' + f.prefix + '</span>' : ''}
        <input data-input="${f.id}" type="number" inputmode="decimal" min="0" step="${f.step}" value="${f.value}" class="lc-input" />
        <span class="lc-input-suffix">${f.suffix}</span>
      </div>
      <p class="lc-input-hint">${f.hint}</p>
    </div>
  `).join('');
}

function modelCardsHTML(optId: string): string {
  return models.map((m, i) => `
    <label class="lc-model-option">
      <input type="radio" name="model-${optId}" value="${m.share}" data-model-id="${m.id}" ${i === 0 ? 'checked' : ''} class="lc-sr-only" />
      <div class="lc-model-card">
        <div class="lc-model-card-top">
          <p class="lc-model-label">${m.label}</p>
          <span class="lc-model-dot"><span class="lc-model-dot-inner"></span></span>
        </div>
        <span class="lc-model-badge">${m.badge}</span>
        <p class="lc-model-blurb">${m.blurb}</p>
      </div>
    </label>
  `).join('');
}

function resultBlockHTML(): string {
  return `
    <p class="lc-result-eyebrow">Your Monthly Share</p>
    <p class="lc-result-monthly" data-out="monthly">$0</p>
    <p class="lc-result-caption" data-out="caption">—</p>
    <div class="lc-result-secondary">
      <div class="lc-result-stat">
        <span class="lc-result-stat-num" data-out="yearly">$0</span>
        <span class="lc-result-stat-lbl">per year</span>
      </div>
      <div class="lc-result-stat">
        <span class="lc-result-stat-num lc-result-stat-num--accent" data-out="fiveyr">$0</span>
        <span class="lc-result-stat-lbl">over 5 years</span>
      </div>
    </div>
    <div class="lc-breakdown">
      <div class="lc-breakdown-row"><span>Gross monthly</span><span data-out="gross">$0</span></div>
      <div class="lc-breakdown-row"><span>Sessions / month</span><span data-out="sessions">0</span></div>
      <div class="lc-breakdown-row"><span>Energy delivered (kWh/mo)</span><span data-out="energy">0</span></div>
      <div class="lc-breakdown-row lc-breakdown-row--total"><span>Your revenue share</span><span data-out="share">10%</span></div>
    </div>
    <button type="button" data-open-estimate class="lc-cta">
      Get a Personalized Estimate
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </button>
  `;
}

/* Step header (icon + eyebrow + title). Icons: 1=bars, 2=sliders, 3=scale. */
function stepHeaderHTML(num: string, title: string, icon: 'bars' | 'sliders' | 'scale'): string {
  const paths = {
    bars:    'M9 17V7m4 10V11m4 6V4M3 21h18',
    sliders: 'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6',
    scale:   'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  };
  return `
    <div class="lc-step-header">
      <div class="lc-step-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="${paths[icon]}" />
        </svg>
      </div>
      <div>
        <p class="lc-step-eyebrow">Step ${num}</p>
        <h4 class="lc-step-title">${title}</h4>
      </div>
    </div>
  `;
}

/* ── Option E — segmented-control renderers ─────────────────────
   These feed the SAME calculator engine as the pill renderers
   above — the buttons keep every hook the engine reads
   (data-scenario / data-ports / data-util-* / data-type, the
   .lc-scenario-label the caption pulls from, [data-util-rate],
   the model radios + .lc-model-label) — they're just laid out
   as flat segments inside a pill-shaped track. The leading
   <span class="lc-e-thumb"> is the sliding indicator; a small
   enhancement script mirrors the active index onto the track's
   data-thumb attribute, which the CSS slides the thumb by. */
function scenarioSegmentsHTML(): string {
  const preset = presets.map(p => `
    <button type="button" class="lc-e-seg-btn" data-scenario="${p.id}"
      data-ports="${p.ports}" data-util-low="${p.utilization.low}"
      data-util-medium="${p.utilization.medium}" data-util-high="${p.utilization.high}"
      data-kwh="${p.kwh}" data-price="${p.price}" data-type="${p.type}">
      <span class="lc-scenario-label lc-e-seg-name">${p.label}</span>
      <span class="lc-e-seg-sub">${p.type}</span>
    </button>
  `).join('');
  const custom = `
    <button type="button" class="lc-e-seg-btn lc-e-seg-btn--custom" data-scenario="custom">
      <span class="lc-scenario-label lc-e-seg-name">Custom</span>
      <span class="lc-e-seg-sub">Off-preset</span>
    </button>
  `;
  return `<span class="lc-e-thumb" aria-hidden="true"></span>${preset}${custom}`;
}

function utilSegmentsHTML(): string {
  const btns = (['low', 'medium', 'high'] as const).map(level => `
    <button type="button" class="lc-e-seg-btn" data-utilization="${level}">
      <span class="lc-e-seg-name">${level}</span>
      <span class="lc-e-seg-sub"><span data-util-rate>—</span>&nbsp;/ port / day</span>
    </button>
  `).join('');
  return `<span class="lc-e-thumb" aria-hidden="true"></span>${btns}`;
}

function modelSegmentsHTML(optId: string): string {
  const items = models.map((m, i) => `
    <label class="lc-model-option lc-e-seg-model-item">
      <input type="radio" name="model-${optId}" value="${m.share}" data-model-id="${m.id}" ${i === 0 ? 'checked' : ''} class="lc-sr-only" />
      <span class="lc-e-seg-model-card">
        <span class="lc-model-label lc-e-seg-name">${m.label}</span>
        <span class="lc-e-seg-model-badge">${m.badge}</span>
      </span>
    </label>
  `).join('');
  return `<span class="lc-e-thumb" aria-hidden="true"></span>${items}`;
}
---

<Layout
  title="Calculator Layout Options — Evium Testing"
  description="Side-by-side comparison of four candidate layouts for the Evium profit calculator."
>

  <!-- ═══════════════════════════════════════════════
       INTRO + JUMP NAV
  ═══════════════════════════════════════════════ -->
  <section class="lc-intro">
    <div class="lc-intro-bg" aria-hidden="true"></div>
    <div class="lc-intro-inner">
      <p class="lc-intro-eyebrow">Internal · Layout Exploration</p>
      <h1 class="lc-intro-title">
        Calculator layout,<br />
        <span class="lc-intro-title-accent">seven ways.</span>
      </h1>
      <p class="lc-intro-sub">
        Seven fully-working takes on the profits-page calculator — same engine, same data,
        seven different compositions. Each is live: pick a scenario, tweak the inputs, switch
        the financial model, watch the number move. <strong>F, Live Console</strong> is the
        synthesis — the best of A–E pulled into one direction — and <strong>O, Original</strong>
        is the build currently live on /profits, kept here for reference.
      </p>
      <nav class="lc-jump" aria-label="Jump to layout option">
        {layoutOptions.map(o => (
          <a href={`#option-${o.id}`} class="lc-jump-link">
            <span class="lc-jump-tag">{o.name}</span>
            <span class="lc-jump-name">{o.tagline}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION A — RESULT-FIRST HERO
  ═══════════════════════════════════════════════ -->
  <section id="option-a" class="lc-option lc-option--a">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">A</div>
        <div>
          <h2 class="lc-option-title">Result-First Hero</h2>
          <p class="lc-option-desc">{layoutOptions[0].desc}</p>
        </div>
      </header>

      <div class="lc-card lc-layout-a" data-calc-root data-option="a">
        <!-- RESULT HERO -->
        <div class="lc-a-result">
          <div class="lc-a-result-glow" aria-hidden="true"></div>
          <div class="lc-result lc-result--hero" set:html={resultBlockHTML()}></div>
        </div>

        <div class="lc-a-divider" aria-hidden="true"></div>

        <!-- CONTROLS -->
        <div class="lc-a-controls">
          <!-- 01 Scenario -->
          <div class="lc-a-step">
            <Fragment set:html={stepHeaderHTML('01', 'Pick a Scenario', 'bars')} />
            <div class="lc-scenario-zones">
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Off-Preset</p>
                <div class="lc-chips" set:html={customPillHTML()}></div>
              </div>
              <div class="lc-scenario-zone lc-scenario-zone--type">
                <p class="lc-group-label">Property Type</p>
                <div class="lc-chips" set:html={scenarioPillsHTML()}></div>
              </div>
              <div class="lc-scenario-zone lc-scenario-zone--util">
                <p class="lc-group-label">Projected Utilization</p>
                <div class="lc-chips" set:html={utilPillsHTML()}></div>
              </div>
            </div>
          </div>

          <!-- 02 Inputs -->
          <div class="lc-a-step">
            <Fragment set:html={stepHeaderHTML('02', 'Refine the Inputs', 'sliders')} />
            <div class="lc-input-row" set:html={inputFieldsHTML()}></div>
          </div>

          <!-- 03 Model -->
          <div class="lc-a-step">
            <Fragment set:html={stepHeaderHTML('03', 'Choose a Financial Model', 'scale')} />
            <div class="lc-model-grid" set:html={modelCardsHTML('a')}></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION B — EDITORIAL 2-ZONE
  ═══════════════════════════════════════════════ -->
  <section id="option-b" class="lc-option lc-option--b">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">B</div>
        <div>
          <h2 class="lc-option-title">Editorial 2-Zone</h2>
          <p class="lc-option-desc">{layoutOptions[1].desc}</p>
        </div>
      </header>

      <div class="lc-card lc-layout-b" data-calc-root data-option="b">
        <!-- LEFT — controls -->
        <div class="lc-b-controls">
          <div class="lc-b-step">
            <Fragment set:html={stepHeaderHTML('01', 'Pick a Scenario', 'bars')} />
            <div class="lc-b-scenario">
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Property Type</p>
                <div class="lc-chips" set:html={scenarioPillsHTML() + customPillHTML()}></div>
              </div>
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Projected Utilization</p>
                <div class="lc-chips" set:html={utilPillsHTML()}></div>
              </div>
            </div>
          </div>

          <div class="lc-b-divider" aria-hidden="true"></div>

          <div class="lc-b-step">
            <Fragment set:html={stepHeaderHTML('02', 'Refine the Inputs', 'sliders')} />
            <div class="lc-input-row lc-input-row--2col" set:html={inputFieldsHTML()}></div>
          </div>

          <div class="lc-b-divider" aria-hidden="true"></div>

          <div class="lc-b-step">
            <Fragment set:html={stepHeaderHTML('03', 'Choose a Financial Model', 'scale')} />
            <div class="lc-model-grid lc-model-grid--2col" set:html={modelCardsHTML('b')}></div>
          </div>
        </div>

        <!-- RIGHT — result zone -->
        <div class="lc-b-result">
          <div class="lc-b-result-glow" aria-hidden="true"></div>
          <div class="lc-result lc-result--panel" set:html={resultBlockHTML()}></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION C — STAGE FLOW
  ═══════════════════════════════════════════════ -->
  <section id="option-c" class="lc-option lc-option--c">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">C</div>
        <div>
          <h2 class="lc-option-title">Stage Flow</h2>
          <p class="lc-option-desc">{layoutOptions[2].desc}</p>
        </div>
      </header>

      <div class="lc-card lc-layout-c" data-calc-root data-option="c">
        <!-- STAGE 1 — Scenario -->
        <div class="lc-c-stage">
          <div class="lc-c-stage-num">1</div>
          <Fragment set:html={stepHeaderHTML('01', 'Scenario', 'bars')} />
          <div class="lc-c-stage-body">
            <div class="lc-scenario-zone">
              <p class="lc-group-label">Property Type</p>
              <div class="lc-chips lc-chips--stacked" set:html={scenarioPillsHTML()}></div>
            </div>
            <div class="lc-scenario-zone">
              <p class="lc-group-label">Off-Preset</p>
              <div class="lc-chips lc-chips--stacked" set:html={customPillHTML()}></div>
            </div>
            <div class="lc-scenario-zone">
              <p class="lc-group-label">Projected Utilization</p>
              <div class="lc-chips lc-chips--stacked" set:html={utilPillsHTML()}></div>
            </div>
          </div>
        </div>

        <div class="lc-c-connector" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>

        <!-- STAGE 2 — Inputs -->
        <div class="lc-c-stage">
          <div class="lc-c-stage-num">2</div>
          <Fragment set:html={stepHeaderHTML('02', 'Inputs', 'sliders')} />
          <div class="lc-c-stage-body">
            <div class="lc-input-row lc-input-row--stacked" set:html={inputFieldsHTML()}></div>
          </div>
        </div>

        <div class="lc-c-connector" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>

        <!-- STAGE 3 — Model -->
        <div class="lc-c-stage">
          <div class="lc-c-stage-num">3</div>
          <Fragment set:html={stepHeaderHTML('03', 'Model', 'scale')} />
          <div class="lc-c-stage-body">
            <div class="lc-model-grid lc-model-grid--stacked" set:html={modelCardsHTML('c')}></div>
          </div>
        </div>

        <div class="lc-c-connector lc-c-connector--final" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>

        <!-- RESULT STAGE -->
        <div class="lc-c-stage lc-c-stage--result">
          <div class="lc-c-stage-num lc-c-stage-num--result">$</div>
          <div class="lc-c-result-glow" aria-hidden="true"></div>
          <div class="lc-result lc-result--stage" set:html={resultBlockHTML()}></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION D — FLOATING RESULT BAND
  ═══════════════════════════════════════════════ -->
  <section id="option-d" class="lc-option lc-option--d">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">D</div>
        <div>
          <h2 class="lc-option-title">Floating Result Band</h2>
          <p class="lc-option-desc">{layoutOptions[3].desc}</p>
        </div>
      </header>

      <div class="lc-layout-d" data-calc-root data-option="d">
        <!-- RESULT BAND -->
        <div class="lc-d-band">
          <div class="lc-d-band-glow" aria-hidden="true"></div>
          <div class="lc-result lc-result--band" set:html={resultBlockHTML()}></div>
        </div>

        <!-- CONTROLS GRID -->
        <div class="lc-d-controls">
          <div class="lc-d-control-col">
            <Fragment set:html={stepHeaderHTML('01', 'Scenario', 'bars')} />
            <div class="lc-d-control-body">
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Property Type</p>
                <div class="lc-chips" set:html={scenarioPillsHTML()}></div>
              </div>
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Off-Preset</p>
                <div class="lc-chips" set:html={customPillHTML()}></div>
              </div>
              <div class="lc-scenario-zone">
                <p class="lc-group-label">Projected Utilization</p>
                <div class="lc-chips" set:html={utilPillsHTML()}></div>
              </div>
            </div>
          </div>

          <div class="lc-d-control-col">
            <Fragment set:html={stepHeaderHTML('02', 'Inputs', 'sliders')} />
            <div class="lc-d-control-body">
              <div class="lc-input-row lc-input-row--stacked" set:html={inputFieldsHTML()}></div>
            </div>
          </div>

          <div class="lc-d-control-col">
            <Fragment set:html={stepHeaderHTML('03', 'Model', 'scale')} />
            <div class="lc-d-control-body">
              <div class="lc-model-grid lc-model-grid--stacked" set:html={modelCardsHTML('d')}></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION E — SHOWROOM CONSOLE
       Light "showroom" surface. Segmented-control pickers
       with sliding thumbs, paired into labelled zones,
       resolving to a full-width outcome panel. Inspired by
       the highway-v3 "Economics" dashboard.
  ═══════════════════════════════════════════════ -->
  <section id="option-e" class="lc-option lc-option--e">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">E</div>
        <div>
          <h2 class="lc-option-title">Showroom Console</h2>
          <p class="lc-option-desc">{layoutOptions[4].desc}</p>
        </div>
      </header>

      <div class="lc-card lc-layout-e" data-calc-root data-option="e">
        <div class="lc-e-bg" aria-hidden="true"></div>
        <div class="lc-e-frame">

          <!-- ZONES — property type + utilization, each a
               segmented control under its own label bar -->
          <div class="lc-e-zones">
            <div class="lc-e-zone">
              <div class="lc-e-zone-head">
                <span class="lc-e-zone-label">Property Type</span>
                <span class="lc-e-zone-hint">What the site is charging for</span>
              </div>
              <div class="lc-e-seg lc-e-seg--4" role="group" aria-label="Property type" set:html={scenarioSegmentsHTML()}></div>
            </div>
            <div class="lc-e-zone">
              <div class="lc-e-zone-head">
                <span class="lc-e-zone-label">Projected Utilization</span>
                <span class="lc-e-zone-hint">How hard the chargers run</span>
              </div>
              <div class="lc-e-seg lc-e-seg--3" role="group" aria-label="Projected utilization" set:html={utilSegmentsHTML()}></div>
            </div>
          </div>

          <!-- SITE INPUTS — fine-tune any number -->
          <div class="lc-e-zone lc-e-zone--inputs">
            <div class="lc-e-zone-head">
              <span class="lc-e-zone-label">Site Inputs</span>
              <span class="lc-e-zone-hint">Edit any field — the pickers switch to Custom</span>
            </div>
            <div class="lc-input-row" set:html={inputFieldsHTML()}></div>
          </div>

          <!-- FINANCIAL MODEL — full-width segmented control -->
          <div class="lc-e-zone lc-e-zone--model">
            <div class="lc-e-zone-head">
              <span class="lc-e-zone-label">Financial Model</span>
              <span class="lc-e-zone-hint">How capital and revenue are split</span>
            </div>
            <div class="lc-e-seg lc-e-seg--4 lc-e-seg-model" role="group" aria-label="Financial model" set:html={modelSegmentsHTML('e')}></div>
          </div>

          <!-- OUTCOME PANEL — full width, derived figures -->
          <div class="lc-e-outcome">
            <div class="lc-e-out-glow" aria-hidden="true"></div>
            <p class="lc-e-out-eyebrow">
              <span class="lc-e-out-tag">Outcome</span>
              <span class="lc-e-out-combo" data-out="caption">—</span>
            </p>
            <div class="lc-e-out-main">
              <div class="lc-e-out-figure-block">
                <p class="lc-e-out-label">Your monthly share</p>
                <p class="lc-e-out-primary">
                  <span class="lc-e-out-figure" data-out="monthly">$0</span>
                  <span class="lc-e-out-unit">/ month</span>
                </p>
              </div>
              <span class="lc-e-out-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 12" fill="none">
                  <path d="M1 6 L22 6 M16 1 L22 6 L16 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div class="lc-e-out-projections">
                <div class="lc-e-out-proj">
                  <span class="lc-e-out-proj-num" data-out="yearly">$0</span>
                  <span class="lc-e-out-proj-lbl">per year</span>
                </div>
                <div class="lc-e-out-proj">
                  <span class="lc-e-out-proj-num lc-e-out-proj-num--accent" data-out="fiveyr">$0</span>
                  <span class="lc-e-out-proj-lbl">over 5 years</span>
                </div>
              </div>
            </div>
            <dl class="lc-e-out-breakdown">
              <div><dt>Gross monthly</dt><dd data-out="gross">$0</dd></div>
              <div><dt>Sessions / mo</dt><dd data-out="sessions">0</dd></div>
              <div><dt>Energy / mo</dt><dd><span data-out="energy">0</span>&nbsp;<span class="lc-e-out-bd-unit">kWh</span></dd></div>
              <div class="lc-e-out-breakdown-accent"><dt>Revenue share</dt><dd data-out="share">10%</dd></div>
            </dl>
            <button type="button" data-open-estimate class="lc-e-cta">
              Get a Personalized Estimate
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION F — LIVE CONSOLE  (the synthesis)
       Two-column: controls left, sticky result right, so
       the number stays live while you configure. Segmented
       controls (from E) for the simple picks; the financial
       model gets a segmented picker + a description card
       that rewrites per selection (the highway-v3
       "picker-owns-a-card" idea, fully ported).
  ═══════════════════════════════════════════════ -->
  <section id="option-f" class="lc-option lc-option--f">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">F</div>
        <div>
          <h2 class="lc-option-title">Live Console</h2>
          <p class="lc-option-desc">{layoutOptions[5].desc}</p>
        </div>
      </header>

      <div class="lc-card lc-layout-f" data-calc-root data-option="f">

        <!-- LEFT — controls -->
        <div class="lc-f-controls">

          <!-- Property type + utilization — segmented controls -->
          <div class="lc-f-zones">
            <div class="lc-f-zone">
              <div class="lc-f-zone-head">
                <span class="lc-f-zone-label">Property Type</span>
              </div>
              <div class="lc-e-seg lc-e-seg--4" role="group" aria-label="Property type" set:html={scenarioSegmentsHTML()}></div>
            </div>
            <div class="lc-f-zone">
              <div class="lc-f-zone-head">
                <span class="lc-f-zone-label">Projected Utilization</span>
              </div>
              <div class="lc-e-seg lc-e-seg--3" role="group" aria-label="Projected utilization" set:html={utilSegmentsHTML()}></div>
            </div>
          </div>

          <!-- Site inputs — tied to the scenario -->
          <div class="lc-f-inputs">
            <div class="lc-f-zone-head">
              <span class="lc-f-zone-label">Site Inputs</span>
              <span class="lc-f-zone-note">Auto-filled from your property type — fine-tune anything and the picker switches to Custom</span>
            </div>
            <div class="lc-input-row" set:html={inputFieldsHTML()}></div>
          </div>

          <!-- Financial model — segmented picker + live description card -->
          <div class="lc-f-model">
            <div class="lc-f-zone-head">
              <span class="lc-f-zone-label">Financial Model</span>
            </div>
            <div class="lc-e-seg lc-e-seg--4 lc-e-seg-model" role="group" aria-label="Financial model" set:html={modelSegmentsHTML('f')}></div>
            <div class="lc-f-model-card" data-model-card>
              <div class="lc-f-model-card-head">
                <h4 class="lc-f-model-card-title" data-model-title>No-Cost</h4>
                <span class="lc-f-model-card-badge" data-model-badge>~10% revenue share</span>
              </div>
              <p class="lc-f-model-card-blurb" data-model-blurb>
                Evium funds the capital and runs the site end to end — hardware, install,
                software, support, and the cost of every kilowatt sold. You contribute the
                location; revenue is shared, weighted in your favor.
              </p>
              <dl class="lc-f-model-spec">
                <div><dt>Capital</dt><dd data-spec-capital>Evium</dd></div>
                <div><dt>Operations</dt><dd data-spec-ops>Evium</dd></div>
                <div><dt>Revenue</dt><dd data-spec-revenue>Shared, host-favored</dd></div>
                <div><dt>Term</dt><dd data-spec-term>5 yr + 5</dd></div>
              </dl>
            </div>
          </div>

        </div>

        <!-- RIGHT — sticky live result -->
        <div class="lc-f-result">
          <div class="lc-f-out-glow" aria-hidden="true"></div>
          <p class="lc-f-out-eyebrow">
            <span class="lc-f-out-tag">Live estimate</span>
          </p>
          <p class="lc-f-out-combo" data-out="caption">—</p>
          <div class="lc-f-out-figure-block">
            <p class="lc-f-out-label">Your monthly share</p>
            <p class="lc-f-out-figure" data-out="monthly">$0</p>
          </div>
          <div class="lc-f-out-projections">
            <div class="lc-f-out-proj">
              <span class="lc-f-out-proj-num" data-out="yearly">$0</span>
              <span class="lc-f-out-proj-lbl">per year</span>
            </div>
            <div class="lc-f-out-proj">
              <span class="lc-f-out-proj-num lc-f-out-proj-num--accent" data-out="fiveyr">$0</span>
              <span class="lc-f-out-proj-lbl">over 5 years</span>
            </div>
          </div>
          <dl class="lc-f-out-breakdown">
            <div><dt>Gross monthly</dt><dd data-out="gross">$0</dd></div>
            <div><dt>Sessions / mo</dt><dd data-out="sessions">0</dd></div>
            <div><dt>Energy / mo</dt><dd><span data-out="energy">0</span>&nbsp;<span class="lc-f-out-bd-unit">kWh</span></dd></div>
            <div class="lc-f-out-breakdown-accent"><dt>Revenue share</dt><dd data-out="share">10%</dd></div>
          </dl>
          <button type="button" data-open-estimate class="lc-f-cta">
            Get a Personalized Estimate
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       OPTION O — ORIGINAL  (preserved /profits build)
       A faithful snapshot of the calculator currently
       live on /testing/profits — two-pill scenario
       picker above a two-column inputs/results card,
       with the four financial models as a full-width
       row beneath. Kept here for reference before
       Option F replaces it. Wired to the same shared
       initCalculator engine (id="" → data-input/data-out,
       name="model-o", .lc-scenario-label / .lc-model-*
       hooks added) so it behaves identically.
  ═══════════════════════════════════════════════ -->
  <section id="option-o" class="lc-option lc-option--o">
    <div class="lc-option-inner">
      <header class="lc-option-header">
        <div class="lc-option-badge">O</div>
        <div>
          <h2 class="lc-option-title">Original</h2>
          <p class="lc-option-desc">{layoutOptions[6].desc}</p>
        </div>
      </header>

      <div class="lc-layout-o" data-calc-root data-option="o">

        <!-- Scenario picker — single line, three zones -->
        <div class="profits-calc-picker mb-10 lg:mb-12">
          <div class="profits-calc-picker-line">

            <!-- LEFT — Custom pill (off-preset) -->
            <div class="profits-calc-picker-zone profits-calc-picker-zone--custom">
              <p class="profits-calc-picker-label">Off-Preset</p>
              <div class="profits-calc-picker-chips">
                <button
                  type="button"
                  class="profits-calc-scenario-btn profits-calc-scenario-btn--custom"
                  data-scenario="custom"
                >
                  <span class="profits-calc-scenario-icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </span>
                  <span class="profits-calc-scenario-label lc-scenario-label">Custom</span>
                </button>
              </div>
            </div>

            <!-- MIDDLE — Property Type -->
            <div class="profits-calc-picker-zone profits-calc-picker-zone--type">
              <p class="profits-calc-picker-label">Property Type</p>
              <div class="profits-calc-picker-chips">
                {presets.map(p => (
                  <button
                    type="button"
                    class="profits-calc-scenario-btn"
                    data-scenario={p.id}
                    data-ports={p.ports}
                    data-util-low={p.utilization.low}
                    data-util-medium={p.utilization.medium}
                    data-util-high={p.utilization.high}
                    data-kwh={p.kwh}
                    data-price={p.price}
                    data-type={p.type}
                  >
                    <span class="profits-calc-scenario-icon" aria-hidden="true">
                      {p.id === 'l2-residential' && (
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l8-4v18M13 21V11l6 2v8M9 9h.01M9 13h.01M9 17h.01M16 15h.01M16 19h.01" />
                        </svg>
                      )}
                      {p.id === 'dcfc-highway' && (
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 21l4-18M19 21l-4-18M3 9h18M3 15h18" />
                        </svg>
                      )}
                      {p.id === 'l2-fleets' && (
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2 8h11v9H2zM13 11h5l3 3v3h-8zM6 17a2 2 0 11-4 0 2 2 0 014 0zM20 17a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                      )}
                    </span>
                    <span class="profits-calc-scenario-label lc-scenario-label">{p.label}</span>
                    <span class="profits-calc-scenario-type">{p.type}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- RIGHT — Projected Utilization -->
            <div class="profits-calc-picker-zone profits-calc-picker-zone--util">
              <p class="profits-calc-picker-label">Projected Utilization</p>
              <div class="profits-calc-picker-chips">
                <button type="button" class="profits-calc-util-btn" data-utilization="low">
                  <span class="profits-calc-util-label">Low</span>
                  <span class="profits-calc-util-rate" data-util-rate>—</span>
                  <span class="profits-calc-util-mini">/ port / day</span>
                </button>
                <button type="button" class="profits-calc-util-btn" data-utilization="medium">
                  <span class="profits-calc-util-label">Medium</span>
                  <span class="profits-calc-util-rate" data-util-rate>—</span>
                  <span class="profits-calc-util-mini">/ port / day</span>
                </button>
                <button type="button" class="profits-calc-util-btn" data-utilization="high">
                  <span class="profits-calc-util-label">High</span>
                  <span class="profits-calc-util-rate" data-util-rate>—</span>
                  <span class="profits-calc-util-mini">/ port / day</span>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- Calculator Card -->
        <div class="lc-o-card relative rounded-3xl bg-gradient-to-br from-evium-dark-light to-[#1a3040] border border-white/10 overflow-hidden shadow-2xl shadow-black/40">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-evium-green/50 to-transparent"></div>
          <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-20 pointer-events-none"
               style="background: radial-gradient(circle, #2DC856 0%, transparent 70%);"></div>

          <div class="relative grid lg:grid-cols-5 gap-0">

            <!-- INPUTS -->
            <div class="lg:col-span-3 p-8 lg:p-12 lg:border-r lg:border-white/10">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-10 h-10 rounded-lg bg-evium-green/15 border border-evium-green/30 flex items-center justify-center">
                  <svg class="w-5 h-5 text-evium-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m4 10V11m4 6V4M3 21h18" />
                  </svg>
                </div>
                <div>
                  <p class="text-evium-green/70 text-xs font-bold tracking-widest uppercase">Step 1</p>
                  <h3 class="text-2xl font-black text-white">Your Inputs</h3>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="sessions" class="block text-sm font-bold text-white mb-2">Sessions Per Port / Day</label>
                  <div class="relative">
                    <input
                      id="sessions"
                      data-input="sessions"
                      type="number"
                      inputmode="decimal"
                      min="0" step="0.5"
                      value="6"
                      class="calc-input w-full bg-evium-dark border border-white/10 rounded-xl pl-4 pr-14 py-3.5 text-white text-lg font-semibold focus:outline-none focus:border-evium-green focus:ring-2 focus:ring-evium-green/20 transition-all"
                    />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-white/30 text-xs font-semibold pointer-events-none">/ day</span>
                  </div>
                  <p class="text-white/40 text-xs mt-2">Typical L2: 2–4 · DC Fast: 8–14</p>
                </div>

                <div>
                  <label for="ports" class="block text-sm font-bold text-white mb-2">Number of Ports</label>
                  <div class="relative">
                    <input
                      id="ports"
                      data-input="ports"
                      type="number"
                      inputmode="numeric"
                      min="1" step="1"
                      value="4"
                      class="calc-input w-full bg-evium-dark border border-white/10 rounded-xl pl-4 pr-14 py-3.5 text-white text-lg font-semibold focus:outline-none focus:border-evium-green focus:ring-2 focus:ring-evium-green/20 transition-all"
                    />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-white/30 text-xs font-semibold pointer-events-none">ports</span>
                  </div>
                  <p class="text-white/40 text-xs mt-2">Each charger has 1–2 ports</p>
                </div>

                <div>
                  <label for="kwh" class="block text-sm font-bold text-white mb-2">kWh Per Session</label>
                  <div class="relative">
                    <input
                      id="kwh"
                      data-input="kwh"
                      type="number"
                      inputmode="decimal"
                      min="0" step="1"
                      value="25"
                      class="calc-input w-full bg-evium-dark border border-white/10 rounded-xl pl-4 pr-14 py-3.5 text-white text-lg font-semibold focus:outline-none focus:border-evium-green focus:ring-2 focus:ring-evium-green/20 transition-all"
                    />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-white/30 text-xs font-semibold pointer-events-none">kWh</span>
                  </div>
                  <p class="text-white/40 text-xs mt-2">Typical L2: 15–25 · DC Fast: 30–50</p>
                </div>

                <div>
                  <label for="price" class="block text-sm font-bold text-white mb-2">Price Per kWh</label>
                  <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/40 text-lg font-semibold pointer-events-none">$</span>
                    <input
                      id="price"
                      data-input="price"
                      type="number"
                      inputmode="decimal"
                      min="0" step="0.01"
                      value="0.42"
                      class="calc-input w-full bg-evium-dark border border-white/10 rounded-xl pl-9 pr-16 py-3.5 text-white text-lg font-semibold focus:outline-none focus:border-evium-green focus:ring-2 focus:ring-evium-green/20 transition-all"
                    />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-white/30 text-xs font-semibold pointer-events-none">/ kWh</span>
                  </div>
                  <p class="text-white/40 text-xs mt-2">National average for public charging: $0.30–$0.55</p>
                </div>
              </div>

            </div>

            <!-- RESULTS -->
            <div class="lg:col-span-2 p-8 lg:p-12 bg-gradient-to-b from-evium-dark/40 to-evium-dark/80 lg:bg-none lg:bg-evium-dark/30">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-10 h-10 rounded-lg bg-evium-green flex items-center justify-center">
                  <svg class="w-5 h-5 text-evium-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                  </svg>
                </div>
                <div>
                  <p class="text-evium-green/70 text-xs font-bold tracking-widest uppercase">Your Estimate</p>
                  <h3 class="text-2xl font-black text-white">Revenue Potential</h3>
                </div>
              </div>

              <!-- Headline result -->
              <div class="rounded-2xl bg-evium-green/[0.07] border border-evium-green/30 p-6 mb-4 relative overflow-hidden">
                <div class="absolute inset-0 opacity-30 pointer-events-none"
                     style="background: radial-gradient(circle at 80% 20%, #2DC856 0%, transparent 60%);"></div>
                <div class="relative min-w-0">
                  <p class="text-evium-green text-xs font-bold tracking-widest uppercase mb-2">Your Monthly Share</p>
                  <p
                    data-out="monthly"
                    class="font-black text-white leading-none mb-1 tabular-nums whitespace-nowrap"
                    style="font-size: clamp(2rem, 4.6vw, 3.5rem);"
                  >$0</p>
                  <p class="text-white/40 text-xs mt-2">Based on a 30-day month</p>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="rounded-xl bg-evium-dark border border-white/10 p-4 min-w-0 overflow-hidden">
                  <p class="text-white/40 text-xs font-semibold uppercase tracking-wider mb-1">Per Year</p>
                  <p
                    data-out="yearly"
                    class="font-black text-white tabular-nums whitespace-nowrap"
                    style="font-size: clamp(1.1rem, 1.6vw, 1.5rem);"
                  >$0</p>
                </div>
                <div class="rounded-xl bg-evium-dark border border-white/10 p-4 min-w-0 overflow-hidden">
                  <p class="text-white/40 text-xs font-semibold uppercase tracking-wider mb-1">5-Year Total</p>
                  <p
                    data-out="fiveyr"
                    class="font-black text-evium-green tabular-nums whitespace-nowrap"
                    style="font-size: clamp(1.1rem, 1.6vw, 1.5rem);"
                  >$0</p>
                </div>
              </div>

              <!-- Breakdown -->
              <div class="rounded-xl bg-evium-dark/60 border border-white/5 p-5 space-y-2.5 text-sm">
                <div class="flex justify-between">
                  <span class="text-white/50">Gross monthly (all sessions)</span>
                  <span data-out="gross" class="text-white font-semibold">$0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-white/50">Sessions per month</span>
                  <span data-out="sessions" class="text-white font-semibold">0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-white/50">Energy delivered (kWh / mo)</span>
                  <span data-out="energy" class="text-white font-semibold">0</span>
                </div>
                <div class="flex justify-between pt-2.5 border-t border-white/10">
                  <span class="text-white/50">Your share</span>
                  <span data-out="share" class="text-evium-green font-bold">10%</span>
                </div>
              </div>

              <button
                type="button"
                data-open-estimate
                class="mt-6 w-full inline-flex items-center justify-center gap-2 bg-evium-green text-evium-dark font-bold text-sm px-6 py-4 rounded-xl hover:bg-white transition-colors cursor-pointer"
              >
                Get a Personalized Estimate
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Step 2 · Financial Model -->
          <div class="relative border-t border-white/10 p-8 lg:p-10">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-evium-green/15 border border-evium-green/30 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-evium-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                </svg>
              </div>
              <div>
                <p class="text-evium-green/70 text-xs font-bold tracking-widest uppercase">Step 2</p>
                <h3 class="text-2xl font-black text-white">Financial Model</h3>
              </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 lg:gap-4">
              {models.map((m, i) => (
                <label class="model-option lc-model-option cursor-pointer block">
                  <input
                    type="radio"
                    name="model-o"
                    value={m.share}
                    data-model-id={m.id}
                    checked={i === 0}
                    style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;"
                  />
                  <div class="model-card relative rounded-xl border border-white/10 bg-evium-dark p-5 transition-all hover:border-white/30 h-full">
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <p class="lc-model-label font-bold text-white text-base leading-tight">{m.label}</p>
                      <span class="model-dot w-4 h-4 rounded-full border-2 border-white/30 grid place-items-center transition-colors flex-shrink-0 mt-1">
                        <span class="dot-inner w-1.5 h-1.5 rounded-full bg-evium-dark opacity-0 transition-opacity"></span>
                      </span>
                    </div>
                    <span class="model-badge inline-block text-[0.66rem] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-evium-green/10 border border-evium-green/25 text-evium-green/80 mb-2.5">{m.badge}</span>
                    <p class="text-white/55 text-[0.82rem] leading-relaxed">{m.blurb}</p>
                  </div>
                </label>
              ))}
            </div>
          </div>
        </div><!-- /.lc-o-card -->

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SHARED ESTIMATE MODAL
  ═══════════════════════════════════════════════ -->
  <div id="lc-modal" role="dialog" aria-modal="true" aria-labelledby="lc-modal-title"
       class="lc-modal" hidden>
    <div class="lc-modal-backdrop" data-close-estimate></div>
    <div class="lc-modal-panel" id="lc-modal-panel">
      <div class="lc-modal-rail" aria-hidden="true"></div>
      <button type="button" class="lc-modal-close" data-close-estimate aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div id="lc-modal-form-view">
        <p class="lc-modal-eyebrow">Personalized Estimate</p>
        <h2 id="lc-modal-title" class="lc-modal-title">
          Get a real number for<br /><span class="lc-modal-title-accent">your property.</span>
        </h2>
        <p class="lc-modal-lead">
          We'll model real revenue using local traffic, EV registrations, and Evium deployment
          data — typically within 48 hours. No commitment.
        </p>

        <div class="lc-modal-recap">
          <p class="lc-modal-recap-label">Your Scenario</p>
          <div class="lc-modal-recap-grid">
            <div><span class="lc-modal-recap-k">Sessions / port / day</span><span class="lc-modal-recap-v" id="lc-recap-sessions">—</span></div>
            <div><span class="lc-modal-recap-k">Ports</span><span class="lc-modal-recap-v" id="lc-recap-ports">—</span></div>
            <div><span class="lc-modal-recap-k">kWh / session</span><span class="lc-modal-recap-v" id="lc-recap-kwh">—</span></div>
            <div><span class="lc-modal-recap-k">Price / kWh</span><span class="lc-modal-recap-v" id="lc-recap-price">—</span></div>
          </div>
          <div class="lc-modal-recap-foot">
            <div><span class="lc-modal-recap-k">Model</span><span class="lc-modal-recap-v" id="lc-recap-model">—</span></div>
            <div class="lc-modal-recap-foot-right"><span class="lc-modal-recap-k">Modeled monthly share</span><span class="lc-modal-recap-v lc-modal-recap-v--accent" id="lc-recap-monthly">—</span></div>
          </div>
        </div>

        <form id="lc-modal-form" class="lc-modal-form" novalidate>
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="lc-sr-only" />
          <div class="lc-modal-form-grid">
            <div>
              <label for="lc-ef-name" class="lc-modal-label">Full Name</label>
              <input id="lc-ef-name" name="name" type="text" required autocomplete="name" class="lc-modal-input" />
            </div>
            <div>
              <label for="lc-ef-email" class="lc-modal-label">Email</label>
              <input id="lc-ef-email" name="email" type="email" required autocomplete="email" class="lc-modal-input" />
            </div>
            <div>
              <label for="lc-ef-phone" class="lc-modal-label">Phone</label>
              <input id="lc-ef-phone" name="phone" type="tel" autocomplete="tel" class="lc-modal-input" />
            </div>
            <div>
              <label for="lc-ef-type" class="lc-modal-label">Property Type</label>
              <select id="lc-ef-type" name="property_type" class="lc-modal-input lc-modal-select">
                <option value="multifamily">Multifamily / Apartments</option>
                <option value="commercial">Commercial / Office</option>
                <option value="retail">Retail / Strip Center</option>
                <option value="parking">Parking Lot</option>
                <option value="fleet">Fleet</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div>
            <label for="lc-ef-address" class="lc-modal-label">Property Address</label>
            <input id="lc-ef-address" name="address" type="text" required autocomplete="street-address"
                   placeholder="123 Main St, City, State" class="lc-modal-input" />
          </div>
          <p id="lc-ef-error" class="lc-modal-error" hidden>Please complete the required fields.</p>
          <div class="lc-modal-actions">
            <button type="button" data-close-estimate class="lc-modal-cancel">Cancel</button>
            <button type="submit" id="lc-ef-submit" class="lc-modal-submit">
              <span id="lc-ef-submit-label">Send My Estimate Request</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>
          </div>
        </form>
      </div>

      <div id="lc-modal-success-view" hidden>
        <div class="lc-modal-success-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="lc-modal-title">Request received.</h2>
        <p class="lc-modal-lead">
          An Evium specialist will be in touch within <strong class="lc-modal-accent">48 hours</strong>
          with a custom revenue model for your property.
        </p>
        <button type="button" data-close-estimate class="lc-modal-submit lc-modal-submit--center">Done</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       STYLES
  ═══════════════════════════════════════════════ -->
  <!-- is:global — the scenario pills, step headers, input fields, model cards
       and result blocks are injected via set:html from frontmatter helpers, so
       they never receive Astro's data-astro-cid scoping attribute. Every rule
       below is .lc-* prefixed and unique to this page, so going global is safe. -->
  <style is:global>
    /* ════════ TOKENS / RESET ════════ */
    .lc-sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* ════════ INTRO ════════ */
    .lc-intro {
      position: relative;
      overflow: hidden;
      background: #0d1b22;
      padding: 9rem 1.5rem 5rem;
    }
    .lc-intro-bg {
      position: absolute;
      inset: 0;
      opacity: 0.045;
      background-image:
        linear-gradient(#2DC856 1px, transparent 1px),
        linear-gradient(90deg, #2DC856 1px, transparent 1px);
      background-size: 64px 64px;
      pointer-events: none;
    }
    .lc-intro-bg::after {
      content: '';
      position: absolute;
      top: -10%; left: 10%;
      width: clamp(500px, 55vw, 900px);
      height: clamp(360px, 40vw, 620px);
      border-radius: 9999px;
      opacity: 2.6;
      background: radial-gradient(ellipse at center, rgba(45,200,86,0.5) 0%, transparent 70%);
      filter: blur(12px);
    }
    .lc-intro-inner {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
    }
    .lc-intro-eyebrow {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.75);
      margin: 0 0 1.25rem;
    }
    .lc-intro-title {
      font-size: clamp(2.75rem, 6vw, 4.75rem);
      font-weight: 900;
      line-height: 0.98;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin: 0 0 1.5rem;
    }
    .lc-intro-title-accent {
      color: #2DC856;
      text-shadow: 0 2px 30px rgba(45,200,86,0.4), 0 0 64px rgba(45,200,86,0.16);
    }
    .lc-intro-sub {
      font-size: clamp(1rem, 1.3vw, 1.2rem);
      line-height: 1.6;
      color: rgba(255,255,255,0.6);
      max-width: 46rem;
      margin: 0 0 2.75rem;
    }
    .lc-jump {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.85rem;
    }
    .lc-jump-link {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 1.05rem 1.25rem;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.9rem;
      background: linear-gradient(165deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.015) 100%);
      text-decoration: none;
      transition: transform 220ms cubic-bezier(0.22,1,0.36,1), border-color 220ms ease, background 220ms ease;
    }
    .lc-jump-link:hover {
      transform: translateY(-2px);
      border-color: rgba(45,200,86,0.4);
      background: linear-gradient(165deg, rgba(45,200,86,0.09) 0%, rgba(45,200,86,0.02) 100%);
    }
    .lc-jump-tag {
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.8);
    }
    .lc-jump-name {
      font-size: 1.02rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #ffffff;
    }

    /* ════════ OPTION SECTION SHELL ════════ */
    .lc-option {
      position: relative;
      padding: 5.5rem 1.5rem;
      scroll-margin-top: 1.5rem;
    }
    .lc-option--a { background: #0d1b22; }
    .lc-option--b { background: #112430; }
    .lc-option--c { background: #0d1b22; }
    .lc-option--d { background: #112430; }
    .lc-option-inner {
      max-width: 1500px;
      margin: 0 auto;
    }
    .lc-option-header {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      margin-bottom: 2.75rem;
      max-width: 60rem;
    }
    .lc-option-badge {
      flex-shrink: 0;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 0.9rem;
      display: grid;
      place-items: center;
      font-size: 1.5rem;
      font-weight: 900;
      color: #0a1418;
      background: linear-gradient(180deg, #34d962 0%, #28b94e 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.25),
        0 8px 20px -6px rgba(45,200,86,0.5);
    }
    .lc-option-title {
      font-size: clamp(1.65rem, 2.6vw, 2.4rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #ffffff;
      margin: 0 0 0.5rem;
    }
    .lc-option-desc {
      font-size: 0.96rem;
      line-height: 1.6;
      color: rgba(255,255,255,0.55);
      margin: 0;
    }

    /* ════════ CALC CARD BASE ════════ */
    .lc-card {
      position: relative;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1.75rem;
      background: linear-gradient(165deg, #16303e 0%, #0f2531 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 30px 70px -20px rgba(0,0,0,0.6),
        0 0 90px -30px rgba(45,200,86,0.18);
      overflow: hidden;
    }
    .lc-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(45,200,86,0.55), transparent);
      pointer-events: none;
    }

    /* ════════ SHARED — GROUP LABELS ════════ */
    .lc-group-label {
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.72);
      margin: 0 0 0.7rem;
    }

    /* ════════ SHARED — STEP HEADER ════════ */
    .lc-step-header {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }
    .lc-step-icon {
      flex-shrink: 0;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.7rem;
      display: grid;
      place-items: center;
