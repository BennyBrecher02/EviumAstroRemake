      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 18px -3px rgba(45,200,86,0.25);
    }
    .lc-step-icon svg { width: 1.25rem; height: 1.25rem; }
    .lc-step-eyebrow {
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.7);
      margin: 0;
    }
    .lc-step-title {
      font-size: 1.3rem;
      font-weight: 900;
      letter-spacing: -0.015em;
      color: #ffffff;
      margin: 0.1rem 0 0;
    }

    /* ════════ SHARED — CHIPS WRAPPER ════════ */
    .lc-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }
    .lc-chips--stacked {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    /* ════════ SHARED — SCENARIO PILL ════════ */
    .lc-scenario-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.6rem 1rem 0.6rem 0.7rem;
      background: linear-gradient(165deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.015) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.85rem;
      color: rgba(255,255,255,0.78);
      font-family: inherit;
      cursor: pointer;
      text-align: left;
      transition: transform 220ms cubic-bezier(0.22,1,0.36,1), border-color 220ms ease, background 220ms ease, box-shadow 220ms ease, color 220ms ease;
    }
    .lc-scenario-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(45,200,86,0.42);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45,200,86,0.1) 0%, rgba(45,200,86,0.03) 100%);
    }
    .lc-scenario-btn.is-active {
      border-color: rgba(45,200,86,0.75);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45,200,86,0.18) 0%, rgba(45,200,86,0.06) 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.14),
        0 0 24px -5px rgba(45,200,86,0.5),
        0 6px 14px -6px rgba(45,200,86,0.3);
    }
    .lc-scenario-icon {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 0.55rem;
      background: linear-gradient(155deg, rgba(45,200,86,0.2) 0%, rgba(45,200,86,0.05) 100%);
      border: 1px solid rgba(45,200,86,0.3);
      color: #2DC856;
    }
    .lc-scenario-icon svg { width: 1rem; height: 1rem; }
    .lc-scenario-btn.is-active .lc-scenario-icon {
      background: linear-gradient(155deg, rgba(45,200,86,0.34) 0%, rgba(45,200,86,0.12) 100%);
      border-color: rgba(45,200,86,0.55);
    }
    .lc-scenario-text {
      display: flex;
      flex-direction: column;
      gap: 0.05rem;
      line-height: 1.1;
    }
    .lc-scenario-label {
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: -0.008em;
    }
    .lc-scenario-type {
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.6);
    }
    .lc-scenario-btn.is-active .lc-scenario-type { color: rgba(45,200,86,0.95); }

    /* ════════ SHARED — UTILIZATION PILL ════════ */
    .lc-util-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.08rem;
      padding: 0.55rem 1rem 0.65rem;
      background: linear-gradient(165deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.015) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.85rem;
      color: rgba(255,255,255,0.78);
      font-family: inherit;
      cursor: pointer;
      min-width: 116px;
      transition: transform 220ms cubic-bezier(0.22,1,0.36,1), border-color 220ms ease, background 220ms ease, box-shadow 220ms ease, color 220ms ease;
    }
    .lc-util-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(45,200,86,0.42);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45,200,86,0.08) 0%, rgba(45,200,86,0.02) 100%);
    }
    .lc-util-btn.is-active {
      border-color: rgba(45,200,86,0.75);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45,200,86,0.18) 0%, rgba(45,200,86,0.06) 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.14),
        0 0 24px -5px rgba(45,200,86,0.5),
        0 6px 14px -6px rgba(45,200,86,0.3);
    }
    .lc-util-label {
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1;
    }
    .lc-util-rate {
      font-size: 1.2rem;
      font-weight: 900;
      letter-spacing: -0.01em;
      color: #2DC856;
      line-height: 1.15;
      margin-top: 0.2rem;
      font-variant-numeric: tabular-nums;
    }
    .lc-util-btn.is-active .lc-util-rate { color: #ffffff; }
    .lc-util-mini {
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.4);
      line-height: 1;
    }

    /* ════════ SHARED — INPUT FIELD ════════ */
    .lc-input-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .lc-input-row--2col { grid-template-columns: repeat(2, 1fr); }
    .lc-input-row--stacked { grid-template-columns: 1fr; gap: 0.85rem; }
    .lc-input-field { min-width: 0; }
    .lc-input-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }
    .lc-input-wrap { position: relative; }
    .lc-input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.8rem 3.4rem 0.8rem 0.9rem;
      background: #0c1a22;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.7rem;
      color: #ffffff;
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      transition: border-color 200ms ease, box-shadow 200ms ease;
      -webkit-appearance: none;
      appearance: none;
    }
    .lc-input-wrap--prefixed .lc-input { padding-left: 2rem; }
    .lc-input:focus {
      outline: none;
      border-color: #2DC856;
      box-shadow: 0 0 0 3px rgba(45,200,86,0.2);
    }
    .lc-input-prefix {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.4);
      font-size: 1.05rem;
      font-weight: 700;
      pointer-events: none;
    }
    .lc-input-suffix {
      position: absolute;
      right: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.3);
      font-size: 0.72rem;
      font-weight: 700;
      pointer-events: none;
    }
    .lc-input-hint {
      font-size: 0.68rem;
      line-height: 1.4;
      color: rgba(255,255,255,0.38);
      margin: 0.5rem 0 0;
    }

    /* ════════ SHARED — MODEL CARD ════════ */
    .lc-model-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
    .lc-model-grid--2col { grid-template-columns: repeat(2, 1fr); }
    .lc-model-grid--stacked { grid-template-columns: 1fr; gap: 0.7rem; }
    .lc-model-option { cursor: pointer; display: block; }
    .lc-model-card {
      height: 100%;
      padding: 1.1rem 1.15rem 1.2rem;
      background: #0c1a22;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.85rem;
      transition: transform 240ms cubic-bezier(0.22,1,0.36,1), border-color 240ms ease, background 240ms ease, box-shadow 240ms ease;
    }
    .lc-model-option:hover .lc-model-card {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,0.28);
    }
    .lc-model-option input:checked ~ .lc-model-card {
      border-color: rgba(45,200,86,0.7);
      background: linear-gradient(165deg, rgba(45,200,86,0.1) 0%, rgba(12,26,34,0.9) 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.08),
        0 0 26px -6px rgba(45,200,86,0.34);
    }
    .lc-model-option input:focus-visible ~ .lc-model-card {
      outline: 2px solid #2DC856;
      outline-offset: 2px;
    }
    .lc-model-card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.55rem;
    }
    .lc-model-label {
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #ffffff;
      line-height: 1.2;
      margin: 0;
    }
    .lc-model-dot {
      flex-shrink: 0;
      width: 1.05rem;
      height: 1.05rem;
      margin-top: 0.1rem;
      border-radius: 9999px;
      border: 2px solid rgba(255,255,255,0.3);
      display: grid;
      place-items: center;
      transition: border-color 240ms ease, background 240ms ease;
    }
    .lc-model-dot-inner {
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 9999px;
      background: #0c1a22;
      opacity: 0;
      transition: opacity 240ms ease;
    }
    .lc-model-option input:checked ~ .lc-model-card .lc-model-dot {
      border-color: #2DC856;
      background: #2DC856;
    }
    .lc-model-option input:checked ~ .lc-model-card .lc-model-dot-inner { opacity: 1; }
    .lc-model-badge {
      display: inline-block;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.18rem 0.5rem;
      border-radius: 9999px;
      background: rgba(45,200,86,0.1);
      border: 1px solid rgba(45,200,86,0.25);
      color: rgba(45,200,86,0.82);
      margin-bottom: 0.6rem;
      transition: background 240ms ease, border-color 240ms ease, color 240ms ease;
    }
    .lc-model-option input:checked ~ .lc-model-card .lc-model-badge {
      background: rgba(45,200,86,0.22);
      border-color: rgba(45,200,86,0.5);
      color: #ffffff;
    }
    .lc-model-blurb {
      font-size: 0.76rem;
      line-height: 1.5;
      color: rgba(255,255,255,0.55);
      margin: 0;
    }

    /* ════════ SHARED — RESULT BLOCK ════════ */
    .lc-result {
      position: relative;
      z-index: 1;
    }
    .lc-result-eyebrow {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.8);
      margin: 0 0 0.6rem;
    }
    .lc-result-monthly {
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 0.95;
      color: #ffffff;
      margin: 0;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .lc-result-caption {
      font-size: 0.82rem;
      font-weight: 600;
      color: rgba(255,255,255,0.5);
      margin: 0.7rem 0 0;
      letter-spacing: 0.005em;
    }
    .lc-result-secondary {
      display: flex;
      gap: 1.5rem;
      margin-top: 1.4rem;
    }
    .lc-result-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .lc-result-stat-num {
      font-size: 1.4rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
    }
    .lc-result-stat-num--accent { color: #2DC856; }
    .lc-result-stat-lbl {
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
    }
    .lc-breakdown {
      margin-top: 1.5rem;
      padding: 1.1rem 1.25rem;
      border-radius: 0.85rem;
      background: rgba(12,26,34,0.6);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .lc-breakdown-row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.82rem;
      padding: 0.32rem 0;
    }
    .lc-breakdown-row span:first-child { color: rgba(255,255,255,0.5); }
    .lc-breakdown-row span:last-child {
      color: #ffffff;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .lc-breakdown-row--total {
      margin-top: 0.3rem;
      padding-top: 0.7rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .lc-breakdown-row--total span:last-child { color: #2DC856; }
    .lc-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      margin-top: 1.5rem;
      padding: 0.95rem 1.75rem;
      width: 100%;
      background: linear-gradient(180deg, #34d962 0%, #28b94e 100%);
      color: #0a1418;
      font-family: inherit;
      font-weight: 800;
      font-size: 0.95rem;
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.22),
        0 8px 18px -4px rgba(45,200,86,0.42),
        0 18px 40px -10px rgba(45,200,86,0.45);
      transition: transform 220ms cubic-bezier(0.22,1,0.36,1), box-shadow 220ms ease, background 220ms ease;
    }
    .lc-cta:hover {
      transform: translateY(-1px);
      background: linear-gradient(180deg, #3ce069 0%, #2cc454 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.28),
        0 10px 22px -4px rgba(45,200,86,0.55),
        0 22px 50px -10px rgba(45,200,86,0.55);
    }
    .lc-cta svg {
      width: 1rem;
      height: 1rem;
      transition: transform 220ms cubic-bezier(0.22,1,0.36,1);
    }
    .lc-cta:hover svg { transform: translateX(4px); }

    /* ════════════════════════════════════════════════════
       LAYOUT A — RESULT-FIRST HERO
       ════════════════════════════════════════════════════ */
    .lc-layout-a { padding: 0; }
    .lc-a-result {
      position: relative;
      padding: 3.5rem 3rem 3rem;
      text-align: center;
      overflow: hidden;
    }
    .lc-a-result-glow {
      position: absolute;
      top: -40%; left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: 200%;
      border-radius: 9999px;
      opacity: 0.16;
      background: radial-gradient(ellipse at center, rgba(45,200,86,0.6) 0%, transparent 65%);
      filter: blur(20px);
      pointer-events: none;
    }
    .lc-layout-a .lc-result--hero .lc-result-monthly {
      font-size: clamp(3.5rem, 8vw, 6.5rem);
      margin-top: 0.2rem;
    }
    .lc-layout-a .lc-result--hero .lc-result-caption { font-size: 0.92rem; }
    .lc-layout-a .lc-result--hero .lc-result-secondary {
      justify-content: center;
      margin-top: 1.6rem;
    }
    .lc-layout-a .lc-result--hero .lc-result-stat { align-items: center; }
    .lc-layout-a .lc-result--hero .lc-breakdown {
      display: none; /* breakdown moves to its own step row at the bottom */
    }
    .lc-layout-a .lc-result--hero .lc-cta {
      width: auto;
      margin-top: 1.8rem;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
    .lc-a-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
    }
    .lc-a-controls {
      padding: 2.75rem 3rem 3rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }
    .lc-a-step {}
    .lc-scenario-zones {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem 2.5rem;
      align-items: flex-start;
    }
    .lc-scenario-zone--type { flex: 1 1 auto; }

    /* ════════════════════════════════════════════════════
       LAYOUT B — EDITORIAL 2-ZONE
       ════════════════════════════════════════════════════ */
    .lc-layout-b {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
    }
    .lc-b-controls {
      padding: 2.75rem 2.75rem 3rem;
      display: flex;
      flex-direction: column;
    }
    .lc-b-step {}
    .lc-b-scenario {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }
    .lc-b-divider {
      height: 1px;
      margin: 1.85rem 0;
      background: linear-gradient(90deg, rgba(255,255,255,0.12), transparent);
    }
    .lc-b-result {
      position: relative;
      padding: 3rem 2.75rem;
      background: linear-gradient(170deg, rgba(45,200,86,0.1) 0%, rgba(12,26,34,0.55) 60%, rgba(12,26,34,0.4) 100%);
      border-left: 1px solid rgba(255,255,255,0.08);
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }
    .lc-b-result-glow {
      position: absolute;
      top: -20%; right: -30%;
      width: 90%;
      height: 90%;
      border-radius: 9999px;
      opacity: 0.2;
      background: radial-gradient(circle, rgba(45,200,86,0.55) 0%, transparent 65%);
      filter: blur(10px);
      pointer-events: none;
    }
    .lc-layout-b .lc-result--panel .lc-result-monthly {
      font-size: clamp(2.75rem, 4.5vw, 4.25rem);
      margin-top: 0.15rem;
    }

    /* ════════════════════════════════════════════════════
       LAYOUT C — STAGE FLOW
       ════════════════════════════════════════════════════ */
    .lc-layout-c {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1.05fr;
      align-items: stretch;
    }
    .lc-c-stage {
      position: relative;
      padding: 2.5rem 1.75rem;
      display: flex;
      flex-direction: column;
    }
    .lc-c-stage-num {
      position: absolute;
      top: 1.3rem;
      right: 1.3rem;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 9999px;
      display: grid;
      place-items: center;
      font-size: 0.82rem;
      font-weight: 900;
      color: rgba(255,255,255,0.4);
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.03);
    }
    .lc-c-stage-num--result {
      color: #0a1418;
      background: linear-gradient(180deg, #34d962 0%, #28b94e 100%);
      border-color: transparent;
      box-shadow: 0 0 18px -2px rgba(45,200,86,0.5);
    }
    .lc-c-stage-body { margin-top: 0.4rem; display: flex; flex-direction: column; gap: 1.3rem; }
    .lc-c-connector {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      color: rgba(45,200,86,0.4);
    }
    .lc-c-connector svg { width: 1.25rem; height: 1.25rem; }
    .lc-c-connector--final { color: rgba(45,200,86,0.7); }
    .lc-c-stage--result {
      background: linear-gradient(170deg, rgba(45,200,86,0.1) 0%, rgba(12,26,34,0.5) 70%);
      border-left: 1px solid rgba(255,255,255,0.08);
      overflow: hidden;
      justify-content: center;
    }
    .lc-c-result-glow {
      position: absolute;
      top: 10%; right: -40%;
      width: 110%;
      height: 80%;
      border-radius: 9999px;
      opacity: 0.18;
      background: radial-gradient(circle, rgba(45,200,86,0.5) 0%, transparent 65%);
      filter: blur(12px);
      pointer-events: none;
    }
    .lc-layout-c .lc-result--stage .lc-result-monthly {
      font-size: clamp(2.4rem, 3.4vw, 3.4rem);
      margin-top: 0.15rem;
    }
    .lc-layout-c .lc-result--stage .lc-result-secondary {
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 1.2rem;
    }
    .lc-layout-c .lc-result--stage .lc-breakdown { display: none; }
    .lc-layout-c .lc-c-stage-num { /* keep ordinal visible above content */ }
    /* slimmer model/input/pill density inside the narrow stage columns */
    .lc-layout-c .lc-scenario-btn { padding: 0.5rem 0.75rem 0.5rem 0.55rem; }
    .lc-layout-c .lc-util-btn { min-width: 0; width: 100%; }

    /* ════════════════════════════════════════════════════
       LAYOUT D — FLOATING RESULT BAND
       ════════════════════════════════════════════════════ */
    .lc-layout-d {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .lc-d-band {
      position: relative;
      border: 1px solid rgba(45,200,86,0.25);
      border-radius: 1.5rem;
      background: linear-gradient(150deg, rgba(45,200,86,0.14) 0%, #12303d 45%, #0f2531 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.06),
        0 26px 60px -18px rgba(0,0,0,0.55),
        0 0 90px -24px rgba(45,200,86,0.32);
      padding: 2.75rem 3rem;
      overflow: hidden;
    }
    .lc-d-band-glow {
      position: absolute;
      top: -60%; left: 8%;
      width: 50%;
      height: 240%;
      border-radius: 9999px;
      opacity: 0.22;
      background: radial-gradient(ellipse at center, rgba(45,200,86,0.6) 0%, transparent 62%);
      filter: blur(16px);
      pointer-events: none;
    }
    .lc-layout-d .lc-result--band {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }
    .lc-layout-d .lc-result--band .lc-result-eyebrow,
    .lc-layout-d .lc-result--band .lc-result-monthly,
    .lc-layout-d .lc-result--band .lc-result-caption {
      grid-column: 1;
    }
    .lc-layout-d .lc-result--band .lc-result-monthly {
      font-size: clamp(3rem, 6vw, 5.25rem);
      margin-top: 0.15rem;
    }
    .lc-layout-d .lc-result--band .lc-result-caption { font-size: 0.9rem; }
    .lc-layout-d .lc-result--band .lc-result-secondary {
      grid-column: 2;
      grid-row: 1 / span 3;
      flex-direction: column;
      gap: 1rem;
      margin-top: 0;
      padding-left: 2.5rem;
      border-left: 1px solid rgba(255,255,255,0.12);
    }
    .lc-layout-d .lc-result--band .lc-result-stat-num { font-size: 1.85rem; }
    .lc-layout-d .lc-result--band .lc-breakdown {
      grid-column: 1 / -1;
      margin-top: 0.5rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      padding: 1.1rem 0 0;
      background: transparent;
      border: none;
      border-top: 1px solid rgba(255,255,255,0.1);
      border-radius: 0;
    }
    .lc-layout-d .lc-result--band .lc-breakdown-row {
      flex-direction: column;
      gap: 0.25rem;
      padding: 0 1.25rem;
      border-right: 1px solid rgba(255,255,255,0.08);
    }
    .lc-layout-d .lc-result--band .lc-breakdown-row:first-child { padding-left: 0; }
    .lc-layout-d .lc-result--band .lc-breakdown-row:last-child { border-right: none; }
    .lc-layout-d .lc-result--band .lc-breakdown-row--total { margin-top: 0; padding-top: 0; border-top: none; }
    .lc-layout-d .lc-result--band .lc-breakdown-row span:first-child {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .lc-layout-d .lc-result--band .lc-breakdown-row span:last-child { font-size: 1.05rem; }
    .lc-layout-d .lc-result--band .lc-cta {
      grid-column: 2;
      width: auto;
      margin-top: 0;
      align-self: end;
    }
    .lc-d-controls {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .lc-d-control-col {
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1.5rem;
      background: linear-gradient(165deg, #16303e 0%, #0f2531 100%);
      padding: 2rem 1.85rem 2.25rem;
      box-shadow: 0 20px 50px -20px rgba(0,0,0,0.5);
    }
    .lc-d-control-body { display: flex; flex-direction: column; gap: 1.4rem; }

    /* ════════════════════════════════════════════════════
       MODAL
       ════════════════════════════════════════════════════ */
    .lc-modal {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .lc-modal[hidden] { display: none; }
    .lc-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(4,10,14,0.78);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      animation: lc-modal-fade 200ms ease forwards;
    }
    @keyframes lc-modal-fade { from { opacity: 0; } to { opacity: 1; } }
    .lc-modal-panel {
      position: relative;
      width: 100%;
      max-width: 38rem;
      max-height: 92vh;
      overflow-y: auto;
      background: linear-gradient(165deg, #16303e 0%, #0f2531 100%);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1.5rem;
      padding: 2.5rem;
      box-shadow: 0 40px 90px -20px rgba(0,0,0,0.7);
      animation: lc-modal-rise 240ms cubic-bezier(0.22,1,0.36,1) forwards;
    }
    @keyframes lc-modal-rise {
      from { opacity: 0; transform: translateY(16px) scale(0.98); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .lc-modal-rail {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(45,200,86,0.6), transparent);
    }
    .lc-modal-close {
      position: absolute;
      top: 1.1rem; right: 1.1rem;
      width: 2.1rem; height: 2.1rem;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      transition: color 200ms ease, background 200ms ease, border-color 200ms ease;
    }
    .lc-modal-close:hover {
      color: #ffffff;
      background: rgba(255,255,255,0.1);
      border-color: rgba(255,255,255,0.3);
    }
    .lc-modal-close svg { width: 0.95rem; height: 0.95rem; }
    .lc-modal-eyebrow {
      display: inline-block;
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.85);
      padding: 0.3rem 0.7rem;
      border-radius: 9999px;
      background: rgba(45,200,86,0.1);
      border: 1px solid rgba(45,200,86,0.3);
      margin: 0 0 1.1rem;
    }
    .lc-modal-title {
      font-size: clamp(1.7rem, 3vw, 2.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #ffffff;
      margin: 0 0 0.85rem;
    }
    .lc-modal-title-accent { color: #2DC856; }
    .lc-modal-lead {
      font-size: 0.92rem;
      line-height: 1.6;
      color: rgba(255,255,255,0.58);
      margin: 0 0 1.6rem;
    }
    .lc-modal-accent { color: #2DC856; }
    .lc-modal-recap {
      padding: 1.25rem;
      border-radius: 0.85rem;
      background: #0c1a22;
      border: 1px solid rgba(255,255,255,0.08);
      margin-bottom: 1.6rem;
    }
    .lc-modal-recap-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(45,200,86,0.7);
      margin: 0 0 0.85rem;
    }
    .lc-modal-recap-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
    }
    @media (min-width: 540px) {
      .lc-modal-recap-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .lc-modal-recap-k {
      display: block;
      font-size: 0.62rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
    }
    .lc-modal-recap-v {
      display: block;
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
      margin-top: 0.15rem;
    }
    .lc-modal-recap-v--accent { color: #2DC856; }
    .lc-modal-recap-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .lc-modal-recap-foot-right { text-align: right; }
    .lc-modal-form { display: flex; flex-direction: column; gap: 1.1rem; }
    .lc-modal-form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    @media (min-width: 540px) {
      .lc-modal-form-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .lc-modal-label {
      display: block;
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
      margin-bottom: 0.45rem;
    }
    .lc-modal-input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.7rem 0.9rem;
      background: #0c1a22;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.6rem;
      color: #ffffff;
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 500;
      transition: border-color 200ms ease, box-shadow 200ms ease;
    }
    .lc-modal-input:focus {
      outline: none;
      border-color: #2DC856;
      box-shadow: 0 0 0 3px rgba(45,200,86,0.2);
    }
    .lc-modal-select { appearance: none; -webkit-appearance: none; }
    .lc-modal-error { font-size: 0.78rem; color: #f87171; font-weight: 600; margin: 0; }
    .lc-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      padding-top: 0.3rem;
    }
    .lc-modal-cancel {
      padding: 0.7rem 1.3rem;
      background: none;
      border: none;
      color: rgba(255,255,255,0.6);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      transition: color 200ms ease;
    }
    .lc-modal-cancel:hover { color: #ffffff; }
    .lc-modal-submit {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      background: linear-gradient(180deg, #34d962 0%, #28b94e 100%);
      color: #0a1418;
      font-family: inherit;
      font-weight: 800;
      font-size: 0.86rem;
      border: none;
      border-radius: 0.6rem;
      cursor: pointer;
      box-shadow: 0 8px 18px -6px rgba(45,200,86,0.5);
      transition: transform 200ms ease, box-shadow 200ms ease;
    }
    .lc-modal-submit:hover { transform: translateY(-1px); }
    .lc-modal-submit svg { width: 0.95rem; height: 0.95rem; }
    .lc-modal-submit--center { margin: 1.5rem auto 0; }
    .lc-modal-success-icon {
      width: 4rem; height: 4rem;
      margin: 0 auto 1.5rem;
      border-radius: 9999px;
      display: grid;
      place-items: center;
      background: rgba(45,200,86,0.15);
      border: 1px solid rgba(45,200,86,0.4);
      color: #2DC856;
    }
    .lc-modal-success-icon svg { width: 2rem; height: 2rem; }
    #lc-modal-success-view { text-align: center; }

    /* ════════════════════════════════════════════════════
       OPTION E — SHOWROOM CONSOLE
       The one light-surfaced layout. Segmented controls
       (sliding thumb driven by a data-thumb index attribute),
       labelled zones, full-width outcome panel. Inspired by
       the highway-v3 "Economics" dashboard.
       ════════════════════════════════════════════════════ */
    .lc-option--e { background: #0d1b22; }

    /* Light "showroom" card — overrides the dark .lc-card base. */
    .lc-layout-e {
      background: linear-gradient(180deg, #f4f7fb 0%, #eef2f7 55%, #e7edf4 100%);
      border-color: rgba(13,27,34,0.10);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.9),
        0 44px 90px -52px rgba(0,0,0,0.65),
        0 10px 34px -18px rgba(0,0,0,0.45);
      color: #0d1b22;
      overflow: hidden;
    }
    .lc-e-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .lc-e-bg::before,
    .lc-e-bg::after {
      content: "";
      position: absolute;
    }
    .lc-e-bg::before {
      top: -12%;
      right: -6%;
      width: 52%;
      height: 60%;
      background: radial-gradient(ellipse at top right, rgba(45,200,86,0.12) 0%, transparent 64%);
    }
    .lc-e-bg::after {
      bottom: -14%;
      left: -8%;
      width: 48%;
      height: 55%;
      background: radial-gradient(ellipse at bottom left, rgba(26,47,58,0.07) 0%, transparent 70%);
    }
    .lc-e-frame {
      position: relative;
      z-index: 1;
      padding: clamp(1.6rem, 3vw, 2.85rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.15rem, 2vw, 1.8rem);
    }

    /* ── Zones ── */
    .lc-e-zones {
      display: grid;
      grid-template-columns: minmax(0,1.42fr) minmax(0,1fr);
      gap: clamp(0.95rem, 1.8vw, 1.5rem);
    }
    .lc-e-zone {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      min-width: 0;
    }
    .lc-e-zone-head {
      display: flex;
      flex-direction: column;
      gap: 0.12rem;
    }
    .lc-e-zone-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(13,27,34,0.55);
    }
    .lc-e-zone-hint {
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.35;
      color: rgba(13,27,34,0.5);
    }

    /* ── Segmented control — shared by all three pickers ── */
    .lc-e-seg {
      position: relative;
      display: grid;
      gap: 4px;
      padding: 5px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid rgba(13,27,34,0.08);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.9) inset,
        0 1px 2px rgba(13,27,34,0.04),
        0 14px 30px -18px rgba(13,27,34,0.22);
    }
    .lc-e-seg--4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
    .lc-e-seg--3 { grid-template-columns: repeat(3, minmax(0,1fr)); }

    .lc-e-thumb {
      position: absolute;
      top: 5px;
      bottom: 5px;
      left: 5px;
      z-index: 0;
      border-radius: 999px;
      background: linear-gradient(180deg, #2DC856 0%, #25b349 100%);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.35) inset,
        0 6px 16px -6px rgba(45,200,86,0.55),
        0 2px 4px rgba(13,27,34,0.12);
      transition: transform 420ms cubic-bezier(0.22,1,0.36,1), opacity 240ms ease;
      will-change: transform;
      pointer-events: none;
    }
    .lc-e-seg--4 .lc-e-thumb { width: calc((100% - 22px) / 4); }
    .lc-e-seg--3 .lc-e-thumb { width: calc((100% - 18px) / 3); }

    /* Thumb position + width are written inline by the Option E
       enhancement script — it measures the active segment and
       sets thumb.style.{width,transform,opacity} directly, so the
       base `transition: transform` animates the slide. (Driving
       the thumb from a state attribute via descendant CSS rules
       proved unreliable in this environment; measuring the live
       layout and setting inline styles is bulletproof.) The CSS
       width below is just the pre-script fallback. */

    /* Segment buttons (scenario + utilization). */
    .lc-e-seg-btn {
      position: relative;
      z-index: 1;
      appearance: none;
      -webkit-appearance: none;
      background: transparent;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1px;
      padding: 0.52rem 0.4rem;
      border-radius: 999px;
      min-width: 0;
      color: rgba(13,27,34,0.62);
      transition: color 220ms ease;
    }
    .lc-e-seg-btn:hover:not(.is-active) { color: #1A2F3A; }
    .lc-e-seg-btn.is-active { color: #ffffff; }
    .lc-e-seg-btn:focus-visible { outline: 2px solid #2DC856; outline-offset: 3px; }
    .lc-e-seg-name {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: -0.005em;
      line-height: 1.1;
      white-space: nowrap;
      text-transform: capitalize;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lc-e-seg-sub {
      font-size: 0.6rem;
      font-weight: 600;
      line-height: 1.1;
      white-space: nowrap;
      color: rgba(13,27,34,0.46);
      transition: color 220ms ease;
    }
    .lc-e-seg-sub [data-util-rate] { font-weight: 800; }
    .lc-e-seg-btn.is-active .lc-e-seg-sub { color: rgba(255,255,255,0.82); }

    /* Model segment items (radio-backed labels). */
    .lc-layout-e .lc-model-option { display: block; }
    .lc-e-seg-model-item {
      position: relative;
      z-index: 1;
      cursor: pointer;
    }
    .lc-e-seg-model-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 0.52rem 0.4rem;
      border-radius: 999px;
      min-width: 0;
      color: rgba(13,27,34,0.62);
      transition: color 220ms ease;
    }
    .lc-e-seg-model-item:hover .lc-e-seg-model-card { color: #1A2F3A; }
    .lc-e-seg-model-item input:checked ~ .lc-e-seg-model-card { color: #ffffff; }
    .lc-e-seg-model-item input:focus-visible ~ .lc-e-seg-model-card {
      outline: 2px solid #2DC856;
      outline-offset: 3px;
    }
    .lc-layout-e .lc-model-label {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: -0.005em;
      color: inherit;
      margin: 0;
    }
    .lc-e-seg-model-badge {
      font-size: 0.575rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.01em;
      color: rgba(13,27,34,0.46);
      transition: color 220ms ease;
    }
    .lc-e-seg-model-item input:checked ~ .lc-e-seg-model-card .lc-e-seg-model-badge {
      color: rgba(255,255,255,0.82);
    }

    /* ── Site inputs — light-themed overrides of the shared
         input fields (default styling is built for dark cards). ── */
    .lc-layout-e .lc-input-label { color: #1A2F3A; }
    .lc-layout-e .lc-input {
      background: #ffffff;
      border-color: rgba(13,27,34,0.13);
      color: #0d1b22;
    }
    .lc-layout-e .lc-input:focus {
      border-color: #2DC856;
      box-shadow: 0 0 0 3px rgba(45,200,86,0.18);
    }
    .lc-layout-e .lc-input-prefix { color: rgba(13,27,34,0.5); }
    .lc-layout-e .lc-input-suffix { color: rgba(13,27,34,0.42); }
    .lc-layout-e .lc-input-hint { color: rgba(13,27,34,0.5); }

    /* ── Outcome panel ── */
    .lc-e-outcome {
      position: relative;
      overflow: hidden;
      padding: clamp(1.4rem, 2.4vw, 2.15rem);
      border-radius: 1.2rem;
      background:
        linear-gradient(180deg, rgba(45,200,86,0.07) 0%, rgba(45,200,86,0.02) 45%, #ffffff 100%),
        #ffffff;
      border: 1px solid rgba(45,200,86,0.30);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.9) inset,
        0 30px 60px -34px rgba(45,200,86,0.30),
        0 6px 16px -8px rgba(13,27,34,0.12);
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 1.6vw, 1.45rem);
    }
    .lc-e-out-glow {
      position: absolute;
      top: -45%;
      right: -8%;
      width: 48%;
      height: 130%;
      pointer-events: none;
      background: radial-gradient(ellipse, rgba(45,200,86,0.16) 0%, transparent 70%);
    }
    .lc-e-out-eyebrow {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.7rem;
      margin: 0;
    }
    .lc-e-out-tag {
      font-size: 0.56rem;
      font-weight: 800;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      padding: 0.3rem 0.72rem;
      border-radius: 999px;
      background: #1A2F3A;
      color: #ffffff;
    }
    .lc-e-out-combo {
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      color: rgba(13,27,34,0.7);
    }
    .lc-e-out-main {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
      align-items: center;
      gap: clamp(0.9rem, 2vw, 1.7rem);
    }
    .lc-e-out-label {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: rgba(13,27,34,0.5);
      margin: 0 0 0.4rem;
    }
    .lc-e-out-primary {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.3rem 0.45rem;
    }
    .lc-e-out-figure {
      font-size: clamp(2.35rem, 5vw, 3.55rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 1;
      color: #0d1b22;
      font-variant-numeric: tabular-nums;
    }
    .lc-e-out-unit {
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(13,27,34,0.55);
      flex-basis: 100%;
    }
    .lc-e-out-arrow {
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      background: rgba(45,200,86,0.12);
      color: #2DC856;
      flex-shrink: 0;
    }
    .lc-e-out-arrow svg { width: 1.2rem; height: 0.6rem; }
    .lc-e-out-projections {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .lc-e-out-proj {
      display: flex;
      flex-direction: column;
      gap: 0.12rem;
    }
    .lc-e-out-proj-num {
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #1A2F3A;
      font-variant-numeric: tabular-nums;
    }
    .lc-e-out-proj-num--accent { color: #2DC856; }
    .lc-e-out-proj-lbl {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(13,27,34,0.45);
    }
    .lc-e-out-breakdown {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 1px;
      margin: 0;
      background: rgba(13,27,34,0.09);
      border: 1px solid rgba(13,27,34,0.08);
      border-radius: 0.8rem;
      overflow: hidden;
    }
    .lc-e-out-breakdown > div {
      background: linear-gradient(180deg, #ffffff 0%, #fafbfd 100%);
      padding: 0.72rem 0.85rem 0.78rem;
      display: flex;
      flex-direction: column;
      gap: 0.32rem;
      min-width: 0;
    }
    .lc-e-out-breakdown dt {
      font-size: 0.54rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(13,27,34,0.46);
      line-height: 1.25;
    }
    .lc-e-out-breakdown dd {
      margin: 0;
      font-size: 0.98rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #0d1b22;
      font-variant-numeric: tabular-nums;
    }
    .lc-e-out-breakdown-accent {
      background: linear-gradient(180deg, rgba(45,200,86,0.12) 0%, rgba(45,200,86,0.05) 100%) !important;
    }
    .lc-e-out-breakdown-accent dd { color: #1f9c44; }
    .lc-e-out-bd-unit {
      font-size: 0.72rem;
      font-weight: 700;
      color: rgba(13,27,34,0.5);
    }
    .lc-e-cta {
      position: relative;
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.95rem 1.85rem;
      border: 0;
      border-radius: 0.85rem;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #06210f;
      background: linear-gradient(180deg, #2DC856 0%, #25b349 100%);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.4) inset,
        0 14px 30px -12px rgba(45,200,86,0.6),
        0 4px 10px -4px rgba(13,27,34,0.2);
      transition: transform 200ms ease, box-shadow 200ms ease;
    }
    .lc-e-cta:hover {
      transform: translateY(-2px);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.4) inset,
        0 20px 40px -12px rgba(45,200,86,0.7),
        0 6px 14px -4px rgba(13,27,34,0.25);
    }
    .lc-e-cta:focus-visible { outline: 2px solid #1A2F3A; outline-offset: 3px; }
    .lc-e-cta svg {
      width: 1rem;
      height: 1rem;
      transition: transform 200ms ease;
    }
    .lc-e-cta:hover svg { transform: translateX(3px); }

    /* Option E responsive. */
    @media (max-width: 1100px) {
      .lc-e-zones { grid-template-columns: 1fr; }
      .lc-e-out-main { grid-template-columns: 1fr; text-align: center; }
      .lc-e-out-primary { justify-content: center; }
      .lc-e-out-arrow { transform: rotate(90deg); margin: 0 auto; }
      .lc-e-out-projections { flex-direction: row; justify-content: center; gap: 1.6rem; }
    }
    @media (max-width: 720px) {
      .lc-e-out-breakdown { grid-template-columns: repeat(2, 1fr); }
      .lc-e-seg-name { font-size: 0.74rem; }
      .lc-e-seg-model-badge { font-size: 0.52rem; }
    }
    @media (max-width: 460px) {
      .lc-e-out-breakdown { grid-template-columns: 1fr; }
      .lc-e-seg-sub { display: none; }
      .lc-e-seg-btn,
      .lc-e-seg-model-card { padding: 0.6rem 0.3rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lc-e-thumb,
      .lc-e-seg-btn,
      .lc-e-seg-model-card,
      .lc-e-cta,
      .lc-e-cta svg { transition: none; }
    }

    /* ════════════════════════════════════════════════════
       OPTION F — LIVE CONSOLE  (the synthesis)
       Two-column shell: controls left, a sticky result panel
       right so the number stays live while you configure.
       Reuses E's segmented controls (re-themed dark here) and
       adds a live, self-rewriting model description card.
       ════════════════════════════════════════════════════ */
    .lc-option--f { background: #112430; }

    /* Shell — controls + sticky result. Dark .lc-card base is
       inherited; no surface override needed. */
    .lc-layout-f {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 384px;
      align-items: start;
    }
    .lc-f-controls {
      padding: clamp(1.75rem, 3vw, 2.85rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.5rem, 2.4vw, 2.1rem);
      min-width: 0;
    }
    /* Sticky result panel — its own surface, floats on the card. */
    .lc-f-result {
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin: clamp(1.5rem, 2.4vw, 2.25rem);
      overflow: hidden;
      padding: clamp(1.4rem, 2vw, 1.85rem);
      border-radius: 1.25rem;
      background: linear-gradient(170deg, #163443 0%, #0e2531 100%);
      border: 1px solid rgba(45,200,86,0.26);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 28px 56px -32px rgba(45,200,86,0.32),
        0 8px 22px -12px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Zone heads. */
    .lc-f-zones {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: clamp(0.9rem, 1.8vw, 1.4rem);
    }
    .lc-f-zone,
    .lc-f-inputs,
    .lc-f-model {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      min-width: 0;
    }
    .lc-f-zone-head {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .lc-f-zone-label {
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
    }
    .lc-f-zone-note {
      font-size: 0.74rem;
      font-weight: 500;
      line-height: 1.4;
      color: rgba(255,255,255,0.42);
    }

    /* Dark re-theme for the shared (E-built) segmented controls. */
    .lc-layout-f .lc-e-seg {
      background: rgba(255,255,255,0.045);
      border-color: rgba(255,255,255,0.1);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.04),
        0 2px 8px -4px rgba(0,0,0,0.55);
    }
    .lc-layout-f .lc-e-seg-btn { color: rgba(255,255,255,0.58); }
    .lc-layout-f .lc-e-seg-btn:hover:not(.is-active) { color: rgba(255,255,255,0.9); }
    .lc-layout-f .lc-e-seg-sub { color: rgba(255,255,255,0.4); }
    .lc-layout-f .lc-e-seg-model-card { color: rgba(255,255,255,0.58); }
    .lc-layout-f .lc-e-seg-model-item:hover .lc-e-seg-model-card { color: rgba(255,255,255,0.9); }
    .lc-layout-f .lc-e-seg-model-badge { color: rgba(255,255,255,0.4); }
    .lc-layout-f .lc-model-label { color: inherit; }

    /* Live model description card — rewrites itself per model. */
    .lc-f-model-card {
      margin-top: 0.15rem;
      padding: clamp(1rem, 1.6vw, 1.35rem);
      border-radius: 1rem;
      background: linear-gradient(165deg, rgba(45,200,86,0.08) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(45,200,86,0.2);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: opacity 160ms ease;
    }
    .lc-f-model-card.is-swapping { opacity: 0; }
    .lc-f-model-card-head {
      display: flex;
      align-items: center;
      gap: 0.6rem 0.7rem;
      flex-wrap: wrap;
    }
    .lc-f-model-card-title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.012em;
      color: #ffffff;
    }
    .lc-f-model-card-badge {
      font-size: 0.55rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.28rem 0.6rem;
      border-radius: 999px;
      background: rgba(45,200,86,0.14);
      color: #58e07f;
      border: 1px solid rgba(45,200,86,0.3);
      white-space: nowrap;
    }
    .lc-f-model-card-blurb {
      margin: 0;
      font-size: 0.84rem;
      line-height: 1.55;
      color: rgba(255,255,255,0.62);
    }
    .lc-f-model-spec {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 1px;
      margin: 0;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.7rem;
      overflow: hidden;
    }
    .lc-f-model-spec > div {
      background: #122a37;
      padding: 0.62rem 0.7rem 0.66rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
    }
    .lc-f-model-spec dt {
      font-size: 0.5rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.42);
      line-height: 1.2;
    }
    .lc-f-model-spec dd {
      margin: 0;
      font-size: 0.76rem;
      font-weight: 700;
      line-height: 1.3;
      color: #ffffff;
      letter-spacing: -0.005em;
    }

    /* Result panel internals. */
    .lc-f-out-glow {
      position: absolute;
      top: -32%;
      right: -22%;
      width: 72%;
      height: 82%;
      pointer-events: none;
      background: radial-gradient(ellipse, rgba(45,200,86,0.2) 0%, transparent 70%);
    }
    .lc-f-out-eyebrow {
      position: relative;
      margin: 0;
    }
    .lc-f-out-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      font-size: 0.54rem;
      font-weight: 800;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      padding: 0.32rem 0.7rem;
      border-radius: 999px;
      background: rgba(45,200,86,0.15);
      color: #58e07f;
      border: 1px solid rgba(45,200,86,0.32);
    }
    .lc-f-out-tag::before {
      content: "";
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: #2DC856;
      box-shadow: 0 0 8px #2DC856;
      animation: lc-f-pulse 2.4s ease-in-out infinite;
    }
    @keyframes lc-f-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    .lc-f-out-combo {
      position: relative;
      margin: 0;
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.4;
      color: rgba(255,255,255,0.6);
    }
    .lc-f-out-figure-block {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .lc-f-out-label {
      margin: 0;
      font-size: 0.56rem;
      font-weight: 800;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }
    .lc-f-out-figure {
      margin: 0;
      font-size: clamp(2.6rem, 4vw, 3.4rem);
      font-weight: 900;
      letter-spacing: -0.032em;
      line-height: 1;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
    }
    .lc-f-out-projections {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .lc-f-out-proj {
      display: flex;
      flex-direction: column;
      gap: 0.18rem;
      padding: 0.7rem 0.8rem;
      border-radius: 0.7rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
    }
    .lc-f-out-proj-num {
      font-size: 1.15rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
    }
    .lc-f-out-proj-num--accent { color: #2DC856; }
    .lc-f-out-proj-lbl {
      font-size: 0.56rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.42);
    }
    .lc-f-out-breakdown {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      margin: 0;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.7rem;
      overflow: hidden;
    }
    .lc-f-out-breakdown > div {
      background: rgba(255,255,255,0.025);
      padding: 0.6rem 0.75rem 0.64rem;
      display: flex;
      flex-direction: column;
      gap: 0.26rem;
      min-width: 0;
    }
    .lc-f-out-breakdown dt {
      font-size: 0.5rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.42);
      line-height: 1.2;
    }
    .lc-f-out-breakdown dd {
      margin: 0;
      font-size: 0.84rem;
      font-weight: 800;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
    }
    .lc-f-out-breakdown-accent { background: linear-gradient(180deg, rgba(45,200,86,0.12) 0%, rgba(45,200,86,0.04) 100%) !important; }
    .lc-f-out-breakdown-accent dd { color: #2DC856; }
    .lc-f-out-bd-unit {
      font-size: 0.62rem;
      font-weight: 700;
      color: rgba(255,255,255,0.45);
    }
    .lc-f-cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.95rem 1.4rem;
      border: 0;
      border-radius: 0.8rem;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #06210f;
      background: linear-gradient(180deg, #2DC856 0%, #25b349 100%);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.3) inset,
        0 14px 30px -12px rgba(45,200,86,0.6),
        0 4px 10px -4px rgba(0,0,0,0.35);
      transition: transform 200ms ease, box-shadow 200ms ease;
    }
    .lc-f-cta:hover {
      transform: translateY(-2px);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.3) inset,
        0 20px 40px -12px rgba(45,200,86,0.72),
        0 6px 14px -4px rgba(0,0,0,0.4);
    }
    .lc-f-cta:focus-visible { outline: 2px solid #ffffff; outline-offset: 3px; }
    .lc-f-cta svg {
      width: 1rem;
      height: 1rem;
      transition: transform 200ms ease;
    }
    .lc-f-cta:hover svg { transform: translateX(3px); }

    /* Option F responsive. */
    @media (max-width: 1100px) {
      .lc-layout-f { grid-template-columns: 1fr; }
      .lc-f-result {
        position: static;
        margin-top: 0;
        border-top: 1px solid rgba(45,200,86,0.22);
      }
    }
    @media (max-width: 720px) {
      .lc-f-zones { grid-template-columns: 1fr; }
      .lc-f-model-spec { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 460px) {
      .lc-layout-f .lc-e-seg-sub { display: none; }
      .lc-f-out-projections,
      .lc-f-out-breakdown { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lc-f-model-card,
      .lc-f-cta,
      .lc-f-cta svg { transition: none; }
      .lc-f-out-tag::before { animation: none; }
    }

    /* ════════════════════════════════════════════════════
       RESPONSIVE
       ════════════════════════════════════════════════════ */
    @media (max-width: 1100px) {
      .lc-layout-b { grid-template-columns: 1fr; }
      .lc-b-result { border-left: none; border-top: 1px solid rgba(255,255,255,0.08); }
      .lc-layout-c {
        grid-template-columns: 1fr;
      }
      .lc-c-connector {
        width: 100%;
        height: 2.75rem;
        transform: rotate(90deg);
      }
      .lc-c-stage--result { border-left: none; border-top: 1px solid rgba(255,255,255,0.08); }
      .lc-d-controls { grid-template-columns: 1fr; }
      .lc-layout-d .lc-result--band { grid-template-columns: 1fr; }
      .lc-layout-d .lc-result--band .lc-result-eyebrow,
      .lc-layout-d .lc-result--band .lc-result-monthly,
      .lc-layout-d .lc-result--band .lc-result-caption,
      .lc-layout-d .lc-result--band .lc-result-secondary,
      .lc-layout-d .lc-result--band .lc-cta {
        grid-column: 1;
      }
      .lc-layout-d .lc-result--band .lc-result-secondary {
        grid-row: auto;
        flex-direction: row;
        padding-left: 0;
        border-left: none;
        margin-top: 1.2rem;
      }
      .lc-layout-d .lc-result--band .lc-cta { align-self: stretch; width: 100%; margin-top: 1.5rem; }
      .lc-layout-d .lc-result--band .lc-breakdown { grid-template-columns: repeat(2, 1fr); gap: 1rem 0; }
    }
    @media (max-width: 720px) {
      .lc-input-row,
      .lc-input-row--2col { grid-template-columns: repeat(2, 1fr); }
      .lc-model-grid,
      .lc-model-grid--2col { grid-template-columns: repeat(2, 1fr); }
      .lc-a-result { padding: 2.5rem 1.5rem 2rem; }
      .lc-a-controls { padding: 2rem 1.5rem 2.25rem; }
      .lc-b-controls { padding: 2rem 1.5rem; }
      .lc-b-result { padding: 2.25rem 1.5rem; }
      .lc-d-band { padding: 2rem 1.5rem; }
      .lc-option { padding: 4rem 1.25rem; }
      .lc-option-header { gap: 0.9rem; }
      .lc-layout-d .lc-result--band .lc-breakdown { grid-template-columns: 1fr; }
      .lc-layout-d .lc-result--band .lc-breakdown-row {
        flex-direction: row;
        justify-content: space-between;
        padding: 0.4rem 0;
        border-right: none;
        border-bottom: 1px solid rgba(255,255,255,0.06);
      }
    }
    @media (max-width: 460px) {
      .lc-input-row,
      .lc-input-row--2col,
      .lc-model-grid,
      .lc-model-grid--2col { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .lc-modal-backdrop,
      .lc-modal-panel { animation: none; }
      .lc-jump-link,
      .lc-scenario-btn,
      .lc-util-btn,
      .lc-model-card,
      .lc-cta { transition: none; }
    }

    /* ════════════════════════════════════════════════════
       OPTION O — ORIGINAL  (preserved /profits build)
       Verbatim port of the calculator styles currently live
       on /testing/profits — the two-pill scenario picker and
       its model-card states. .profits-calc-* names are unique
       to this page; the generic .model-* states are scoped
       under .lc-layout-o. Model active states are pure-CSS
       here (the /profits page used a syncModelCards() JS
       helper; the shared initCalculator engine doesn't).
       ════════════════════════════════════════════════════ */
    .lc-option--o { background: #0d1b22; }
    .lc-layout-o { position: relative; }

    .profits-calc-picker { position: relative; }
    .profits-calc-picker-line {
      display: flex;
      flex-direction: column;
      gap: 1.65rem;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .profits-calc-picker-line {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1.5rem;
      }
    }
    .profits-calc-picker-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .profits-calc-picker-zone--custom { align-items: flex-start; }
      .profits-calc-picker-zone--util   { align-items: flex-end; }
    }
    .profits-calc-picker-label {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(45, 200, 86, 0.72);
      margin: 0 0 0.85rem;
      text-align: center;
    }
    @media (min-width: 1024px) {
      .profits-calc-picker-zone--custom .profits-calc-picker-label { text-align: left; }
      .profits-calc-picker-zone--util   .profits-calc-picker-label { text-align: right; }
    }
    .profits-calc-picker-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
    }

    /* Scenario pill (Property Type) — icon + label + type tag */
    .profits-calc-scenario-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.7rem 1.15rem 0.7rem 0.85rem;
      background: linear-gradient(165deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.015) 100%);
      border: 1px solid rgba(255, 255, 255, 0.10);
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.78);
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      cursor: pointer;
      transition:
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 220ms ease,
        background 220ms ease,
        color 220ms ease,
        box-shadow 220ms ease;
    }
    .profits-calc-scenario-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(45, 200, 86, 0.42);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45, 200, 86, 0.10) 0%, rgba(45, 200, 86, 0.03) 100%);
    }
    .profits-calc-scenario-btn.is-active {
      border-color: rgba(45, 200, 86, 0.75);
      background: linear-gradient(165deg, rgba(45, 200, 86, 0.18) 0%, rgba(45, 200, 86, 0.06) 100%);
      color: #ffffff;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.14),
        0 0 22px -4px rgba(45, 200, 86, 0.45),
        0 6px 14px -6px rgba(45, 200, 86, 0.30);
    }
    .profits-calc-scenario-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: linear-gradient(155deg, rgba(45, 200, 86, 0.20) 0%, rgba(45, 200, 86, 0.05) 100%);
      border: 1px solid rgba(45, 200, 86, 0.30);
      color: #2DC856;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transition: background 220ms ease, border-color 220ms ease;
    }
    .profits-calc-scenario-icon svg { width: 16px; height: 16px; }
    .profits-calc-scenario-btn.is-active .profits-calc-scenario-icon {
      background: linear-gradient(155deg, rgba(45, 200, 86, 0.34) 0%, rgba(45, 200, 86, 0.12) 100%);
      border-color: rgba(45, 200, 86, 0.55);
    }
    .profits-calc-scenario-type {
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: rgba(45, 200, 86, 0.65);
      padding: 0.18rem 0.4rem;
      border-radius: 5px;
      background: rgba(45, 200, 86, 0.08);
      border: 1px solid rgba(45, 200, 86, 0.18);
    }
    .profits-calc-scenario-btn.is-active .profits-calc-scenario-type {
      color: rgba(45, 200, 86, 0.95);
      background: rgba(45, 200, 86, 0.15);
      border-color: rgba(45, 200, 86, 0.35);
    }

    /* Utilization pill (Low / Medium / High) */
    .profits-calc-util-btn {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
      padding: 0.6rem 1.1rem 0.7rem;
      background: linear-gradient(165deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.015) 100%);
      border: 1px solid rgba(255, 255, 255, 0.10);
      border-radius: 14px;
      color: rgba(255, 255, 255, 0.78);
      font-family: inherit;
      cursor: pointer;
      min-width: 130px;
      transition:
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 220ms ease,
        background 220ms ease,
        color 220ms ease,
        box-shadow 220ms ease;
    }
    .profits-calc-util-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(45, 200, 86, 0.42);
      color: #ffffff;
      background: linear-gradient(165deg, rgba(45, 200, 86, 0.08) 0%, rgba(45, 200, 86, 0.02) 100%);
    }
    .profits-calc-util-btn.is-active {
      border-color: rgba(45, 200, 86, 0.75);
      background: linear-gradient(165deg, rgba(45, 200, 86, 0.18) 0%, rgba(45, 200, 86, 0.06) 100%);
      color: #ffffff;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.14),
        0 0 22px -4px rgba(45, 200, 86, 0.45),
        0 6px 14px -6px rgba(45, 200, 86, 0.30);
    }
    .profits-calc-util-label {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1;
    }
    .profits-calc-util-rate {
      font-size: 1.2rem;
      font-weight: 900;
      letter-spacing: -0.01em;
      color: #2DC856;
      line-height: 1.1;
      margin-top: 0.25rem;
      font-variant-numeric: tabular-nums;
    }
    .profits-calc-util-btn.is-active .profits-calc-util-rate { color: #ffffff; }
    .profits-calc-util-mini {
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.4);
      line-height: 1;
    }

    /* Model cards — pure-CSS active states (scoped to Option O). */
    .lc-layout-o .model-card {
      transition: border-color 240ms ease, background 240ms ease;
    }
    .lc-layout-o .model-option:hover .model-card { border-color: rgba(255, 255, 255, 0.3); }
    .lc-layout-o .model-option input:checked ~ .model-card {
      border-color: #2DC856;
      background: rgba(45, 200, 86, 0.06);
    }
    .lc-layout-o .model-option input:focus-visible ~ .model-card {
      outline: 2px solid #2DC856;
      outline-offset: 2px;
    }
    .lc-layout-o .model-dot { transition: border-color 240ms ease, background 240ms ease; }
    .lc-layout-o .model-option input:checked ~ .model-card .model-dot {
      border-color: #2DC856;
      background: #2DC856;
    }
    .lc-layout-o .model-option input:checked ~ .model-card .dot-inner { opacity: 1; }
    .lc-layout-o .model-card .model-badge {
      transition: background 240ms ease, border-color 240ms ease, color 240ms ease;
    }
    .lc-layout-o .model-option input:checked ~ .model-card .model-badge {
      background: rgba(45, 200, 86, 0.20);
      border-color: rgba(45, 200, 86, 0.45);
      color: #ffffff;
    }
    @media (prefers-reduced-motion: reduce) {
      .profits-calc-scenario-btn,
      .profits-calc-util-btn,
      .lc-layout-o .model-card,
      .lc-layout-o .model-dot { transition: none; }
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       SCRIPT — reusable calculator engine + shared modal
  ═══════════════════════════════════════════════ -->
  <script>
    type CalcInstance = {
      root: HTMLElement;
      getRecap: () => {
        sessions: string; ports: string; kwh: string; price: string;
        model: string; monthly: string;
      };
    };

    const fmtUSD = (n: number) =>
      new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 })
        .format(Math.max(0, Math.round(n)));
    const fmtNum = (n: number) =>
      new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(n)));

    const calcInstances = new Map<HTMLElement, CalcInstance>();

    /* ─── Reusable per-root calculator engine ─── */
    function initCalculator(root: HTMLElement): CalcInstance | null {
      const q  = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s);
      const qa = <T extends HTMLElement = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T>(s));

      const sessionsEl = q<HTMLInputElement>('[data-input="sessions"]');
      const portsEl    = q<HTMLInputElement>('[data-input="ports"]');
      const kwhEl      = q<HTMLInputElement>('[data-input="kwh"]');
      const priceEl    = q<HTMLInputElement>('[data-input="price"]');
      if (!sessionsEl || !portsEl || !kwhEl || !priceEl) return null;

      const scenarioBtns    = qa<HTMLButtonElement>('[data-scenario]');
      const utilizationBtns = qa<HTMLButtonElement>('[data-utilization]');
      const customBtn       = q<HTMLButtonElement>('[data-scenario="custom"]');
      const modelInputs     = qa<HTMLInputElement>('input[name^="model-"]');

      const out = {
        monthly:  q('[data-out="monthly"]'),
        yearly:   q('[data-out="yearly"]'),
        fiveyr:   q('[data-out="fiveyr"]'),
        gross:    q('[data-out="gross"]'),
        sessions: q('[data-out="sessions"]'),
        energy:   q('[data-out="energy"]'),
        share:    q('[data-out="share"]'),
        caption:  q('[data-out="caption"]'),
      };

      let activeScenario: HTMLButtonElement | null = null;
      let activeUtilization: 'low' | 'medium' | 'high' | null = null;

      const numFmt = (n: number) => {
        const r = Math.round(n * 10) / 10;
        return `~${r % 1 === 0 ? r.toFixed(0) : r.toFixed(1)}`;
      };

      function computeShare(): number {
        const checked = root.querySelector<HTMLInputElement>('input[name^="model-"]:checked');
        return checked ? parseFloat(checked.value) : 0.10;
      }

      function calc() {
        const s  = Math.max(0, parseFloat(sessionsEl!.value) || 0);
        const p  = Math.max(0, parseFloat(portsEl!.value)    || 0);
        const k  = Math.max(0, parseFloat(kwhEl!.value)      || 0);
        const pr = Math.max(0, parseFloat(priceEl!.value)    || 0);
        const sessionsPerMonth = s * p * 30;
        const energyPerMonth   = sessionsPerMonth * k;
        const grossMonthly     = energyPerMonth * pr;
        const share   = computeShare();
        const monthly = grossMonthly * share;
        return {
          gross: grossMonthly, monthly, yearly: monthly * 12, fiveYr: monthly * 60,
          sessions: sessionsPerMonth, energy: energyPerMonth, share,
        };
      }

      function captionText(): string {
        let scenario = 'Custom inputs';
        if (activeScenario && activeScenario.dataset.scenario !== 'custom') {
          const label = activeScenario.querySelector('.lc-scenario-label')?.textContent ?? '';
          const type  = activeScenario.dataset.type ?? '';
          scenario = `${label} ${type}`.trim();
        }
        const util = activeUtilization
          ? activeUtilization[0].toUpperCase() + activeUtilization.slice(1) + ' utilization'
          : 'Custom utilization';
        const checked = root.querySelector<HTMLInputElement>('input[name^="model-"]:checked');
        const modelLabel = checked
          ? checked.closest('.lc-model-option')?.querySelector('.lc-model-label')?.textContent ?? ''
          : '';
        return `${scenario} · ${util} · ${modelLabel}`;
      }

      function render() {
        const r = calc();
        if (out.monthly)  out.monthly.textContent  = fmtUSD(r.monthly);
        if (out.yearly)   out.yearly.textContent   = fmtUSD(r.yearly);
        if (out.fiveyr)   out.fiveyr.textContent   = fmtUSD(r.fiveYr);
        if (out.gross)    out.gross.textContent    = fmtUSD(r.gross);
        if (out.sessions) out.sessions.textContent = fmtNum(r.sessions);
        if (out.energy)   out.energy.textContent   = fmtNum(r.energy);
        if (out.share)    out.share.textContent    = `${Math.round(r.share * 100)}%`;
        if (out.caption)  out.caption.textContent  = captionText();
      }

      function setActiveScenario(btn: HTMLButtonElement | null) {
        activeScenario = btn;
        scenarioBtns.forEach(b => b.classList.toggle('is-active', b === btn));
      }
      function setActiveUtilization(level: 'low' | 'medium' | 'high' | null) {
        activeUtilization = level;
        utilizationBtns.forEach(b => b.classList.toggle('is-active', b.dataset.utilization === level));
      }
      function refreshUtilLabels() {
        utilizationBtns.forEach(btn => {
          const level = btn.dataset.utilization as 'low' | 'medium' | 'high';
          const rateEl = btn.querySelector<HTMLElement>('[data-util-rate]');
          if (!rateEl) return;
          const key = `util${level[0].toUpperCase()}${level.slice(1)}`;
          const rateAttr = activeScenario?.dataset[key];
          rateEl.textContent = rateAttr !== undefined ? numFmt(parseFloat(rateAttr)) : '—';
        });
      }
      function applyUtilization(level: 'low' | 'medium' | 'high') {
        setActiveUtilization(level);
        if (activeScenario && activeScenario.dataset.scenario !== 'custom') {
          const key = `util${level[0].toUpperCase()}${level.slice(1)}`;
          const rate = parseFloat(activeScenario.dataset[key] || '0');
          sessionsEl!.value = String(rate);
        }
        render();
      }
      function applyScenario(btn: HTMLButtonElement) {
        setActiveScenario(btn);
        if (btn.dataset.scenario !== 'custom') {
          portsEl!.value = btn.dataset.ports ?? portsEl!.value;
          kwhEl!.value   = btn.dataset.kwh   ?? kwhEl!.value;
          priceEl!.value = btn.dataset.price ?? priceEl!.value;
          refreshUtilLabels();
          applyUtilization('medium');
        } else {
          setActiveUtilization(null);
          refreshUtilLabels();
          render();
        }
      }

      scenarioBtns.forEach(btn => btn.addEventListener('click', () => applyScenario(btn)));
      utilizationBtns.forEach(btn => btn.addEventListener('click', () =>
        applyUtilization(btn.dataset.utilization as 'low' | 'medium' | 'high')
      ));
      modelInputs.forEach(input => input.addEventListener('change', render));

      sessionsEl.addEventListener('input', () => { setActiveUtilization(null); render(); });
      [portsEl, kwhEl, priceEl].forEach(el => {
        el.addEventListener('input', () => {
          if (customBtn) setActiveScenario(customBtn);
          else setActiveScenario(null);
          setActiveUtilization(null);
          refreshUtilLabels();
          render();
        });
      });

      // First paint: first real scenario at Medium utilization.
      const firstReal = scenarioBtns.find(b => b.dataset.scenario !== 'custom');
      if (firstReal) applyScenario(firstReal);
      else render();

      return {
        root,
        getRecap() {
          const r = calc();
          const checked = root.querySelector<HTMLInputElement>('input[name^="model-"]:checked');
          const modelLabel = checked
            ? checked.closest('.lc-model-option')?.querySelector('.lc-model-label')?.textContent ?? '—'
            : '—';
          const share = checked ? Math.round(parseFloat(checked.value) * 100) : 10;
          return {
            sessions: sessionsEl!.value || '—',
            ports:    portsEl!.value    || '—',
            kwh:      kwhEl!.value      || '—',
            price:    `$${parseFloat(priceEl!.value || '0').toFixed(2)}`,
            model:    `${modelLabel} (${share}%)`,
            monthly:  fmtUSD(r.monthly) + ' / mo',
          };
        },
      };
    }

    document.querySelectorAll<HTMLElement>('[data-calc-root]').forEach(root => {
      const inst = initCalculator(root);
      if (inst) calcInstances.set(root, inst);
    });

    /* ─── Options E & F — segmented-control enhancements ───
       Both the light Option E and the dark Option F use the
       segmented controls. This block (1) slides each green thumb
       by measuring the active segment and writing width +
       translateX to inline style — the base `transition:
       transform` animates the slide — and (2) for Option F,
       rewrites the live model-description card when the
       financial-model segment changes. A MutationObserver keeps
       the thumbs correct even when state changes without a click
       (manual input edits deselect the scenario + utilization);
       a resize listener re-measures when a track reflows. */
    (() => {
      const hosts = Array.from(
        document.querySelectorAll<HTMLElement>('[data-option="e"], [data-option="f"]')
      );
      if (!hosts.length) return;
      const segs = hosts.flatMap(h => Array.from(h.querySelectorAll<HTMLElement>('.lc-e-seg')));

      const syncThumbs = () => {
        segs.forEach(seg => {
          const thumb = seg.querySelector<HTMLElement>('.lc-e-thumb');
          if (!thumb) return;
          let active: HTMLElement | null = null;
          if (seg.classList.contains('lc-e-seg-model')) {
            active = Array.from(seg.querySelectorAll<HTMLElement>('.lc-model-option'))
              .find(o => o.querySelector<HTMLInputElement>('input')?.checked) || null;
          } else {
            active = seg.querySelector<HTMLElement>('.lc-e-seg-btn.is-active');
          }
          if (!active) { thumb.style.opacity = '0'; return; }
          thumb.style.opacity = '';
          thumb.style.width = active.offsetWidth + 'px';
          thumb.style.transform = `translateX(${active.offsetLeft - thumb.offsetLeft}px)`;
        });
      };

      /* Option F — the live, self-rewriting model description card.
         Detail + spec copy lives here (it's display-only and not
         needed server-side); grounded in the four canonical Evium
         financial models. */
      const F_MODEL_DETAIL: Record<string, {
        title: string; badge: string; detail: string;
        capital: string; operations: string; revenue: string; term: string;
      }> = {
        'no-cost': {
          title: 'No-Cost', badge: '~10% revenue share',
          detail: 'Evium funds the capital and runs the site end to end — hardware, install, software, support, and the cost of every kilowatt sold. You contribute the location; revenue is shared, weighted in your favor.',
          capital: 'Evium', operations: 'Evium', revenue: 'Shared, host-favored', term: '5 yr + 5',
        },
        'investment': {
          title: 'Client Investment', badge: '100% revenue',
          detail: 'You finance and own the entire installation, run it, and keep every dollar it earns. Evium’s role narrows to rebate processing and incentive capture — the best fit when you have the capital and an operations team.',
          capital: 'You', operations: 'You', revenue: '100% yours', term: 'You own it',
        },
        'hybrid': {
          title: 'Hybrid', badge: 'Negotiated split',
          detail: 'A blend of No-Cost and Client Investment — you contribute part of the capital, and your share of revenue scales up with what you put in. Tuned site by site to land where you want on the risk-vs-upside curve.',
          capital: 'Shared', operations: 'Evium', revenue: 'Scales with capital', term: 'Negotiated',
        },
        'leasing': {
          title: 'Leasing', badge: '100% revenue',
          detail: 'Evium finances the hardware as a lease. You make a fixed monthly payment, keep all gross revenue, and hold a buy-out option at term end — payment and term sized to your site’s projected throughput.',
          capital: 'Evium-financed', operations: 'Negotiated', revenue: 'Gross − lease', term: 'Buy-out at end',
        },
      };

      const optionF = document.querySelector<HTMLElement>('[data-option="f"]');
      const fCard = optionF?.querySelector<HTMLElement>('[data-model-card]') ?? null;
      const fEls = fCard ? {
        title:   fCard.querySelector<HTMLElement>('[data-model-title]'),
        badge:   fCard.querySelector<HTMLElement>('[data-model-badge]'),
        blurb:   fCard.querySelector<HTMLElement>('[data-model-blurb]'),
        capital: fCard.querySelector<HTMLElement>('[data-spec-capital]'),
        ops:     fCard.querySelector<HTMLElement>('[data-spec-ops]'),
        revenue: fCard.querySelector<HTMLElement>('[data-spec-revenue]'),
        term:    fCard.querySelector<HTMLElement>('[data-spec-term]'),
      } : null;
      const updateFCard = (immediate?: boolean) => {
        if (!optionF || !fCard || !fEls) return;
        const checked = optionF.querySelector<HTMLInputElement>('input[name="model-f"]:checked');
        const id = checked?.dataset.modelId;
        const d = id ? F_MODEL_DETAIL[id] : null;
        if (!d) return;
        const apply = () => {
          if (fEls.title)   fEls.title.textContent   = d.title;
          if (fEls.badge)   fEls.badge.textContent   = d.badge;
          if (fEls.blurb)   fEls.blurb.textContent   = d.detail;
          if (fEls.capital) fEls.capital.textContent = d.capital;
          if (fEls.ops)     fEls.ops.textContent     = d.operations;
          if (fEls.revenue) fEls.revenue.textContent = d.revenue;
          if (fEls.term)    fEls.term.textContent    = d.term;
          fCard.classList.remove('is-swapping');
        };
        if (immediate) { apply(); return; }
        fCard.classList.add('is-swapping');
        window.setTimeout(apply, 150);
      };

      syncThumbs();
      updateFCard(true);
      requestAnimationFrame(syncThumbs);
      hosts.forEach(host => {
        new MutationObserver(syncThumbs).observe(host, {
          subtree: true, attributes: true, attributeFilter: ['class'],
        });
        host.addEventListener('change', (e) => {
          const t = e.target;
          if (t instanceof HTMLInputElement && /^model-/.test(t.name)) {
            syncThumbs();
            if (t.name === 'model-f') updateFCard();
          }
        });
      });
      window.addEventListener('resize', syncThumbs);
    })();

    /* ─── Shared estimate modal ─── */
    const modal       = document.getElementById('lc-modal')!;
    const formView    = document.getElementById('lc-modal-form-view')!;
    const successView = document.getElementById('lc-modal-success-view')!;
    const form        = document.getElementById('lc-modal-form') as HTMLFormElement;
    const submitBtn   = document.getElementById('lc-ef-submit') as HTMLButtonElement;
    const submitLabel = document.getElementById('lc-ef-submit-label')!;
    const errorEl     = document.getElementById('lc-ef-error')!;
    const recap = {
      sessions: document.getElementById('lc-recap-sessions')!,
      ports:    document.getElementById('lc-recap-ports')!,
      kwh:      document.getElementById('lc-recap-kwh')!,
      price:    document.getElementById('lc-recap-price')!,
      model:    document.getElementById('lc-recap-model')!,
      monthly:  document.getElementById('lc-recap-monthly')!,
    };
    let lastFocus: HTMLElement | null = null;

    function openModal(fromRoot: HTMLElement) {
      lastFocus = document.activeElement as HTMLElement;
      const inst = calcInstances.get(fromRoot);
      if (inst) {
        const r = inst.getRecap();
        recap.sessions.textContent = r.sessions;
        recap.ports.textContent    = r.ports;
        recap.kwh.textContent      = r.kwh;
        recap.price.textContent    = r.price;
        recap.model.textContent    = r.model;
        recap.monthly.textContent  = r.monthly;
      }
      formView.hidden = false;
      successView.hidden = true;
      errorEl.hidden = true;
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send My Estimate Request';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => document.getElementById('lc-ef-name')?.focus(), 120);
    }
    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus?.();
    }

    document.querySelectorAll<HTMLElement>('[data-open-estimate]').forEach(btn => {
      btn.addEventListener('click', () => {
        const root = btn.closest<HTMLElement>('[data-calc-root]');
        if (root) openModal(root);
      });
    });
    document.querySelectorAll<HTMLElement>('[data-close-estimate]').forEach(el =>
      el.addEventListener('click', closeModal)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const honeypot = (form.elements.namedItem('company_website') as HTMLInputElement | null)?.value;
      if (honeypot) return;
      const name    = (form.elements.namedItem('name')    as HTMLInputElement).value.trim();
      const email   = (form.elements.namedItem('email')   as HTMLInputElement).value.trim();
      const address = (form.elements.namedItem('address') as HTMLInputElement).value.trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!name || !emailOk || !address) {
        errorEl.textContent = !emailOk && email
          ? 'Please enter a valid email address.'
          : 'Please complete name, email, and property address.';
        errorEl.hidden = false;
        return;
      }
      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';
      // No backend — simulate the round-trip (this is a layout-testing page).
      await new Promise(r => setTimeout(r, 650));
      formView.hidden = true;
      successView.hidden = false;
    });
  </script>

</Layout>
