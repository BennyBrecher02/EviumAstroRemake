  <!-- ═══════════════════════════════════════════════
       CALCULATOR + MODAL SCRIPT — copied from
       /solutions/profit-calculator (same behavior)
  ═══════════════════════════════════════════════ -->
  <script>
    type Result = {
      gross: number;
      monthly: number;
      yearly: number;
      fiveYr: number;
      sessions: number;
      energy: number;
      share: number;
    };

    const fmtUSD = (n: number) =>
      new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(
        Math.max(0, Math.round(n))
      );
    const fmtNum = (n: number) =>
      new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(n)));

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

    const sessionsEl = $<HTMLInputElement>('sessions');
    const portsEl    = $<HTMLInputElement>('ports');
    const kwhEl      = $<HTMLInputElement>('kwh');
    const priceEl    = $<HTMLInputElement>('price');

    const outMonthly  = $('result-monthly');
    const outYearly   = $('result-yearly');
    const out5yr      = $('result-5yr');
    const outGross    = $('result-gross');
    const outSessions = $('result-sessions');
    const outEnergy   = $('result-energy');
    const outShare    = $('result-share');
    const outCaption  = $('result-caption');

    /* Computes the owner's revenue share from the active model
       radio. Default to ~10% (No-Cost) per the business-model doc
       — this was a bug previously where it defaulted to 0.60.
       The radio inputs themselves carry the correct values now
       (0.10 / 1.00 / 0.50 / 1.00 for the four models). */
    function computeShare(): number {
      const checked = document.querySelector<HTMLInputElement>('input[name="model"]:checked');
      return checked ? parseFloat(checked.value) : 0.10;
    }

    function calc(): Result {
      const sessionsPerPortPerDay = Math.max(0, parseFloat(sessionsEl.value) || 0);
      const ports                 = Math.max(0, parseFloat(portsEl.value)    || 0);
      const kwhPerSession         = Math.max(0, parseFloat(kwhEl.value)      || 0);
      const pricePerKwh           = Math.max(0, parseFloat(priceEl.value)    || 0);

      const sessionsPerMonth = sessionsPerPortPerDay * ports * 30;
      const energyPerMonth   = sessionsPerMonth * kwhPerSession;
      const grossMonthly     = energyPerMonth * pricePerKwh;

      const share   = computeShare();
      const monthly = grossMonthly * share;
      const yearly  = monthly * 12;
      const fiveYr  = yearly * 5;

      return { gross: grossMonthly, monthly, yearly, fiveYr, sessions: sessionsPerMonth, energy: energyPerMonth, share };
    }

    function render() {
      const r = calc();
      outMonthly.textContent  = fmtUSD(r.monthly);
      outYearly.textContent   = fmtUSD(r.yearly);
      out5yr.textContent      = fmtUSD(r.fiveYr);
      outGross.textContent    = fmtUSD(r.gross);
      outSessions.textContent = fmtNum(r.sessions);
      outEnergy.textContent   = fmtNum(r.energy);
      outShare.textContent    = `${Math.round(r.share * 100)}%`;
      if (outCaption) outCaption.textContent = captionText();
    }

    /* The active-combo caption shown in the result panel
       ("Multifamily L2 · Medium utilization · No-Cost"). Reads
       the scenario + utilization state set by the picker below,
       plus the checked financial model. */
    function captionText(): string {
      let scenario = 'Custom inputs';
      if (activeScenario && activeScenario.dataset.scenario !== 'custom') {
        const label = activeScenario.querySelector('.lc-scenario-label')?.textContent ?? '';
        const type  = activeScenario.dataset.type ?? '';
        scenario = `${label} ${type}`.trim();
      }
      const util = activeUtilization
        ? activeUtilization[0].toUpperCase() + activeUtilization.slice(1) + ' utilization'
        : 'Custom utilization';
      const checked = document.querySelector<HTMLInputElement>('input[name="model"]:checked');
      const modelLabel = checked
        ? checked.closest('.lc-model-option')?.querySelector('.lc-model-label')?.textContent ?? ''
        : '';
      return `${scenario} · ${util} · ${modelLabel}`;
    }

    document.querySelectorAll<HTMLInputElement>('input[name="model"]').forEach(el => {
      el.addEventListener('change', render);
    });

    /* ─────────────  Scenario + Utilization pill picker  ───────
       Two-pill-row state machine:
         · scenarioBtns: one of three property types (or none)
         · utilizationBtns: one of low / medium / high (or none)
       Picking a scenario sets ports/kwh/price + refreshes the
       utilization rate labels for that scenario + resets the
       sessions/port/day input to that scenario's "medium" rate.
       Picking a utilization sets sessions/port/day to the active
       scenario's matching rate.
       Manual input edits (typing into ports/sessions/kwh/price)
       deselect the corresponding pill row(s) — pills are presets,
       not constraints. */
    const scenarioBtns    = document.querySelectorAll<HTMLButtonElement>('[data-scenario]');
    const utilizationBtns = document.querySelectorAll<HTMLButtonElement>('[data-utilization]');
    const customScenarioBtn = document.querySelector<HTMLButtonElement>('[data-scenario="custom"]');
    let activeScenario: HTMLButtonElement | null = null;
    let activeUtilization: 'low' | 'medium' | 'high' | null = null;

    const numFmt = (n: number) => {
      // tighter rendering for the per-pill rate labels: "~2.5" or "~12"
      const rounded = Math.round(n * 10) / 10;
      return `~${rounded % 1 === 0 ? rounded.toFixed(0) : rounded.toFixed(1)}`;
    };

    function setActiveScenario(btn: HTMLButtonElement | null) {
      activeScenario = btn;
      scenarioBtns.forEach(b => b.classList.toggle('is-active', b === btn));
    }
    function setActiveUtilization(level: 'low' | 'medium' | 'high' | null) {
      activeUtilization = level;
      utilizationBtns.forEach(b => b.classList.toggle('is-active', b.dataset.utilization === level));
    }

    function refreshUtilLabels() {
      utilizationBtns.forEach(btn => {
        const level = btn.dataset.utilization as 'low' | 'medium' | 'high';
        const rateEl = btn.querySelector<HTMLElement>('[data-util-rate]');
        if (!rateEl) return;
        // Only show a rate if the active scenario has utilization
        // data attributes (the Custom scenario doesn't — it carries
        // data-scenario="custom" but no util-low/medium/high).
        const key = `util${level[0].toUpperCase()}${level.slice(1)}`;
        const rateAttr = activeScenario?.dataset[key];
        rateEl.textContent = rateAttr !== undefined ? numFmt(parseFloat(rateAttr)) : '—';
      });
    }

    function applyScenario(btn: HTMLButtonElement, opts: { keepUtilization?: boolean } = {}) {
      setActiveScenario(btn);
      const isCustom = btn.dataset.scenario === 'custom';
      if (!isCustom) {
        // Real scenario — pre-fill the input fields + apply Medium utilization
        portsEl.value = btn.dataset.ports ?? portsEl.value;
        kwhEl.value   = btn.dataset.kwh   ?? kwhEl.value;
        priceEl.value = btn.dataset.price ?? priceEl.value;
        refreshUtilLabels();
        const level = opts.keepUtilization && activeUtilization ? activeUtilization : 'medium';
        applyUtilization(level);
      } else {
        // Custom — keep current input values, clear utilization
        setActiveUtilization(null);
        refreshUtilLabels();
        render();
      }
    }

    function applyUtilization(level: 'low' | 'medium' | 'high') {
      setActiveUtilization(level);
      if (activeScenario) {
        const rate = parseFloat(activeScenario.dataset[`util${level[0].toUpperCase()}${level.slice(1)}`] || '0');
        sessionsEl.value = String(rate);
      }
      render();
    }

    scenarioBtns.forEach(btn => {
      btn.addEventListener('click', () => applyScenario(btn));
    });
    utilizationBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const level = btn.dataset.utilization as 'low' | 'medium' | 'high';
        applyUtilization(level);
      });
    });

    /* Manual edits switch the visitor into "Custom" mode:
       - sessions input edit → deselects utilization, leaves
         scenario alone (sessions and utilization are 1:1 tied,
         but ports/kwh/price still reflect the active scenario).
       - ports/kwh/price input edit → auto-selects the Custom
         scenario pill (the visitor has gone off-preset). */
    sessionsEl.addEventListener('input', () => { setActiveUtilization(null); render(); });
    sessionsEl.addEventListener('change', render);
    [portsEl, kwhEl, priceEl].forEach(el => {
      el.addEventListener('input', () => {
        if (customScenarioBtn) {
          setActiveScenario(customScenarioBtn);
        } else {
          setActiveScenario(null);
        }
        setActiveUtilization(null);
        refreshUtilLabels();
        render();
      });
      el.addEventListener('change', render);
    });

    // First-paint: pre-select the first real scenario (i.e. not
    // the Custom pill, which is meant only for off-preset state)
    // at Medium utilization so the calc opens with a coherent
    // starting state rather than asking the visitor to decide
    // before seeing any numbers.
    const firstRealScenario = Array.from(scenarioBtns).find(b => b.dataset.scenario !== 'custom');
    if (firstRealScenario) {
      applyScenario(firstRealScenario);
    } else {
      render();
    }

    /* ─────────────  Estimate modal  ───────────── */
    const modal       = $('estimate-modal');
    const backdrop    = $('estimate-backdrop');
    const panel       = $('estimate-panel');
    const formView    = $('estimate-form-view');
    const successView = $('estimate-success-view');
    const form        = $<HTMLFormElement>('estimate-form');
    const submitBtn   = $<HTMLButtonElement>('ef-submit');
    const submitLabel = $('ef-submit-label');
    const errorEl     = $('ef-error');

    const recapSessions = $('recap-sessions');
    const recapPorts    = $('recap-ports');
    const recapKwh      = $('recap-kwh');
    const recapPrice    = $('recap-price');
    const recapModel    = $('recap-model');
    const recapMonthly  = $('recap-monthly');

    let lastFocus: HTMLElement | null = null;

    function fillRecap() {
      const r = calc();
      recapSessions.textContent = sessionsEl.value || '—';
      recapPorts.textContent    = portsEl.value    || '—';
      recapKwh.textContent      = kwhEl.value      || '—';
      recapPrice.textContent    = `$${parseFloat(priceEl.value || '0').toFixed(2)}`;
      const checked = document.querySelector<HTMLInputElement>('input[name="model"]:checked');
      /* Map the active model's data-model-id to a friendly recap
         label. Falls back to "—" if nothing is selected. */
      const modelId = checked?.dataset.modelId || '';
      const modelLabelMap: Record<string, string> = {
        'no-cost':    'No-Cost (~10%)',
        'investment': 'Client Investment (100%)',
        'hybrid':     'Hybrid (~50%)',
        'leasing':    'Leasing (100%, ex. lease fee)',
      };
      recapModel.textContent = modelLabelMap[modelId] || '—';
      recapMonthly.textContent = fmtUSD(r.monthly) + ' / mo';
    }

    function openModal() {
      lastFocus = document.activeElement as HTMLElement;
      fillRecap();
      formView.classList.remove('hidden');
      successView.classList.add('hidden');
      errorEl.classList.add('hidden');
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send My Estimate Request';

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        backdrop.classList.add('opacity-100');
        backdrop.classList.remove('opacity-0');
        panel.classList.add('opacity-100', 'translate-y-0');
        panel.classList.remove('opacity-0', 'translate-y-8', 'sm:translate-y-4');
      });
      setTimeout(() => $<HTMLInputElement>('ef-name').focus(), 120);
    }

    function closeModal() {
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      panel.classList.remove('opacity-100', 'translate-y-0');
      panel.classList.add('opacity-0', 'translate-y-8', 'sm:translate-y-4');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        lastFocus?.focus?.();
      }, 200);
    }

    document.querySelectorAll('[data-open-estimate]').forEach(el =>
      el.addEventListener('click', openModal)
    );
    document.querySelectorAll('[data-close-estimate]').forEach(el =>
      el.addEventListener('click', closeModal)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');

      const honeypot = (form.elements.namedItem('company_website') as HTMLInputElement | null)?.value;
      if (honeypot) return;

      const name    = (form.elements.namedItem('name')    as HTMLInputElement).value.trim();
      const email   = (form.elements.namedItem('email')   as HTMLInputElement).value.trim();
      const address = (form.elements.namedItem('address') as HTMLInputElement).value.trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      if (!name || !emailOk || !address) {
        errorEl.textContent = !emailOk && email
          ? 'Please enter a valid email address.'
          : 'Please complete name, email, and property address.';
        errorEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';

      // No backend yet — simulate the round-trip. When the API exists, replace
      // this with a real fetch() to /api/estimate-request including the calc state.
      await new Promise(resolve => setTimeout(resolve, 700));

      formView.classList.add('hidden');
      successView.classList.remove('hidden');
      panel.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* ─────────────  Sidebar tabs (next to calculator) ─────────────
       3 tabs: HOW IT WORKS / BEYOND THE NUMBERS / BIGGER PICTURE.
       Active tab gets a green underline + brighter text; panels are
       toggled via the `hidden` attribute so screen readers see the
       right one. */
    const sidebarTabBtns = document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const sidebarPanels  = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
    function setSidebarTab(key: string) {
      sidebarTabBtns.forEach(btn => {
        const on = btn.dataset.tabBtn === key;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.classList.toggle('text-evium-green', on);
        btn.classList.toggle('!text-white', on);
        btn.classList.toggle('border-evium-green', on);
        btn.classList.toggle('border-transparent', !on);
        btn.classList.toggle('bg-evium-green/[0.06]', on);
      });
      sidebarPanels.forEach(p => {
        const on = p.dataset.tabPanel === key;
        if (on) p.removeAttribute('hidden');
        else    p.setAttribute('hidden', '');
      });
    }
    sidebarTabBtns.forEach(btn => {
      btn.addEventListener('click', () => setSidebarTab(btn.dataset.tabBtn || ''));
    });
    setSidebarTab('howitworks');

    /* ─────────────  Live Console — segmented-control enhancements  ───
       The engine above toggles .is-active on the segment buttons and
       :checked on the model radios. This block (1) slides each green
       thumb by measuring the active segment and writing its width +
       translateX inline — the base `transition: transform` animates
       the slide — and (2) rewrites the live model-description card
       when the financial model changes. A MutationObserver keeps the
       thumbs correct even when state changes without a click (manual
       input edits deselect the scenario + utilization); a resize
       listener re-measures when a track reflows. */
    (() => {
      const consoleRoot = document.querySelector<HTMLElement>('.lc-layout-f');
      if (!consoleRoot) return;
      const segs = Array.from(consoleRoot.querySelectorAll<HTMLElement>('.lc-e-seg'));

      const syncThumbs = () => {
        segs.forEach(seg => {
          const thumb = seg.querySelector<HTMLElement>('.lc-e-thumb');
          if (!thumb) return;
          let active: HTMLElement | null = null;
          if (seg.classList.contains('lc-e-seg-model')) {
            active = Array.from(seg.querySelectorAll<HTMLElement>('.lc-model-option'))
              .find(o => o.querySelector<HTMLInputElement>('input')?.checked) || null;
          } else {
            active = seg.querySelector<HTMLElement>('.lc-e-seg-btn.is-active');
          }
          if (!active) { thumb.style.opacity = '0'; return; }
          thumb.style.opacity = '';
          thumb.style.width = active.offsetWidth + 'px';
          thumb.style.transform = `translateX(${active.offsetLeft - thumb.offsetLeft}px)`;
        });
      };

      /* Live model description card — copy is display-only, grounded
         in the four canonical Evium financial models. */
      const MODEL_DETAIL: Record<string, {
        title: string; badge: string; detail: string;
        capital: string; operations: string; revenue: string; term: string;
      }> = {
        'no-cost': {
          title: 'No-Cost', badge: '~10% revenue share',
          detail: 'Evium funds the capital and runs the site end to end — hardware, install, software, support, and the cost of every kilowatt sold. You contribute the location; revenue is shared, weighted in your favor.',
          capital: 'Evium', operations: 'Evium', revenue: 'Shared, host-favored', term: '5 yr + 5',
        },
        'investment': {
          title: 'Client Investment', badge: '100% revenue',
          detail: 'You finance and own the entire installation, run it, and keep every dollar it earns. Evium’s role narrows to rebate processing and incentive capture — the best fit when you have the capital and an operations team.',
          capital: 'You', operations: 'You', revenue: '100% yours', term: 'You own it',
        },
        'hybrid': {
          title: 'Hybrid', badge: 'Negotiated split',
          detail: 'A blend of No-Cost and Client Investment — you contribute part of the capital, and your share of revenue scales up with what you put in. Tuned site by site to land where you want on the risk-vs-upside curve.',
          capital: 'Shared', operations: 'Evium', revenue: 'Scales with capital', term: 'Negotiated',
        },
        'leasing': {
          title: 'Leasing', badge: '100% revenue',
          detail: 'Evium finances the hardware as a lease. You make a fixed monthly payment, keep all gross revenue, and hold a buy-out option at term end — payment and term sized to your site’s projected throughput.',
          capital: 'Evium-financed', operations: 'Negotiated', revenue: 'Gross − lease', term: 'Buy-out at end',
        },
      };
      const mCard = consoleRoot.querySelector<HTMLElement>('[data-model-card]');
      const mEls = mCard ? {
        title:   mCard.querySelector<HTMLElement>('[data-model-title]'),
        badge:   mCard.querySelector<HTMLElement>('[data-model-badge]'),
        blurb:   mCard.querySelector<HTMLElement>('[data-model-blurb]'),
        capital: mCard.querySelector<HTMLElement>('[data-spec-capital]'),
        ops:     mCard.querySelector<HTMLElement>('[data-spec-ops]'),
        revenue: mCard.querySelector<HTMLElement>('[data-spec-revenue]'),
        term:    mCard.querySelector<HTMLElement>('[data-spec-term]'),
      } : null;
      const updateModelCard = (immediate?: boolean) => {
        if (!mCard || !mEls) return;
        const checked = consoleRoot.querySelector<HTMLInputElement>('input[name="model"]:checked');
        const id = checked?.dataset.modelId;
        const d = id ? MODEL_DETAIL[id] : null;
        if (!d) return;
        const apply = () => {
          if (mEls.title)   mEls.title.textContent   = d.title;
          if (mEls.badge)   mEls.badge.textContent   = d.badge;
          if (mEls.blurb)   mEls.blurb.textContent   = d.detail;
          if (mEls.capital) mEls.capital.textContent = d.capital;
          if (mEls.ops)     mEls.ops.textContent     = d.operations;
          if (mEls.revenue) mEls.revenue.textContent = d.revenue;
          if (mEls.term)    mEls.term.textContent    = d.term;
          mCard.classList.remove('is-swapping');
        };
        if (immediate) { apply(); return; }
        mCard.classList.add('is-swapping');
        window.setTimeout(apply, 150);
      };

      syncThumbs();
      updateModelCard(true);
      requestAnimationFrame(syncThumbs);
      new MutationObserver(syncThumbs).observe(consoleRoot, {
        subtree: true, attributes: true, attributeFilter: ['class'],
      });
      consoleRoot.addEventListener('change', (e) => {
        const t = e.target;
        if (t instanceof HTMLInputElement && t.name === 'model') {
          syncThumbs();
          updateModelCard();
        }
      });
      window.addEventListener('resize', syncThumbs);
    })();

    /* Section-tabs JS removed — the "By the Numbers / Your Options"
       tabbed section it controlled is gone. Utilization ranges are
       now part of the scenario picker above; financial models are
       Step 2 inside the calculator card. */
  </script>

</Layout>
