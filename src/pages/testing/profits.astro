---
/**
 * /testing/profits — MERGED candidate combining the full content of
 * /solutions/profit-calculator and /solutions/generate-profits into a
 * single best-of-both-worlds page. Lives under /testing/ for review
 * before promoting to a canonical URL (e.g. /solutions/generate-profits).
 *
 * Section order (visitor journey: hook → tool → math → scenarios →
 * models → benefits → rebates → social proof → CTA):
 *
 *   1. HERO                    (from generate-profits — "Your parking lot
 *                               is already an asset" + 4-stat strip)
 *   2. CALCULATOR (#calculator)(from profit-calculator — preset chips,
 *                               live inputs, 2-model toggle, results)
 *   3. REVENUE OPPORTUNITY     (from generate-profits — 3 list cards)
 *   4. REVENUE FORMULA         (from generate-profits — U × P × V visual)
 *   5. PROJECTION RANGES       (from generate-profits — Low/Med/High)
 *   6. FINANCIAL MODELS        (from generate-profits — 4 model cards)
 *   7. BEYOND CHARGING REVENUE (merged — calc page's "Grid Monetization /
 *                               Carbon / Revenue Optimization" + calc
 *                               page's "Tenant / Property Value /
 *                               Rebates / Adoption Curve")
 *   8. REBATES & INCENTIVES    (from generate-profits — NEVI / CEC /
 *                               State & Utility)
 *   9. WHY ZERO-COST PAYS      (from generate-profits — "10% beats 100%")
 *   10. OWNER PORTAL           (from generate-profits — 4 mini cards)
 *   11. SOCIAL PROOF           (from generate-profits — 2 testimonials +
 *                               portfolio stat card)
 *   12. FAQ                    (from generate-profits — 6 expandable items)
 *   13. FINAL CTA              (merged — single CTA opening the estimate
 *                               modal that lives at the page root)
 *   14. ESTIMATE MODAL         (from profit-calculator — pre-fills with
 *                               the live calc state when opened)
 *
 * The calculator script + estimate modal logic at the bottom of the file
 * is copied verbatim from /solutions/profit-calculator so the interactive
 * widget behaves identically here.
 */
import Layout from '../../layouts/Layout.astro';

/**
 * Scenario presets (Property Type pills, row 1).
 *
 * NOTE on data sourcing: these per-scenario session-rate values
 * (low/medium/high utilization, kWh per session, $/kWh) are
 * NOT directly sourced from any internal Evium document. They're
 * industry-rough estimates that whoever built the original
 * calculator picked. Should be confirmed with David before
 * shipping out of /testing/. The L/M/H benchmark band sourced
 * from the NEVI proposal data ($900 / $1,500 / $2,100 per
 * single 180kW DCFC) IS preserved as the DCFC-Highway scenario's
 * three utilization rates.
 *
 * Commercial + Retail commented out per spec; can be re-enabled
 * once their numbers are sourced.
 */
const presets = [
  {
    id: 'l2-residential',
    label: 'Multifamily',
    type: 'L2',
    ports: 4,
    utilization: { low: 1,   medium: 2.5, high: 4 },
    kwh: 18,
    price: 0.32,
  },
  /* COMMENTED OUT — re-enable when sourced
  {
    id: 'l2-commercial',
    label: 'Commercial',
    type: 'L2',
    ports: 6,
    utilization: { low: 1.5, medium: 3,   high: 5 },
    kwh: 22,
    price: 0.38,
  },
  {
    id: 'dcfc-retail',
    label: 'Retail',
    type: 'DCFC',
    ports: 2,
    utilization: { low: 4,   medium: 8,   high: 12 },
    kwh: 35,
    price: 0.49,
  },
  */
  {
    id: 'dcfc-highway',
    label: 'Highway',
    type: 'DCFC',
    ports: 4,
    utilization: { low: 6,   medium: 12,  high: 18 },
    kwh: 45,
    price: 0.55,
  },
  {
    id: 'l2-fleets',
    label: 'Fleets',
    type: 'L2',
    ports: 8,
    utilization: { low: 1,   medium: 1.5, high: 2 },
    kwh: 60,
    price: 0.35,
  },
];

/**
 * Financial model presets (Step 3 in the calculator).
 * The "share" is the property owner's portion of gross
 * charging revenue under each model. Per
 * project_evium_business_model.md, the No-Cost model is
 * ~10% to the host / ~90% to Evium — fixing the prior
 * incorrect 0.60 default that this page used to ship with.
 */
const models = [
  {
    id: 'no-cost',
    label: 'No-Cost',
    share: 0.10,
    badge: '~10%',
    blurb: '$0 capital. Evium handles everything.',
  },
  {
    id: 'investment',
    label: 'Client Investment',
    share: 1.00,
    badge: '100%',
    blurb: 'You own equipment. Keep all revenue.',
  },
  {
    id: 'hybrid',
    label: 'Hybrid',
    share: 0.50,
    badge: 'Negotiated',
    blurb: 'Shared capital. Split negotiated.',
  },
  {
    id: 'leasing',
    label: 'Leasing',
    share: 1.00,
    badge: '100%',
    blurb: 'Lease hardware. Keep revenue, pay fee.',
  },
];
---

<Layout
  title="Profits — Evium Charging"
  description="Estimate revenue, compare financial models, and see how Evium's no-cost EV charging program turns parking into a passive revenue stream — with a live calculator and projections grounded in real deployment data."
  headerVariant="v5"
  bodyClass="page-profits"
>

  <!-- ═══════════════════════════════════════════════
       1) HERO — single-section composition. Vertical flow:
       H1 → tight subhead → CTA row → generous breath →
       3-card evidence band as the closer. No pill eyebrow,
       no stat-strip; credibility lives inside the prose
       (the bike-rack analogy + "every rebate handled" +
       "no capital, no operations"). The 3 cards from the
       old Opportunity section are demoted visually so the
       H1 stays the loudest element on the page.
       Background is a layered stack: grid, primary green
       glow behind the H1, a second smaller accent glow
       bottom-right, and a bottom fade that hands off to
       the calculator section seamlessly.
  ═══════════════════════════════════════════════ -->
  <section class="profits-hero relative min-h-screen flex items-center overflow-hidden bg-evium-dark pt-20">
    <!-- Layered background — order matters (bottom → top) -->
    <!-- 1. Subtle grid -->
    <div
      class="absolute inset-0 opacity-[0.045] pointer-events-none"
      style="background-image: linear-gradient(#2DC856 1px, transparent 1px), linear-gradient(90deg, #2DC856 1px, transparent 1px); background-size: 64px 64px;"
      aria-hidden="true"
    ></div>
    <!-- 2. Primary green radial glow, positioned behind the H1's accent line -->
    <div
      class="profits-hero-glow-primary absolute pointer-events-none"
      aria-hidden="true"
    ></div>
    <!-- 3. Secondary accent glow, top-right (where the ribbon used to live —
            fills that corner so the visual weight stays balanced now that
            the ribbon's gone). -->
    <div
      class="profits-hero-glow-secondary absolute pointer-events-none"
      aria-hidden="true"
    ></div>
    <!-- 4. Bottom-right ambient accent -->
    <div
      class="absolute bottom-0 right-0 w-[560px] h-[400px] rounded-full opacity-[0.06] pointer-events-none translate-x-1/4 translate-y-1/4"
      style="background: radial-gradient(ellipse at center, #2DC856 0%, transparent 70%);"
      aria-hidden="true"
    ></div>
    <!-- 5. Top-edge subtle white wash (lit-from-above) -->
    <div
      class="absolute top-0 inset-x-0 h-48 opacity-[0.025] pointer-events-none"
      style="background: linear-gradient(180deg, rgba(255,255,255,1) 0%, transparent 100%);"
      aria-hidden="true"
    ></div>
    <!-- 6. Bottom fade that hands off to the next section -->
    <div
      class="absolute bottom-0 inset-x-0 h-40 pointer-events-none"
      style="background: linear-gradient(180deg, transparent 0%, #0d1b22 100%);"
      aria-hidden="true"
    ></div>

    <div class="relative w-full max-w-7xl mx-auto px-6 lg:px-8 py-24 lg:py-28">
      <!-- Asymmetric grid: left col grows to fill remaining
           space, right col is fixed 320 px. This lets the H1
           and subhead truly stretch right instead of being
           capped at col-span-8 of a 12-col grid (which left a
           300 px dead band between the pitch and the testimonial). -->
      <div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-10 lg:gap-14 items-center">

        <!-- LEFT — pitch -->
        <div>
          <h1 class="profits-hero-h1 text-[2.75rem] sm:text-5xl md:text-[3.75rem] lg:text-[4.4rem] xl:text-[5.25rem] font-black leading-[0.98] tracking-[-0.024em] mb-7 lg:mb-9">
            Your parking lot is<br />
            <span class="profits-hero-accent">already an asset.</span><br />
            Time it paid like one.
          </h1>

          <p class="profits-hero-sub text-lg md:text-xl lg:text-[1.32rem] text-white/65 leading-[1.55] max-w-[44rem] mb-10 lg:mb-12">
            Unlike a bike rack, an EV charger collects real dollars every time it's used. Evium builds the opportunity for you — installation, software, maintenance, every rebate handled — at zero capital cost.
          </p>

          <div class="profits-hero-ctas flex flex-col sm:flex-row gap-4">
            <a href="#calculator" class="profits-hero-cta-primary group">
              <span>Try the Live Calculator</span>
              <svg class="profits-hero-cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#revenue-projection" class="profits-hero-cta-secondary">
              See Revenue Projections
            </a>
          </div>
        </div>

        <!-- RIGHT — Vin Gureeno testimonial (fixed 320 px column,
             pinned to the right edge of the hero). -->
        <aside class="w-full" aria-label="Customer testimonial">
          <figure class="profits-hero-testimonial">
            <!-- accent rail along the left edge -->
            <span class="profits-hero-testimonial-rail" aria-hidden="true"></span>
            <!-- decorative oversized open-quote glyph -->
            <svg class="profits-hero-testimonial-mark" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
              <path d="M9.5 8.5C5.4 8.5 2 11.9 2 16v7.5h7.5V16H5.5c0-2.2 1.8-4 4-4V8.5zm15 0c-4.1 0-7.5 3.4-7.5 7.5v7.5H24.5V16h-4c0-2.2 1.8-4 4-4V8.5z"/>
            </svg>

            <!-- 5 stars -->
            <div class="profits-hero-testimonial-stars" aria-label="5 out of 5 stars">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>

            <blockquote class="profits-hero-testimonial-quote">
              The ROI on our Evium installation exceeded projections. I didn't expect it to perform this well this quickly.
            </blockquote>

            <figcaption class="profits-hero-testimonial-attr">
              <div class="profits-hero-testimonial-avatar" aria-hidden="true">VG</div>
              <div>
                <p class="profits-hero-testimonial-name">Vin Gureeno</p>
                <p class="profits-hero-testimonial-role">Commercial Property Owner, Northeast</p>
              </div>
            </figcaption>
          </figure>
        </aside>

      </div>
    </div>

    <!-- Scroll cue — sits centered at the bottom of the hero,
         pointing visitors to the calculator below. Animated soft
         bounce, muted color, drops out below 760 px so it never
         eats handset vertical space. -->
    <a href="#calculator" class="profits-hero-scroll" aria-label="Scroll to calculator">
      <span class="profits-hero-scroll-label">Scroll</span>
      <svg class="profits-hero-scroll-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </section>

  <!-- ═══════════════════════════════════════════════
       Hero styling — premium polish layer
  ═══════════════════════════════════════════════ -->
  <style>
    /* Primary green radial glow — anchored behind the H1's
       green word for a "lit from inside" reading. */
    .profits-hero-glow-primary {
      top: 18%;
      left: 6%;
      width: clamp(640px, 60vw, 1100px);
      height: clamp(440px, 42vw, 760px);
      border-radius: 9999px;
      opacity: 0.14;
      background: radial-gradient(
        ellipse at center,
        rgba(45, 200, 86, 0.55) 0%,
        rgba(45, 200, 86, 0.18) 35%,
        transparent 70%
      );
      filter: blur(10px);
      animation: profits-hero-glow-pulse 9s ease-in-out infinite;
    }
    @keyframes profits-hero-glow-pulse {
      0%, 100% { opacity: 0.14; transform: scale(1); }
      50%      { opacity: 0.18; transform: scale(1.04); }
    }

    /* Secondary green glow — top-right of the hero. Fills the
       corner space where the under-construction ribbon used to
       live, so the visual mass stays balanced now that the
       ribbon's removed. Breathes on an offset rhythm from the
       primary glow so they don't pulse in sync. */
    .profits-hero-glow-secondary {
      top: -6%;
      right: -4%;
      width: clamp(420px, 38vw, 700px);
      height: clamp(320px, 30vw, 520px);
      border-radius: 9999px;
      opacity: 0.10;
      background: radial-gradient(
        ellipse at center,
        rgba(45, 200, 86, 0.55) 0%,
        rgba(45, 200, 86, 0.15) 38%,
        transparent 72%
      );
      filter: blur(8px);
      animation: profits-hero-glow-pulse-alt 11s ease-in-out infinite -3.2s;
    }
    @keyframes profits-hero-glow-pulse-alt {
      0%, 100% { opacity: 0.10; transform: scale(1); }
      50%      { opacity: 0.14; transform: scale(1.05); }
    }

    /* H1 — generous tracking, micro text-shadow to lift
       from the dark bg. White lines get a subtle warmth
       so they don't read as flat off-white. */
    .profits-hero-h1 {
      color: #ffffff;
      text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
    }
    /* Accent line — brand green with soft glow underneath
       so the focal sentence reads as the page's center of
       gravity without needing decoration. */
    .profits-hero-accent {
      color: #2DC856;
      text-shadow:
        0 2px 30px rgba(45, 200, 86, 0.42),
        0 0 64px rgba(45, 200, 86, 0.18);
    }

    /* Subhead — sits one notch lighter than the H1; keep
       the line-length generous so the bike-rack sentence
       breaks naturally at "used." rather than mid-clause. */
    .profits-hero-sub {
      letter-spacing: -0.005em;
    }

    /* PRIMARY CTA — green pill, weighted with multi-layer
       shadows + inset highlight for a "tactile premium"
       feel. Hover lifts and brightens the green halo. */
    .profits-hero-cta-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 1rem 2rem;
      background: linear-gradient(180deg, #34d962 0%, #28b94e 100%);
      color: #0a1418;
      font-weight: 800;
      font-size: 0.98rem;
      letter-spacing: -0.005em;
      border-radius: 0.75rem;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.22),
        inset 0 -1px 0 rgba(0, 0, 0, 0.18),
        0 1px 2px rgba(0, 0, 0, 0.20),
        0 8px 18px -4px rgba(45, 200, 86, 0.42),
        0 18px 40px -10px rgba(45, 200, 86, 0.45);
      transition:
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 220ms ease,
        background 220ms ease;
      cursor: pointer;
      text-decoration: none;
    }
    .profits-hero-cta-primary:hover {
      transform: translateY(-1px);
      background: linear-gradient(180deg, #3ce069 0%, #2cc454 100%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -1px 0 rgba(0, 0, 0, 0.20),
        0 2px 3px rgba(0, 0, 0, 0.22),
        0 10px 22px -4px rgba(45, 200, 86, 0.55),
        0 22px 50px -10px rgba(45, 200, 86, 0.55);
    }
    .profits-hero-cta-primary:active {
      transform: translateY(0);
    }
    .profits-hero-cta-primary:focus-visible {
      outline: 2px solid #2DC856;
      outline-offset: 3px;
    }
    .profits-hero-cta-arrow {
      width: 1.2rem;
      height: 1.2rem;
      transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .profits-hero-cta-primary:hover .profits-hero-cta-arrow {
      transform: translateX(4px);
    }

    /* SECONDARY CTA — ghost button. Hairline border, hover
       brightens the border and shifts text toward brand
       green. Same height + radius as primary so the row
       reads as a balanced pair. */
    .profits-hero-cta-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 1rem 1.75rem;
      color: rgba(255, 255, 255, 0.88);
      font-weight: 700;
      font-size: 0.98rem;
      letter-spacing: -0.005em;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 0.75rem;
      background: rgba(255, 255, 255, 0.025);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transition:
        border-color 220ms ease,
        color 220ms ease,
        background 220ms ease,
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
      cursor: pointer;
      text-decoration: none;
    }
    .profits-hero-cta-secondary:hover {
      transform: translateY(-1px);
      border-color: rgba(45, 200, 86, 0.55);
      color: #2DC856;
      background: rgba(45, 200, 86, 0.06);
    }
    .profits-hero-cta-secondary:focus-visible {
      outline: 2px solid #2DC856;
      outline-offset: 3px;
    }

    /* EVIDENCE BAND — 3 cards as the closing visual stop.
       Visually demoted vs. the H1: smaller titles, muted
       borders, tinted gradient background so they read as
       proof footnotes rather than competing headings. */
    .profits-hero-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      padding: 1.5rem 1.5rem 1.65rem;
      background:
        linear-gradient(
          165deg,
          rgba(26, 48, 64, 0.65) 0%,
          rgba(13, 27, 34, 0.55) 100%
        );
      border: 1px solid rgba(255, 255, 255, 0.075);
      border-radius: 1rem;
      backdrop-filter: blur(10px) saturate(120%);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 6px 16px -6px rgba(0, 0, 0, 0.4);
      transition:
        transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 320ms ease,
        background 320ms ease,
        box-shadow 320ms ease;
    }
    .profits-hero-card:hover {
      transform: translateY(-3px);
      border-color: rgba(45, 200, 86, 0.32);
      background:
        linear-gradient(
          165deg,
          rgba(28, 52, 68, 0.82) 0%,
          rgba(15, 30, 38, 0.7) 100%
        );
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 12px 28px -8px rgba(0, 0, 0, 0.5),
        0 0 36px -8px rgba(45, 200, 86, 0.22);
    }
    .profits-hero-card-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 11px;
      background: linear-gradient(
        155deg,
        rgba(45, 200, 86, 0.22) 0%,
        rgba(45, 200, 86, 0.06) 100%
      );
      border: 1px solid rgba(45, 200, 86, 0.28);
      color: #2DC856;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.10),
        0 0 18px -2px rgba(45, 200, 86, 0.25);
      transition:
        background 320ms ease,
        border-color 320ms ease,
        box-shadow 320ms ease;
    }
    .profits-hero-card:hover .profits-hero-card-icon {
      background: linear-gradient(
        155deg,
        rgba(45, 200, 86, 0.34) 0%,
        rgba(45, 200, 86, 0.12) 100%
      );
      border-color: rgba(45, 200, 86, 0.48);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 0 26px -2px rgba(45, 200, 86, 0.4);
    }
    .profits-hero-card-title {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.012em;
      line-height: 1.25;
      color: #ffffff;
      margin: 0 0 0.55rem;
    }
    .profits-hero-card-body {
      font-size: 0.875rem;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.6);
      margin: 0;
    }
    /* Editorial ordinal (01 / 02 / 03) sitting in the top-right
       of each card. Muted by default; warms toward green on
       card hover to reinforce the sequenced reading. */
    .profits-hero-card-ordinal {
      position: absolute;
      top: 1.1rem;
      right: 1.25rem;
      font-family: 'Maven Pro', sans-serif;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      color: rgba(255, 255, 255, 0.22);
      transition: color 320ms ease;
    }
    .profits-hero-card:hover .profits-hero-card-ordinal {
      color: rgba(45, 200, 86, 0.55);
    }

    /* Scroll cue — bottom-centered, animated soft bounce, drops
       out under 760 px so it doesn't crowd handset layout.
       Subtle enough to feel like a wayfinding hint, not a
       carnival pointer. */
    .profits-hero-scroll {
      position: absolute;
      bottom: 1.8rem;
      left: 50%;
      transform: translateX(-50%);
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(255, 255, 255, 0.4);
      text-decoration: none;
      cursor: pointer;
      transition: color 240ms ease;
      z-index: 4;
    }
    .profits-hero-scroll:hover {
      color: rgba(45, 200, 86, 0.85);
    }
    .profits-hero-scroll-label {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }
    .profits-hero-scroll-arrow {
      width: 1rem;
      height: 1rem;
      animation: profits-hero-scroll-bounce 2.4s ease-in-out infinite;
    }
    @keyframes profits-hero-scroll-bounce {
      0%, 100% { transform: translateY(0); opacity: 0.7; }
      50%      { transform: translateY(4px); opacity: 1; }
    }
    @media (max-width: 760px) {
      .profits-hero-scroll { display: none; }
    }

    /* ─── Vin Gureeno testimonial — right-side hero anchor ───
       Premium pulled-quote card. Glass surface, brand-green
       accent rail on the left edge, oversized decorative quote
       glyph in the top-right corner, identity row with monogram
       avatar at the bottom. Sized to feel weighty alongside the
       H1 without overpowering it. */
    .profits-hero-testimonial {
      position: relative;
      padding: 1.75rem 1.65rem 1.5rem 1.85rem;
      background:
        linear-gradient(
          155deg,
          rgba(26, 48, 64, 0.78) 0%,
          rgba(13, 27, 34, 0.62) 55%,
          rgba(13, 27, 34, 0.55) 100%
        );
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.15rem;
      backdrop-filter: blur(14px) saturate(125%);
      -webkit-backdrop-filter: blur(14px) saturate(125%);
      overflow: hidden;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.06),
        0 14px 32px -8px rgba(0, 0, 0, 0.55),
        0 0 50px -12px rgba(45, 200, 86, 0.18);
      margin: 0;
    }
    /* Vertical brand-green rail on the left edge — gives the
       card a focal anchor and ties it to the green H1 accent. */
    .profits-hero-testimonial-rail {
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 0;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: linear-gradient(
        180deg,
        rgba(45, 200, 86, 0) 0%,
        rgba(45, 200, 86, 0.85) 25%,
        rgba(45, 200, 86, 0.85) 75%,
        rgba(45, 200, 86, 0) 100%
      );
      box-shadow: 0 0 14px rgba(45, 200, 86, 0.4);
    }
    /* Oversized open-quote glyph — sits in the top-right
       corner of the card, very low opacity so it reads as a
       decorative watermark, not a primary element. */
    .profits-hero-testimonial-mark {
      position: absolute;
      top: 1rem;
      right: 1.25rem;
      width: 3.25rem;
      height: 3.25rem;
      color: rgba(45, 200, 86, 0.18);
      pointer-events: none;
    }
    /* 5-star row */
    .profits-hero-testimonial-stars {
      display: inline-flex;
      gap: 0.25rem;
      margin-bottom: 1.25rem;
      color: #2DC856;
      filter: drop-shadow(0 0 8px rgba(45, 200, 86, 0.35));
    }
    .profits-hero-testimonial-stars svg {
      width: 1.1rem;
      height: 1.1rem;
    }
    /* The quote itself — serif-adjacent weight so it reads as
       a real human voice, generous line-height, large enough
       to anchor the right column without dominating the H1. */
    .profits-hero-testimonial-quote {
      font-size: 1.02rem;
      line-height: 1.45;
      letter-spacing: -0.012em;
      color: rgba(255, 255, 255, 0.92);
      font-weight: 500;
      margin: 0 0 1.35rem;
      quotes: '"' '"';
    }
    .profits-hero-testimonial-quote::before { content: open-quote; }
    .profits-hero-testimonial-quote::after  { content: close-quote; }
    /* Identity row — monogram avatar + name/role. */
    .profits-hero-testimonial-attr {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding-top: 1.1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .profits-hero-testimonial-avatar {
      flex-shrink: 0;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(
        145deg,
        rgba(45, 200, 86, 0.35) 0%,
        rgba(45, 200, 86, 0.12) 100%
      );
      border: 1px solid rgba(45, 200, 86, 0.45);
      color: #ffffff;
      font-weight: 800;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 0 16px -2px rgba(45, 200, 86, 0.3);
    }
    .profits-hero-testimonial-name {
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      color: #ffffff;
      margin: 0;
    }
    .profits-hero-testimonial-role {
      font-size: 0.74rem;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.5);
      margin: 0.1rem 0 0;
    }

    /* Mobile: testimonial card stacks below the pitch with
       generous top margin so it doesn't crowd the CTA row. */
    @media (max-width: 1023px) {
      .profits-hero-testimonial {
        margin-top: 2.5rem;
      }
    }

    /* Staggered fade-up entrance on first paint. The four
       elements (H1, sub, CTAs, testimonial) flow in with a
       130ms cascade — slow enough to feel deliberate, fast
       enough to not gate the read. */
    .profits-hero-h1,
    .profits-hero-sub,
    .profits-hero-ctas,
    .profits-hero-testimonial {
      animation: profits-hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .profits-hero-h1           { animation-delay: 0.05s; }
    .profits-hero-sub          { animation-delay: 0.18s; }
    .profits-hero-ctas         { animation-delay: 0.32s; }
    .profits-hero-testimonial  { animation-delay: 0.42s; }
    @keyframes profits-hero-rise {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Reduced-motion: drop the cascade, the glow pulses, and
       the scroll-cue bounce so motion-sensitive visitors get a
       static hero. */
    @media (prefers-reduced-motion: reduce) {
      .profits-hero-h1,
      .profits-hero-sub,
      .profits-hero-ctas,
      .profits-hero-testimonial,
      .profits-hero-glow-primary,
      .profits-hero-glow-secondary,
      .profits-hero-scroll-arrow {
        animation: none;
      }
    }

    /* ════════════════════════════════════════════════════════
       LIVE CONSOLE (Option F) — the calculator
       Two-column console: segmented-control pickers + a live,
       self-rewriting model-description card on the left; a
       sticky result panel on the right. Ported verbatim from
       /testing/calculator-layouts Option F (the .lc-card base
       it inherited there is baked into .lc-layout-f below).
       ════════════════════════════════════════════════════════ */

    /* sr-only — the visually-hidden model radios */
    .lc-sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* ── Input fields ── */
    .lc-input-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .lc-input-field { min-width: 0; }
    .lc-input-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }
    .lc-input-wrap { position: relative; }
    .lc-input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.8rem 3.4rem 0.8rem 0.9rem;
      background: #0c1a22;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.7rem;
      color: #ffffff;
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      transition: border-color 200ms ease, box-shadow 200ms ease;
      -webkit-appearance: none;
      appearance: none;
    }
    .lc-input-wrap--prefixed .lc-input { padding-left: 2rem; }
    .lc-input:focus {
      outline: none;
      border-color: #2DC856;
      box-shadow: 0 0 0 3px rgba(45,200,86,0.2);
    }
    .lc-input-prefix {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.4);
      font-size: 1.05rem;
      font-weight: 700;
      pointer-events: none;
    }
    .lc-input-suffix {
      position: absolute;
      right: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.3);
      font-size: 0.72rem;
      font-weight: 700;
      pointer-events: none;
    }
    .lc-input-hint {
      font-size: 0.68rem;
      line-height: 1.4;
      color: rgba(255,255,255,0.38);
      margin: 0.5rem 0 0;
    }

    /* ── Segmented control — shared by all three pickers ── */
    .lc-e-seg {
      position: relative;
      display: grid;
      gap: 4px;
      padding: 5px;
      border-radius: 999px;
      background: #ffffff;
      border: 1px solid rgba(13,27,34,0.08);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.9) inset,
        0 1px 2px rgba(13,27,34,0.04),
        0 14px 30px -18px rgba(13,27,34,0.22);
    }
    .lc-e-seg--4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
    .lc-e-seg--3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .lc-e-thumb {
      position: absolute;
      top: 5px;
      bottom: 5px;
      left: 5px;
      z-index: 0;
      border-radius: 999px;
      background: linear-gradient(180deg, #2DC856 0%, #25b349 100%);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.35) inset,
        0 6px 16px -6px rgba(45,200,86,0.55),
        0 2px 4px rgba(13,27,34,0.12);
      transition: transform 420ms cubic-bezier(0.22,1,0.36,1), opacity 240ms ease;
      will-change: transform;
      pointer-events: none;
    }
    /* Thumb width/position are written inline by the enhancement
       script (it measures the active segment); these widths are
       just the pre-script fallback. */
    .lc-e-seg--4 .lc-e-thumb { width: calc((100% - 22px) / 4); }
    .lc-e-seg--3 .lc-e-thumb { width: calc((100% - 18px) / 3); }
    .lc-e-seg-btn {
      position: relative;
      z-index: 1;
      appearance: none;
      -webkit-appearance: none;
      background: transparent;
      border: 0;
      cursor: pointer;
      font-family: inherit;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1px;
      padding: 0.52rem 0.4rem;
      border-radius: 999px;
      min-width: 0;
      color: rgba(13,27,34,0.62);
      transition: color 220ms ease;
    }
    .lc-e-seg-btn:hover:not(.is-active) { color: #1A2F3A; }
    .lc-e-seg-btn.is-active { color: #ffffff; }
    .lc-e-seg-btn:focus-visible { outline: 2px solid #2DC856; outline-offset: 3px; }
    .lc-e-seg-name {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: -0.005em;
      line-height: 1.1;
      white-space: nowrap;
      text-transform: capitalize;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lc-e-seg-sub {
      font-size: 0.6rem;
      font-weight: 600;
      line-height: 1.1;
      white-space: nowrap;
      color: rgba(13,27,34,0.46);
      transition: color 220ms ease;
    }
    .lc-e-seg-sub [data-util-rate] { font-weight: 800; }
    .lc-e-seg-btn.is-active .lc-e-seg-sub { color: rgba(255,255,255,0.82); }
    .lc-e-seg-model-item {
      position: relative;
      z-index: 1;
      cursor: pointer;
    }
    .lc-e-seg-model-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 0.52rem 0.4rem;
      border-radius: 999px;
      min-width: 0;
      color: rgba(13,27,34,0.62);
      transition: color 220ms ease;
    }
    .lc-e-seg-model-item:hover .lc-e-seg-model-card { color: #1A2F3A; }
    .lc-e-seg-model-item input:checked ~ .lc-e-seg-model-card { color: #ffffff; }
    .lc-e-seg-model-item input:focus-visible ~ .lc-e-seg-model-card {
      outline: 2px solid #2DC856;
      outline-offset: 3px;
    }
    .lc-e-seg-model-badge {
      font-size: 0.575rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.01em;
      color: rgba(13,27,34,0.46);
      transition: color 220ms ease;
    }
    .lc-e-seg-model-item input:checked ~ .lc-e-seg-model-card .lc-e-seg-model-badge {
      color: rgba(255,255,255,0.82);
    }

    /* ── Console shell — controls left, sticky result right.
         (.lc-card base from calculator-layouts baked in here.) ── */
    .lc-layout-f {
      position: relative;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1.75rem;
      background: linear-gradient(165deg, #16303e 0%, #0f2531 100%);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 40px 80px -40px rgba(0,0,0,0.6),
        0 8px 30px -14px rgba(0,0,0,0.5);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 384px;
      align-items: start;
    }
    .lc-f-controls {
      padding: clamp(1.75rem, 3vw, 2.85rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.5rem, 2.4vw, 2.1rem);
      min-width: 0;
    }
    .lc-f-result {
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin: clamp(1.5rem, 2.4vw, 2.25rem);
      overflow: hidden;
      padding: clamp(1.4rem, 2vw, 1.85rem);
      border-radius: 1.25rem;
      background: linear-gradient(170deg, #163443 0%, #0e2531 100%);
      border: 1px solid rgba(45,200,86,0.26);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 28px 56px -32px rgba(45,200,86,0.32),
        0 8px 22px -12px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .lc-f-zones {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: clamp(0.9rem, 1.8vw, 1.4rem);
    }
    .lc-f-zone,
    .lc-f-inputs,
    .lc-f-model {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      min-width: 0;
    }
    .lc-f-zone-head {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .lc-f-zone-label {
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
    }
    .lc-f-zone-note {
      font-size: 0.74rem;
      font-weight: 500;
      line-height: 1.4;
      color: rgba(255,255,255,0.42);
    }

    /* Dark re-theme for the shared segmented controls. */
    .lc-layout-f .lc-e-seg {
      background: rgba(255,255,255,0.045);
      border-color: rgba(255,255,255,0.1);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.04),
        0 2px 8px -4px rgba(0,0,0,0.55);
    }
    .lc-layout-f .lc-e-seg-btn { color: rgba(255,255,255,0.58); }
    .lc-layout-f .lc-e-seg-btn:hover:not(.is-active) { color: rgba(255,255,255,0.9); }
    .lc-layout-f .lc-e-seg-sub { color: rgba(255,255,255,0.4); }
    .lc-layout-f .lc-e-seg-model-card { color: rgba(255,255,255,0.58); }
    .lc-layout-f .lc-e-seg-model-item:hover .lc-e-seg-model-card { color: rgba(255,255,255,0.9); }
    .lc-layout-f .lc-e-seg-model-badge { color: rgba(255,255,255,0.4); }
    .lc-layout-f .lc-model-label {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: -0.005em;
      color: inherit;
      margin: 0;
    }

    /* Live model description card — rewrites itself per model. */
    .lc-f-model-card {
      margin-top: 0.15rem;
      padding: clamp(1rem, 1.6vw, 1.35rem);
      border-radius: 1rem;
      background: linear-gradient(165deg, rgba(45,200,86,0.08) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(45,200,86,0.2);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: opacity 160ms ease;
    }
    .lc-f-model-card.is-swapping { opacity: 0; }
    .lc-f-model-card-head {
      display: flex;
      align-items: center;
      gap: 0.6rem 0.7rem;
      flex-wrap: wrap;
    }
    .lc-f-model-card-title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.012em;
      color: #ffffff;
    }
    .lc-f-model-card-badge {
      font-size: 0.55rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.28rem 0.6rem;
      border-radius: 999px;
      background: rgba(45,200,86,0.14);
      color: #58e07f;
      border: 1px solid rgba(45,200,86,0.3);
      white-space: nowrap;
    }
    .lc-f-model-card-blurb {
      margin: 0;
      font-size: 0.84rem;
      line-height: 1.55;
      color: rgba(255,255,255,0.62);
    }
    .lc-f-model-spec {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 1px;
      margin: 0;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.7rem;
      overflow: hidden;
    }
    .lc-f-model-spec > div {
      background: #122a37;
      padding: 0.62rem 0.7rem 0.66rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
    }
    .lc-f-model-spec dt {
      font-size: 0.5rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.42);
      line-height: 1.2;
    }
    .lc-f-model-spec dd {
      margin: 0;
      font-size: 0.76rem;
      font-weight: 700;
      line-height: 1.3;
      color: #ffffff;
      letter-spacing: -0.005em;
    }

    /* Result panel internals. */
    .lc-f-out-glow {
      position: absolute;
      top: -32%;
      right: -22%;
      width: 72%;
      height: 82%;
      pointer-events: none;
      background: radial-gradient(ellipse, rgba(45,200,86,0.2) 0%, transparent 70%);
    }
    .lc-f-out-eyebrow {
      position: relative;
      margin: 0;
    }
    .lc-f-out-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      font-size: 0.54rem;
      font-weight: 800;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      padding: 0.32rem 0.7rem;
      border-radius: 999px;
      background: rgba(45,200,86,0.15);
      color: #58e07f;
      border: 1px solid rgba(45,200,86,0.32);
    }
    .lc-f-out-tag::before {
      content: "";
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: #2DC856;
      box-shadow: 0 0 8px #2DC856;
      animation: lc-f-pulse 2.4s ease-in-out infinite;
    }
    @keyframes lc-f-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    .lc-f-out-combo {
      position: relative;
      margin: 0;
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.4;
      color: rgba(255,255,255,0.6);
    }
    .lc-f-out-figure-block {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .lc-f-out-label {
      margin: 0;
      font-size: 0.56rem;
      font-weight: 800;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }
    .lc-f-out-figure {
      margin: 0;
      font-size: clamp(2.6rem, 4vw, 3.4rem);
      font-weight: 900;
      letter-spacing: -0.032em;
