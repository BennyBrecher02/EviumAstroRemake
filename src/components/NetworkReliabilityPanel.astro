---
/**
 * NetworkReliabilityPanel
 * ───────────────────────
 * Standalone "Network Reliability" status panel — a brand-styled
 * uptime widget showing a gradient gauge dial pointing at the
 * current 30-day rolling reliability percentage, a small status
 * legend (Online / Under Maintenance / Offline) with lit/unlit
 * dot states, and a key-value summary block (monitoring, last
 * outage, open exceptions).
 *
 * Originally lived in /services hero. Extracted so it can be
 * dropped anywhere — a section, a sidebar, a card. Self-contained:
 * all CSS scoped via Astro's component scoping, no external
 * dependencies, no scripts.
 *
 * Props let consumers customise the displayed numbers without
 * editing the component:
 *
 *   uptimePct       e.g. "99.2%"             gauge needle + headline number
 *   uptimeLabel     e.g. "Rolling 30-day uptime"
 *   stateLabel      e.g. "Nominal"           the "Current State" cell
 *   monitoring      e.g. "24/7 active"
 *   lastOutage      e.g. "17 days ago"
 *   openExceptions  e.g. "0"
 *   statusOnline    boolean — which legend dot is lit (only one)
 *   statusMaint     boolean
 *   statusOffline   boolean
 *
 * Defaults reproduce the original /services hero rendering exactly.
 */

interface Props {
  uptimePct?: string;
  uptimeLabel?: string;
  stateLabel?: string;
  monitoring?: string;
  lastOutage?: string;
  openExceptions?: string;
  statusOnline?: boolean;
  statusMaint?: boolean;
  statusOffline?: boolean;
}

const {
  uptimePct      = '99.2%',
  uptimeLabel    = 'Rolling 30-day uptime',
  stateLabel     = 'Nominal',
  monitoring     = '24/7 active',
  lastOutage     = '17 days ago',
  openExceptions = '0',
  statusOnline   = true,
  statusMaint    = false,
  statusOffline  = false,
} = Astro.props;
---

<div class="uptime-panel w-full max-w-[24rem] border border-white/12 px-7 py-6">
  <div class="flex items-center justify-between gap-4">
    <div class="text-[10px] font-medium uppercase tracking-[0.16em] text-white/44">
      Network Reliability
    </div>
    <div class="w-[8.9rem] text-center text-[10px] font-medium uppercase tracking-[0.16em] text-white/34">
      Status
    </div>
  </div>

  <div class="mt-7 grid grid-cols-[minmax(0,1fr)_8.9rem] gap-8 items-center">
    <div class="flex min-w-0 flex-col items-center">
      <div class="meter-track" aria-hidden="true">
        <svg viewBox="0 0 180 108" class="meter-svg" role="presentation">
          <defs>
            <linearGradient id="eviumReliabilityArc" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#7f2f35" />
              <stop offset="18%" stop-color="#b04937" />
              <stop offset="40%" stop-color="#d87d32" />
              <stop offset="58%" stop-color="#e2c233" />
              <stop offset="78%" stop-color="#7cb446" />
              <stop offset="100%" stop-color="#2DC856" />
            </linearGradient>
          </defs>
          <path
            d="M24 86 A66 66 0 0 1 156 86"
            fill="none"
            stroke="rgba(255,255,255,0.08)"
            stroke-width="18"
            stroke-linecap="round"
            opacity="0.35"
          />
          <path
            d="M24 86 A66 66 0 0 1 156 86"
            fill="none"
            stroke="url(#eviumReliabilityArc)"
            stroke-width="14"
            stroke-linecap="round"
          />
          <line x1="90" y1="86" x2="154" y2="64" stroke="#ecf6ef" stroke-width="3.5" stroke-linecap="round" />
          <circle cx="90" cy="86" r="6.5" fill="#ecf6ef" />
          <circle cx="90" cy="86" r="2.4" fill="#1A2F3A" />
        </svg>
      </div>
      <span class="uptime-value mt-1 block text-[2.7rem] leading-none text-white">{uptimePct}</span>
      <span class="mt-2 block text-center text-[11px] font-medium uppercase tracking-[0.14em] text-white/38">
        {uptimeLabel}
      </span>
    </div>

    <div class="border-l border-white/10 pl-6">
      <div class="space-y-3 text-left">
        <span class="inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.16em] text-white/66">
          <span class:list={['status-light', 'status-green', statusOnline ? 'is-on' : 'is-off']}></span>
          Online
        </span>
        <span class="inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.16em] text-white/42">
          <span class:list={['status-light', 'status-yellow', statusMaint ? 'is-on' : 'is-off']}></span>
          Under Maintenance
        </span>
        <span class="inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.16em] text-white/42">
          <span class:list={['status-light', 'status-red', statusOffline ? 'is-on' : 'is-off']}></span>
          Offline
        </span>
      </div>

      <div class="mt-5 border-t border-white/10 pt-4">
        <div class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/30">Current State</div>
        <div class="mt-1 text-sm font-semibold tracking-[0.01em] text-white/76">{stateLabel}</div>
      </div>
    </div>
  </div>

  <div class="mt-7 h-px w-full bg-white/10"></div>

  <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-left">
    <dt class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/30">Monitoring</dt>
    <dd class="text-sm font-semibold text-right text-white/72">{monitoring}</dd>

    <dt class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/30">Last outage</dt>
    <dd class="text-sm font-semibold text-right text-white/72">{lastOutage}</dd>

    <dt class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/30">Open exceptions</dt>
    <dd class="text-sm font-semibold text-right text-white/72">{openExceptions}</dd>
  </dl>
</div>

<style>
  .uptime-panel {
    background: rgba(255, 255, 255, 0.035);
  }

  .meter-track {
    width: 11rem;
    height: 5.5rem;
  }

  .meter-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .status-light {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    position: relative;
  }

  .status-green {
    background: #2DC856;
    color: #2DC856;
  }

  .status-yellow {
    background: #E0B84F;
    color: #E0B84F;
  }

  .status-red {
    background: #B64A4A;
    color: #B64A4A;
  }

  .status-light.is-on {
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,0.28),
      inset 0 -1px 2px rgba(0,0,0,0.24),
      0 0 0 1px rgba(255,255,255,0.06),
      0 0 12px color-mix(in srgb, currentColor 45%, transparent);
    filter: saturate(1.15) brightness(1.08);
  }

  .status-light.is-off {
    opacity: 0.95;
    background-image:
      radial-gradient(circle at 30% 28%, rgba(255,255,255,0.26), rgba(255,255,255,0.08) 26%, transparent 42%),
      radial-gradient(circle at 50% 58%, color-mix(in srgb, currentColor 52%, #0d1419 48%) 0%, color-mix(in srgb, currentColor 32%, #0d1419 68%) 55%, rgba(6,10,14,0.88) 100%);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,0.14),
      inset 0 -1px 2px rgba(0,0,0,0.38),
      0 0 0 1px rgba(255,255,255,0.05);
    filter: saturate(0.92) brightness(0.76);
  }

  .uptime-value {
    font-family: "Maven Pro", ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
