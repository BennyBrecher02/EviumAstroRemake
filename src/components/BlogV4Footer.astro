---
/**
 * BlogV4Footer — page-specific footer for /blog-v4 ONLY.
 * ──────────────────────────────────────────────────────
 * This is NOT the sitewide footer (`SiteFooter.astro`). It's a
 * per-page variant scoped to /blog-v4 because the blog-v4 surface
 * has a unique CLIFF + TUNNEL framing (two side tunnels under a
 * U-shaped road) that the rest of the site doesn't share.
 *
 * What changed vs the previous SiteFooterTunnel:
 *   · Tunnel "rings" (concrete panel seams) are FATTER + sparser
 *     so each ring reads as a deliberate band rather than a hair-
 *     thin line — same footer height, fewer/heavier rings.
 *   · No horizontal stripe bridge across the cliff face. The
 *     rings stop cleanly at each tunnel mouth; the cliff face
 *     between the two bores stays a flat dark wall framing the
 *     content.
 *
 * The original SiteFooterTunnel.astro still exists but is no
 * longer imported — kept for reference / archive.
 */

const solutionLinks = [
  { label: 'Multifamily',          href: '/solutions/multifamily' },
  { label: 'Fleet depot',          href: '/solutions/fleets' },
  { label: 'Highway / fast lane',  href: '/solutions/highway-fast-charging' },
  { label: 'Retail & hospitality', href: '/solutions/retail' },
  { label: 'Parking garages',      href: '/solutions/parking' },
  { label: 'Medical',              href: '/solutions/medical' },
];

const productLinks = [
  { label: 'Level 2 chargers',    href: '/products' },
  { label: 'DC fast chargers',    href: '/products' },
  { label: 'Evium app',           href: '/#home-app-download' },
  { label: 'Owner Portal',        href: 'https://portal.eviumcharging.com' },
  { label: 'See all products →',  href: '/products' },
];

const companyLinks = [
  { label: 'How it works',         href: '/how-it-works' },
  { label: 'Services',             href: '/services' },
  { label: 'Electrician partners', href: '/solutions/electrician-partners' },
  { label: 'Blog',                 href: '/blog' },
  { label: 'Contact',              href: '/contact' },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/eviumcharging/',        kind: 'instagram' as const },
  { label: 'Facebook',  href: 'https://www.facebook.com/eviumcharging/',         kind: 'facebook'  as const },
  { label: 'X',         href: 'https://x.com/eviumcharging',                     kind: 'x'         as const },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/company/evium-charging', kind: 'linkedin'  as const },
];

const legalLinks = [
  { label: 'Privacy policy',     href: '/legal/privacy' },
  { label: 'Terms of service',   href: '/legal/terms' },
  { label: 'Accessibility',      href: '/legal/accessibility' },
  { label: 'Cookie preferences', href: '/legal/cookies' },
];
---

<footer class="ftrt-cliff" aria-label="Site footer">
  <!-- LEFT side — perspective layout (top→bottom):
         · Asphalt road column visible at the top, picking up the
           page's road column above seamlessly.
         · Road FADES INTO the black void as it descends — this
           is the "in front of the tunnel" zone the road enters.
         · Tunnel ARCH curve marks the boundary between the void
           (visible road interior of the tunnel) and the cliff
           structure (back of the tunnel from the outside).
         · Below the arch is just cliff colour — matches the
           surrounding footer, so the back of the tunnel is
           indistinguishable from the footer (no separate void). -->
  <svg
    class="ftrt-side ftrt-side--left"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Concrete ceiling base — IDENTICAL to the headline
           tunnel's #bv4-ht-roof-base. Five-stop vertical
           gradient, darker at top/bottom, lighter through the
           middle so the ceiling reads as a 3-D arched concrete
           surface catching light at its apex. -->
      <linearGradient id="ftrt-depth-l" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#222a36" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <!-- Concrete-panel seams — period 14.286 viewBox units
           (= 100/7), so 7 rings down the full cliff height
           (vs the previous 8 → 10 → 12). Each ring "segment"
           (one period band) is now bigger so the ring rhythm
           reads cleaner. Dark band 0.9 viewBox + highlight
           0.28 viewBox kept absolute, so screen-pixel
           thickness of each ring stays the same — only the
           SPACING between rings grew. Phase y=0.5 shared with
           the cliff-face extensions and the body-side roof-
           ring strips so every ring on the page lines up
           row-for-row at every seam. -->
      <pattern id="ftrt-panels-l" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring: drop-shadow below + dark
             stripe + soft top highlight. Drawn in this order so
             the highlight sits on TOP of the dark stripe (where
             they overlap at y=0.5..0.78), and the drop shadow
             sits BEHIND in the gap below the ring (y=1.45..1.80,
             between this ring and the next period below). -->
        <rect x="-2" y="1.45" width="104" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="-2" y="0.5"  width="104" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="-2" y="0.5"  width="104" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <linearGradient id="ftrt-dash-mask-l"
                      gradientUnits="userSpaceOnUse"
                      x1="0" y1="0" x2="0" y2="100">
        <stop offset="0%"  stop-color="#fff" />
        <stop offset="21%" stop-color="#fff" />
        <stop offset="23%" stop-color="#000" />
        <stop offset="100%" stop-color="#000" />
      </linearGradient>
      <mask id="ftrt-dash-svg-mask-l" maskUnits="userSpaceOnUse">
        <rect x="0" y="0" width="100" height="100" fill="url(#ftrt-dash-mask-l)" />
      </mask>
    </defs>

    <!-- (1) Asphalt road floor — matches .bv4-u-asphalt so the
         road column reads as one continuous slab. STAYS asphalt
         above the arch — no ring lines through the road. -->
    <rect x="0" y="0" width="100" height="100" fill="#16213e" />

    <!-- (2) Tunnel concrete crown — clipped to BELOW the arch
         curve only. Above the arch the asphalt road shows
         through; below the arch we see this warm-grey gradient. -->
    <path d="M 0 1.5 A 50 21 0 1 0 100 1.5 L 100 100 L 0 100 Z" fill="url(#ftrt-depth-l)" />

    <!-- (3) Horizontal panel rings — clipped to BELOW the arch
         only (no rings on the road). Period 10 starting at
         y=0.5 — same phase as the cliff-face extensions next
         door so every ring on the page lines up row-for-row at
         every seam. -->
    <path d="M 0 1.5 A 50 21 0 1 0 100 1.5 L 100 100 L 0 100 Z" fill="url(#ftrt-panels-l)" />

    <!-- Cream arch lip is drawn by the unified road-outline path
         in /blog-v4's centerline overlay — see that file's
         #road-outline-path subpaths for the footer arch geometry. -->

    <!-- Yellow centerline dashes — DRAWN LAST so they sit on top.
         Mask lets them flow from the seam at y=0 through the
         arch dip and into the tunnel before fading. -->
    <line
      class="ftrt-dash ftrt-dash--left"
      x1="50" y1="100" x2="50" y2="0"
      stroke="rgba(220, 175, 20, 0.85)"
      stroke-width="3"
      stroke-dasharray="22 28"
      stroke-linecap="butt"
      vector-effect="non-scaling-stroke"
      mask="url(#ftrt-dash-svg-mask-l)"
    />
  </svg>

  <svg
    class="ftrt-side ftrt-side--right"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="ftrt-depth-r" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#222a36" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <pattern id="ftrt-panels-r" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring: drop-shadow below + dark
             stripe + soft top highlight. Drawn in this order so
             the highlight sits on TOP of the dark stripe (where
             they overlap at y=0.5..0.78), and the drop shadow
             sits BEHIND in the gap below the ring (y=1.45..1.80,
             between this ring and the next period below). -->
        <rect x="-2" y="1.45" width="104" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="-2" y="0.5"  width="104" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="-2" y="0.5"  width="104" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <linearGradient id="ftrt-dash-mask-r"
                      gradientUnits="userSpaceOnUse"
                      x1="0" y1="0" x2="0" y2="100">
        <stop offset="0%"  stop-color="#fff" />
        <stop offset="21%" stop-color="#fff" />
        <stop offset="23%" stop-color="#000" />
        <stop offset="100%" stop-color="#000" />
      </linearGradient>
      <mask id="ftrt-dash-svg-mask-r" maskUnits="userSpaceOnUse">
        <rect x="0" y="0" width="100" height="100" fill="url(#ftrt-dash-mask-r)" />
      </mask>
    </defs>
    <rect x="0" y="0" width="100" height="100" fill="#16213e" />
    <path d="M 0 1.5 A 50 21 0 1 0 100 1.5 L 100 100 L 0 100 Z" fill="url(#ftrt-depth-r)" />
    <!-- Horizontal panel rings — clipped BELOW the arch only,
         period 10 starting at y=0.5 (same phase as the cliff
         extensions so every ring lines up at the seam). -->
    <path d="M 0 1.5 A 50 21 0 1 0 100 1.5 L 100 100 L 0 100 Z" fill="url(#ftrt-panels-r)" />
    <line
      class="ftrt-dash ftrt-dash--right"
      x1="50" y1="0" x2="50" y2="100"
      stroke="rgba(220, 175, 20, 0.85)"
      stroke-width="3"
      stroke-dasharray="22 28"
      stroke-linecap="butt"
      vector-effect="non-scaling-stroke"
      mask="url(#ftrt-dash-svg-mask-r)"
    />
  </svg>

  <!-- ─── Ring extensions ──────────────────────────────────────
       Short stripe-only panels that sit RIGHT AT each tunnel's
       inner edge and extend the ring rhythm a short distance out
       past the arch toward the middle, then fade. They use the
       same concrete-gradient base + panel pattern + viewBox y=100
       as the tunnels, so dark-band rows land on the same screen y
       — making each ring read as continuing horizontally out of
       the bore for a moment before dissolving into the dark cliff.

       Width is intentionally short (≤110px) so the rings don't
       reach anywhere near the centre — this is a localised
       "stone weathering past the bore mouth" feel, NOT a band
       across the footer. Mask gradient fades them out away from
       the bore so the cliff face stays uniform near the middle. -->
  <svg
    class="ftrt-ext ftrt-ext--left"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Top stop changed to #06101a so the inner extension
           starts at the SAME color the billboard ends at — no
           color step at the body→footer seam in the cavity area
           (the inner extension sits directly below the billboard
           at the seam). Lower stops keep the cliff-face crown
           gradient's lighter middle so the surface still reads
           as a curved concrete tunnel ceiling. -->
      <linearGradient id="ftrt-ext-grad-l" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#06101a" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <!-- Period 14.286 viewBox units = 100/7 = one period per
           ⅐ of the cliff face (7 rings down the extension),
           matching the bore pattern + the body-side roof-ring
           strips. Phase y=0.5 lands the topmost ring right at
           the seam — no deadspace above the first ring. -->
      <pattern id="ftrt-ext-pat-l" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring — see bore-pattern comment
             above for the rationale. -->
        <rect x="0" y="1.45" width="100" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="0" y="0.5"  width="100" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="0" y="0.5"  width="100" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <!-- Concrete-pipe curve drop — simulates the cliff-face
           tunnel surface curving DOWN at the inner edge (away
           from the bore) when viewed from a bird's-eye angle.
           Brightest at the bore-side (the "top" of the curve,
           closest to viewer), darkening toward the inner edge
           (where the surface rolls down out of view). The
           gradient lands at the cliff bg color (#06101a) by
           the inner edge so when the horizontal CSS mask fades
           the extension's content to transparent, the cliff bg
           shows through at the SAME color the extension was
           ending at — no hard color seam at the fade endpoint.
           Stops use a quarter-circle-ish ease-in profile so the
           drop-off accelerates toward the inner edge, mimicking
           the visual rate at which a cylindrical surface goes
           out of view as it curves around. -->
      <linearGradient id="ftrt-ext-curve-l" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="#06101a" stop-opacity="0"    />
        <stop offset="40%"  stop-color="#06101a" stop-opacity="0.08" />
        <stop offset="65%"  stop-color="#06101a" stop-opacity="0.28" />
        <stop offset="85%"  stop-color="#06101a" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#06101a" stop-opacity="0.85" />
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill="url(#ftrt-ext-grad-l)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-pat-l)" />
    <!-- Side curve drop OVER concrete + rings (drawn last so it
         tints both). Combined with the curved horizontal mask
         in CSS, the extension's content darkens INTO the cliff
         bg color before fading to transparent — the inner edge
         reads as a continuous concrete surface rolling out of
         view rather than a vertical seam where rings end. -->
    <rect width="100" height="100" fill="url(#ftrt-ext-curve-l)" />
  </svg>
  <svg
    class="ftrt-ext ftrt-ext--right"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Top stop #06101a — see comment on ftrt-ext-grad-l. -->
      <linearGradient id="ftrt-ext-grad-r" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#06101a" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <!-- Phase y=0.5 + period 14.286 mirrors the left extension
           — see comment on the left for the rationale. -->
      <pattern id="ftrt-ext-pat-r" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring — see bore-pattern comment
             above for the rationale. -->
        <rect x="0" y="1.45" width="100" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="0" y="0.5"  width="100" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="0" y="0.5"  width="100" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <!-- Side curve drop — mirror of left extension's curve.
           Bore-side (right edge here) is bright; inner edge
           (left edge, toward the cavity centre) darkens to
           cliff bg. See full comment on the left side. -->
      <linearGradient id="ftrt-ext-curve-r" x1="1" y1="0" x2="0" y2="0">
        <stop offset="0%"   stop-color="#06101a" stop-opacity="0"    />
        <stop offset="40%"  stop-color="#06101a" stop-opacity="0.08" />
        <stop offset="65%"  stop-color="#06101a" stop-opacity="0.28" />
        <stop offset="85%"  stop-color="#06101a" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#06101a" stop-opacity="0.85" />
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill="url(#ftrt-ext-grad-r)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-pat-r)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-curve-r)" />
  </svg>

  <!-- ─── Outer ring extensions ────────────────────────────────
       Mirror of the inner extensions, sitting in the small
       --road-margin gap on the OUTER side of each tunnel
       (between the page wall and the tunnel's outer cream lip).
       Bore-side is on the INSIDE of each (toward the road
       column); inner-edge is on the OUTSIDE (toward the page
       wall). Curve drop + horizontal mask are flipped so the
       fade rolls OUT toward the wall, giving each tunnel a
       symmetric ring stack on both sides like a real concrete
       tunnel ceiling. -->
  <svg
    class="ftrt-ext ftrt-ext--outer-left"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Top stop #0d1825 so the outer extension starts at the
           SAME color the body's outer gap (bv4-u-road bg) ends
           at — no color step at the body→footer seam in the
           outer-margin area. Lower stops keep the cliff-face
           crown gradient's lighter middle for the curved tunnel
           ceiling effect. -->
      <linearGradient id="ftrt-ext-grad-ol" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#0d1825" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <pattern id="ftrt-ext-pat-ol" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring — see bore-pattern comment
             above for the rationale. -->
        <rect x="0" y="1.45" width="100" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="0" y="0.5"  width="100" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="0" y="0.5"  width="100" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <!-- Curve drop FLIPPED — bore-side (right edge of this
           strip) bright, inner edge (left edge = page wall)
           dark, so the surface curves DOWN toward the wall. -->
      <linearGradient id="ftrt-ext-curve-ol" x1="1" y1="0" x2="0" y2="0">
        <stop offset="0%"   stop-color="#06101a" stop-opacity="0"    />
        <stop offset="40%"  stop-color="#06101a" stop-opacity="0.08" />
        <stop offset="65%"  stop-color="#06101a" stop-opacity="0.28" />
        <stop offset="85%"  stop-color="#06101a" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#06101a" stop-opacity="0.85" />
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill="url(#ftrt-ext-grad-ol)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-pat-ol)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-curve-ol)" />
  </svg>
  <svg
    class="ftrt-ext ftrt-ext--outer-right"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <!-- Top stop #0d1825 — see comment on ftrt-ext-grad-ol. -->
      <linearGradient id="ftrt-ext-grad-or" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#0d1825" />
        <stop offset="22%"  stop-color="#37414f" />
        <stop offset="50%"  stop-color="#4b5666" />
        <stop offset="78%"  stop-color="#37414f" />
        <stop offset="100%" stop-color="#222a36" />
      </linearGradient>
      <pattern id="ftrt-ext-pat-or" patternUnits="userSpaceOnUse" width="100" height="14.286">
        <!-- 3-layer "expensive" ring — see bore-pattern comment
             above for the rationale. -->
        <rect x="0" y="1.45" width="100" height="0.35" fill="rgba(0, 0, 0, 0.16)" />
        <rect x="0" y="0.5"  width="100" height="0.9"  fill="rgba(0, 0, 0, 0.52)" />
        <rect x="0" y="0.5"  width="100" height="0.28" fill="rgba(255, 255, 255, 0.13)" />
      </pattern>
      <!-- Curve drop — bore-side (left edge of this strip)
           bright, inner edge (right edge = page wall) dark. -->
      <linearGradient id="ftrt-ext-curve-or" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="#06101a" stop-opacity="0"    />
        <stop offset="40%"  stop-color="#06101a" stop-opacity="0.08" />
        <stop offset="65%"  stop-color="#06101a" stop-opacity="0.28" />
        <stop offset="85%"  stop-color="#06101a" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#06101a" stop-opacity="0.85" />
      </linearGradient>
    </defs>
    <rect width="100" height="100" fill="url(#ftrt-ext-grad-or)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-pat-or)" />
    <rect width="100" height="100" fill="url(#ftrt-ext-curve-or)" />
  </svg>

  <!-- Cliff-face content — brand col + 3 nav cols + legal bar. -->
  <div class="ftrt-content">
    <div class="ftrt-ambient" aria-hidden="true"></div>

    <!-- ─── Top grid: brand column + 3 nav columns ─────────── -->
    <div class="ftrt-top">
      <div class="ftrt-brand">
        <a href="/" class="ftrt-logo-link" aria-label="Evium Charging home">
          <img src="/images/logos/evium/logo.webp" alt="Evium Charging" class="ftrt-logo" />
        </a>
        <p class="ftrt-tagline">
          <span class="ftrt-tagline-main">Electrifying the future.</span>
          <span class="ftrt-tagline-soft">One property at a time.</span>
        </p>

        <div class="ftrt-contact">
          <p class="ftrt-contact-line">
            <span class="ftrt-contact-label">Station support</span>
            <a href="tel:+19499452000" class="ftrt-contact-link">(949) 945-2000</a>
          </p>
          <p class="ftrt-contact-line">
            <span class="ftrt-contact-label">Partner inquiries</span>
            <a href="mailto:contact@eviumcharging.com" class="ftrt-contact-link">contact@eviumcharging.com</a>
          </p>
        </div>

        <div class="ftrt-socials" aria-label="Evium on social">
          {socials.map((s) => (
            <a
              href={s.href} class="ftrt-social"
              target="_blank" rel="noopener noreferrer"
              aria-label={`Evium on ${s.label}`}
            >
              {s.kind === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                </svg>
              )}
              {s.kind === 'facebook' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 8h2.5V5H14c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V8.8C13.5 8.4 13.7 8 14 8z"/>
                </svg>
              )}
              {s.kind === 'x' && (
