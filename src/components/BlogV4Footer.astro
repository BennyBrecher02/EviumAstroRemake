<script>
  /* Dash phase alignment — both sides.
     ──────────────────────────────────
     Drives the page centerline + both footer dash strokes from a
     SINGLE Web-Animations timeline anchored at startTime=0 so all
     three share an identical currentTime every frame — no
     CSS-keyframe scheduling drift between page and footer that
     could manifest as a perceived "size shift" at the seam. */
  (() => {
    const path      = document.getElementById('bv4-u-flow-path') as SVGPathElement | null;
    const leftDash  = document.querySelector<SVGElement>('.ftrt-side--left  .ftrt-dash');
    const rightDash = document.querySelector<SVGElement>('.ftrt-side--right .ftrt-dash');
    const leftSvg   = document.querySelector<SVGElement>('.ftrt-side--left');
    if (!path || !leftDash || !rightDash || !leftSvg) return;

    const PERIOD_MS = 2000;
    const SHIFT_PX  = 50;

    let pageAnim: Animation | null   = null;
    let leftAnim: Animation | null   = null;
    let rightAnim: Animation | null  = null;

    function build() {
      if (!path || !leftDash || !rightDash || !leftSvg) return;
      const L = path.getTotalLength();
      if (!isFinite(L) || L <= 0) return;
      const H = leftSvg.getBoundingClientRect().height;
      if (!isFinite(H) || H <= 0) return;

      pageAnim?.cancel();
      leftAnim?.cancel();
      rightAnim?.cancel();

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        path.style.strokeDashoffset = '0px';
        leftDash.style.strokeDashoffset = `${H % SHIFT_PX}px`;
        rightDash.style.strokeDashoffset = `${-(L % SHIFT_PX)}px`;
        return;
      }

      const leftBase  = H % SHIFT_PX;
      const rightBase = -(L % SHIFT_PX);
      const opts: KeyframeAnimationOptions = {
        duration: PERIOD_MS,
        iterations: Infinity,
        easing: 'linear',
      };

      pageAnim = path.animate(
        [{ strokeDashoffset: '0px' }, { strokeDashoffset: `${-SHIFT_PX}px` }],
        opts
      );
      leftAnim = leftDash.animate(
        [{ strokeDashoffset: `${leftBase}px` }, { strokeDashoffset: `${leftBase - SHIFT_PX}px` }],
        opts
      );
      rightAnim = rightDash.animate(
        [{ strokeDashoffset: `${rightBase}px` }, { strokeDashoffset: `${rightBase - SHIFT_PX}px` }],
        opts
      );

      const anchor = document.timeline.currentTime as number;
      if (pageAnim)  pageAnim.startTime  = anchor;
      if (leftAnim)  leftAnim.startTime  = anchor;
      if (rightAnim) rightAnim.startTime = anchor;
    }

    /* Disable the page CSS-keyframe centerline animation so our
       Web Animation is the single source of truth for dashoffset. */
    const killCss = document.createElement('style');
    killCss.textContent = '.bv4-u-flow path { animation: none !important; }';
    document.head.appendChild(killCss);

    requestAnimationFrame(() => requestAnimationFrame(build));

    let resizeRAF = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRAF);
      resizeRAF = requestAnimationFrame(build);
    });
  })();

  /* Back-to-top — smooth-scrolls to y=0, respects reduced motion. */
  (() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-ftrt-totop]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  })();

  /* Roof-ring period sync.
     ──────────────────────
     The cliff-face SVG patterns repeat every 14.286 viewBox y
     units (100/7) across a viewBox stretched to the cliff's
     actual rendered height — so each ring period in screen
     pixels is `cliffHeight / 7` (7 rings down the cliff face).
     The body-side `.bv4-roof-ring-extra` strips above the seam
     are CSS-px sized, so we publish that exact same
     `cliffHeight / 7` value as the `--roof-ring-period` custom
     property on :root. The body strips read the variable for
     their own height + ring offset/thickness, so every roof
     ring on the page (bore + cliff extension + body strip)
     ends up at the SAME screen-pixel period regardless of where
     it's rendered — no visible "this section vs that section"
     seam in the ring rhythm. ResizeObserver keeps it in sync on
     viewport changes. */
  (() => {
    const cliff = document.querySelector<HTMLElement>('.ftrt-cliff');
    if (!cliff) return;
    function update() {
      if (!cliff) return;
      const h = cliff.offsetHeight;
      if (!Number.isFinite(h) || h <= 0) return;
      document.documentElement.style.setProperty('--roof-ring-period', `${h / 7}px`);
    }
    update();
    let raf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    });
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(cliff);
  })();
</script>
