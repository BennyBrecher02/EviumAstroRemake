<style>
  .ftrt-cliff {
    --road-w: clamp(160px, 14vw, 210px);
    /* Small breathing room between the cliff face's outer edge
       (the page wall + HeaderV4 lefter rail) and the tunnel's
       outer cream lip — gives the OUTER side of each tunnel
       roof room for ring extensions, so the rings flare out on
       both sides like a natural concrete tunnel ceiling. Match
       this value with .bv4-root's --road-margin in the body. */
    --road-margin: clamp(15px, 1.5vw, 25px);
    --ev-green: #2DC856;

    position: relative;
    color: #fff;
    font-family: 'Maven Pro', sans-serif;
    background:
      linear-gradient(180deg,
        #06101a  0%,
        #050d16 100%
      );
    overflow: hidden;
    isolation: isolate;
  }

  /* Side road columns — full footer height, matching road-w. */
  .ftrt-side {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--road-w);
    height: 100%;
    /* z-index 60 lifts the road column ABOVE the HeaderV4
       lefter rail (z:50). The arch lip's outer leg cream stroke
       sits at viewport x=78.5-81.5 — half overlapping the lefter
       — so without this it would be clipped by the lefter's
       solid bg in dev-mode-off. */
    z-index: 60;
    pointer-events: none;
    display: block;
    /* CRITICAL: SVG defaults to overflow:hidden which clips
       the cream arch lip's outer leg stroke. */
    overflow: visible;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
  }
  .ftrt-side--left  { left:  var(--road-margin); }
  .ftrt-side--right { right: var(--road-margin); }

  /* ─── Ring extensions ────────────────────────────────────────
     Short panel of horizontal stripes that picks up at the inner
     edge of each tunnel and extends rings a small distance toward
     the middle before fading out. Width is capped well short of
     the page centre. Same viewBox y proportion + same pattern
     y-spec as the tunnels → dark-band rows land row-for-row.

     z-index 1 keeps it above the cliff bg but below the side
     tunnel SVG (60) so the tunnel's own arch + cream lip stay
     in front. Pointer-events disabled so it doesn't intercept
     clicks on overlapping content. */
  .ftrt-ext {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100%;
    /* Width matches the footer content's horizontal padding
       offset (`clamp(20px, 2.5vw, 40px)` on each side of the
       road column), so the extension fits EXACTLY in the gap
       between the road column's inner edge and the content
       text's outer edge. With the linear horizontal fade
       below, rings are fully transparent right at the
       content's left edge — they extend slightly past the
       bore but never appear behind the column text. */
    width: clamp(20px, 2.5vw, 40px);
    z-index: 1;
    pointer-events: none;
    display: block;
    overflow: visible;
  }
  .ftrt-ext--left {
    left: calc(var(--road-margin) + var(--road-w));
    /* Vertical: fully opaque from the seam down to 92%, then
         dissolves into the bottom-of-footer fade that the
         tunnels use too — so rings start RIGHT at the seam
         (no top deadspace) and stack the full footer height.
       Horizontal: CURVED multi-stop fade approximating a
         quarter-circle profile (cos curve) — opacity falls off
         slowly at first, then accelerates toward the inner
         edge. Combined with the in-SVG `ftrt-ext-curve-l`
         gradient that darkens the content INTO cliff bg color
         along the same axis, the inner edge reads as a
         concrete surface rolling around the curve out of view
         instead of a hard linear-fade vertical seam. */
    -webkit-mask-image:
      linear-gradient(180deg, #000 0%, #000 92%, transparent 100%),
      linear-gradient(to right,
        rgba(0, 0, 0, 1)    0%,
        rgba(0, 0, 0, 0.97) 25%,
        rgba(0, 0, 0, 0.85) 50%,
        rgba(0, 0, 0, 0.55) 70%,
        rgba(0, 0, 0, 0.20) 87%,
        rgba(0, 0, 0, 0)    100%);
            mask-image:
      linear-gradient(180deg, #000 0%, #000 92%, transparent 100%),
      linear-gradient(to right,
        rgba(0, 0, 0, 1)    0%,
        rgba(0, 0, 0, 0.97) 25%,
        rgba(0, 0, 0, 0.85) 50%,
        rgba(0, 0, 0, 0.55) 70%,
        rgba(0, 0, 0, 0.20) 87%,
        rgba(0, 0, 0, 0)    100%);
    -webkit-mask-composite: source-in;
            mask-composite: intersect;
  }
  .ftrt-ext--right {
    right: calc(var(--road-margin) + var(--road-w));
    -webkit-mask-image:
      linear-gradient(180deg, #000 0%, #000 92%, transparent 100%),
      linear-gradient(to left,
        rgba(0, 0, 0, 1)    0%,
        rgba(0, 0, 0, 0.97) 25%,
        rgba(0, 0, 0, 0.85) 50%,
        rgba(0, 0, 0, 0.55) 70%,
        rgba(0, 0, 0, 0.20) 87%,
        rgba(0, 0, 0, 0)    100%);
            mask-image:
      linear-gradient(180deg, #000 0%, #000 92%, transparent 100%),
      linear-gradient(to left,
        rgba(0, 0, 0, 1)    0%,
        rgba(0, 0, 0, 0.97) 25%,
        rgba(0, 0, 0, 0.85) 50%,
        rgba(0, 0, 0, 0.55) 70%,
        rgba(0, 0, 0, 0.20) 87%,
        rgba(0, 0, 0, 0)    100%);
    -webkit-mask-composite: source-in;
            mask-composite: intersect;
  }
  /* OUTER ring extensions — flipped masks so the bore-side
     (toward the road column) is solid and the inner-edge
     (toward the page wall) fades out. Width = --road-margin
     since they fill the small outer gap exactly. */
  .ftrt-ext--outer-left {
    width: var(--road-margin);
